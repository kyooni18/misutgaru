/* @misutgaru-vune-native */
import MkMiniChart from '@/components/vune/MkMiniChart.vune';
import { makeMiniChartData, type MiniChartData } from '@/vune/mini-chart.js';

export struct ComputedMiniChart: View {
	let data: MiniChartData
	let gradientId: string
	let color: string
	let className: string | undefined

	init(_ values: number[], gradientId: string, color: string = 'var(--MI_THEME-accent)', className: string | undefined = undefined) {
		self.data = makeMiniChartData(values)
		self.gradientId = gradientId
		self.color = color
		self.className = className
	}

	var body: some View {
		MkMiniChart(
			viewBoxX: data.viewBoxX,
			viewBoxY: data.viewBoxY,
			gradientId: gradientId,
			color: color,
			polygonPoints: data.polygonPoints,
			polylinePoints: data.polylinePoints,
			headX: data.headX,
			headY: data.headY,
			className: className,
		)
	}
}

export default ComputedMiniChart
