import { Rectangle, ZStack, type ViewGraphValue } from 'vune-ui';
import { Material } from '@/vune/material.js';
import '@/vune/material.scss';

export struct MaterialSurface: View {
	let material: Material
	// Used only as a static fallback when backdrop-filter cannot be rendered.
	let opaqueBackground: string
	let animated: boolean
	let content: ViewGraphValue

	init(_ material: Material = Material.regular, opaqueBackground: string = 'var(--vune-material-surface)', animated: boolean = true, @ViewBuilder content: () => ViewGraphValue) {
		self.material = material
		self.opaqueBackground = opaqueBackground
		self.animated = animated
		self.content = content()
	}

	var body: some View {
		ZStack(alignment: 'center') {
			Rectangle()
				.className('vune-material__opaque')
				.style({
					background: opaqueBackground,
					opacity: 1,
					'--vune-material-opaque-background': opaqueBackground,
				})
			content
		}
			.className(['vune-material', 'vune-material--native', `vune-material--${material.name}`, animated ? 'vune-material--animated' : ''])
			.style({
				'--vune-material-fallback-background': opaqueBackground,
				'--vune-material-opaque-background': opaqueBackground,
			})
			.withProps({ 'data-vune-material': material.name })
	}
}

export default MaterialSurface
