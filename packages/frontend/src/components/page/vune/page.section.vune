/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import XBlock from './page.block.vune';
import '@/vune/phase5-migration.scss';

type Props = { block: Extract<Misskey.entities.PageBlock, { type: 'section' }>; h: number; page: Misskey.entities.Page };
function headingClass(level: number): string {
	return level === 2 ? 'mk-vune-page-section__h2' : level === 3 ? 'mk-vune-page-section__h3' : level === 4 ? 'mk-vune-page-section__h4' : '';
}

export struct VunePageSectionView: View {
	let props: Props
	let level: number
	let titleClass: string

	init(_ props: Props) {
		self.props = props
		self.level = Math.max(1, Math.min(6, props.h))
		self.titleClass = headingClass(self.level)
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			Text(props.block.title).className(titleClass).accessibilityHeading(`h${level}`)
			Group() {
				ForEach(props.block.children, key: (child: Misskey.entities.PageBlock) => child.id) { child in
					XBlock({ page: props.page, block: child, h: props.h + 1 })
				}
			}.className('_gaps')
		}.accessibilityElement('contain')
	}
}

export default VunePageSectionView
