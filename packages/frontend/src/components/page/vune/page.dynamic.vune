import MkA from '@/components/global/vune/MkA.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';
type Props = { block: Misskey.entities.PageBlock; page: Misskey.entities.Page };
export struct VunePageDynamicView: View {
 let props: Props
 init(_ props: Props) { self.props = props }
 var body: some View {
  VStack(alignment: 'stretch', spacing: 0) {
   VStack(alignment: 'stretch', spacing: 0) { VuneIcon('ti ti-dice-5'); Text(` ${i18n.ts._pages.blocks.dynamic}`) }.className('mk-vune-page-dynamic__heading')
   Group() { Text(i18n.ts._pages.blocks.dynamicDescription); Text(' '); MkA('/play', className: '_link') { Text('Play') } }.className('mk-vune-page-dynamic__text')
  }.className('mk-vune-page-dynamic')
 }
}
export default VunePageDynamicView
