/* @misutgaru-vune-native */
import { ForEach, Group } from 'vune-ui';
import * as mfm from 'mfm-js';
import type * as Misskey from 'misskey-js';
import MkMfm from '@/components/global/vune/MkMfm.vune';
import MkUrlPreview from '@/components/vune/MkUrlPreview.vune';
import { extractUrlFromMfm } from '@/utility/extract-url-from-mfm.js';
import { isEnabledUrlPreview } from '@/utility/url-preview.js';

type Props = { block: Extract<Misskey.entities.PageBlock, { type: 'text' }>; page: Misskey.entities.Page };
export struct VunePageTextView: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		Group() {
			MkMfm({ text: props.block.text ?? '', isNote: false, author: props.page.user })
			if (isEnabledUrlPreview) {
				ForEach(extractUrlFromMfm(mfm.parse(props.block.text ?? '')), key: url => url) { url in MkUrlPreview(url) }
			}
		}.className(['_gaps', 'mk-vune-page-text'])
	}
}
export default VunePageTextView
