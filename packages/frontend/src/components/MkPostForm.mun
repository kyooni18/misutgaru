// Mün view for the post form. Layout uses Mün views: stacks for the flex rows,
// Box for block/inline text flow, Grid for the toolbar (its tracks come from the
// stylesheet's container queries), TextEditor/TextField for input. The Vue shell
// keeps state, handlers and the CSS module (passed as `c`) for theming.

import { Box, Button, Element, Grid, HStack, Image, Rectangle, Spacer, Text, TextEditor, TextField } from '@mun/core/compat'
import { Component } from '@mun/vue'

const cls = (...names) => names.filter(Boolean).join(' ')

export function postFormView(ctx) {
  const { c, components: C, d, labels: t } = ctx
  const directed = (directives, node) => Component(C.MunDirectives, { directives }, node)
  const tip = (title, node) => directed([d.tooltip(title)], node)
  const icon = className => Text('').className(className)
  const footerButton = (title, className, onClick, iconClass) => tip(title,
    Button(action: onClick, label: () => [icon(iconClass)]).className(className))

  const visibilityIcons = { public: 'ti ti-world', home: 'ti ti-home', followers: 'ti ti-lock', specified: 'ti ti-mail' }

  // Gaps come from the stylesheet: they change in its container queries.
  const headerLeft = HStack({ alignment: 'center' },
    !ctx.fixed ? Button(action: ctx.cancel, label: () => [icon('ti ti-x')]).className(cls(c.cancel, '_button')) : null,
    directed([d.clickAnime(), d.tooltip(t.account)],
      Button(action: ctx.openAccountMenu, label: () => [
        // An Image keeps its intrinsic size inside a frame; scaledToFill fills it.
        Image(ctx.account.avatarUrl, { alt: '' }).scaledToFill().style({ borderRadius: '100%' }).frame({ width: 28, height: 28 }).className(c.avatar),
      ]).className('_button').elementRef(ctx.refs.accountMenuEl)),
    Spacer(),
  ).className(c.headerLeft)

  const visibilityButton = () => ctx.targetChannel == null
    ? tip(t.visibility,
      Button(action: ctx.setVisibility, label: () => [
        icon(visibilityIcons[ctx.visibility]),
        Text(t.visibilityName).className(c.headerRightButtonText),
      ]).className(cls('_button', c.headerRightItem, c.visibility)).elementRef(ctx.refs.visibilityButton))
    : Button(action: () => {}, label: () => [
      icon('ti ti-device-tv'),
      Text(ctx.targetChannel.name).className(c.headerRightButtonText),
    ]).className(cls('_button', c.headerRightItem, c.visibility)).withProps({ disabled: true })

  const headerRight = HStack({ alignment: 'center' },
    !(ctx.targetChannel != null && ctx.fixed) ? visibilityButton() : null,
    ctx.visibility !== 'specified'
      ? tip(t.disableFederation,
        Button(action: ctx.toggleLocalOnly, label: () => [icon(ctx.localOnly ? 'ti ti-rocket-off' : 'ti ti-rocket')])
          .className(cls('_button', c.headerRightItem, ctx.localOnly && c.danger))
          .withProps({ disabled: ctx.targetChannel != null }))
      : null,
    tip(t.other,
      Button(action: ctx.showOtherSettings, label: () => [icon('ti ti-dots')])
        .className(cls('_button', c.headerRightItem)).elementRef(ctx.refs.otherSettingsButton)),
    directed([d.clickAnime()],
      Button(action: ctx.post, label: () => [
        Box(
          ctx.posted ? null : ctx.posting ? Component(C.MkEllipsis) : Text(ctx.submitText),
          icon(ctx.submitIcon).style({ marginLeft: '6px' }),
        ).className(c.submitInner),
      ]).className(cls('_button', c.submit)).withProps({ disabled: !ctx.canPost, 'data-testid': 'post-form-submit' }).elementRef(ctx.refs.submitButtonEl)),
  ).fixedSize(true, false).className(c.headerRight)

  const toSpecified = ctx.visibility === 'specified'
    ? Box(
      Text(t.recipient).style({ marginRight: '8px' }),
      Box(
        ...ctx.visibleUsers.map(u => Box(
          Component(C.MkAcct, { user: u }),
          Button(action: () => ctx.removeVisibleUser(u.id), label: () => [icon('ti ti-x')]).className('_button').style({ padding: '4px 8px' }),
        ).className(c.visibleUser).keyed(u.id)),
        Button(action: ctx.addVisibleUser, label: () => [icon('ti ti-plus ti-fw')]).className('_buttonPrimary').style({ padding: '4px', borderRadius: '8px' }),
      ).className(c.visibleUsers),
    ).className(c.toSpecified)
    : null

  const counter = (remaining, className) => Text(String(remaining)).className(className)
  const textInput = (field, input) => field.className(input.className)
    .withProps(input.props)
    .elementRef(input.ref)

  return [
    HStack({ alignment: 'stretch' }, headerLeft, headerRight).className(c.header),
    ctx.replyTargetNote ? Component(C.MkNoteSimple, { class: c.targetNote, note: ctx.replyTargetNote }) : null,
    ctx.renoteTargetNote ? Component(C.MkNoteSimple, { class: c.targetNote, note: ctx.renoteTargetNote }) : null,
    ctx.quoteId
      ? Box(icon('ti ti-quote'), Text(` ${t.quoteAttached}`), Button(action: ctx.removeQuote, label: () => [icon('ti ti-x')])).className(c.withQuote)
      : null,
    toSpecified,
    ctx.showTip
      ? Component(C.MkInfo, { class: c.showHowToUse, closable: '', onClose: ctx.closePostFormTip },
        Button(action: ctx.showTour, label: () => [Text(t.showHowToUse)]).className('_textButton'))
      : null,
    ctx.scheduledAt != null
      ? Component(C.MkInfo, { class: c.scheduledAt },
        Component(C.I18n, { src: t.scheduleToPostOnX, tag: 'span', slots: {
          x: () => Component(C.MkTime, { time: ctx.scheduledAt, mode: 'detail', style: 'font-weight: bold;' }),
        } }),
        Text(' - '),
        Button(action: ctx.cancelSchedule, label: () => [Text(t.cancel)]).className('_textButton'))
      : null,
    ctx.hasNotSpecifiedMentions
      ? Component(C.MkInfo, { warn: '', class: c.hasNotSpecifiedMentions },
        Text(`${t.notSpecifiedMentionWarning} - `),
        Button(action: ctx.addMissingMention, label: () => [Text(t.add)]).className('_textButton'))
      : null,
    // Shown with display only, like v-show: the field keeps its autocomplete.
    Box(
      textInput(TextField(ctx.inputs.cw.binding, t.annotation), ctx.inputs.cw),
      ctx.maxCwTextLength - ctx.cwTextLength < 20
        ? counter(ctx.maxCwTextLength - ctx.cwTextLength, cls('_acrylic', c.cwTextCount, ctx.cwTextLength > ctx.maxCwTextLength && c.cwTextOver))
        : null,
    ).className(c.cwOuter).style({ display: ctx.useCw ? undefined : 'none' }),
    Box(
      ctx.targetChannel ? Rectangle().background(ctx.targetChannel.color).className(c.colorBar) : null,
      textInput(TextEditor(ctx.inputs.text.binding, ctx.placeholder), ctx.inputs.text),
      ctx.maxTextLength - ctx.textLength < 100
        ? counter(ctx.maxTextLength - ctx.textLength, cls('_acrylic', c.textCount, ctx.textLength > ctx.maxTextLength && c.textOver))
        : null,
    ).className(cls(c.textOuter, ctx.useCw && c.withCw)),
    textInput(TextField(ctx.inputs.hashtags.binding, t.hashtags), ctx.inputs.hashtags)
      .style({ display: ctx.withHashtags ? undefined : 'none' }),
    Component(C.XPostFormAttaches, { modelValue: ctx.files, 'onUpdate:modelValue': ctx.setFiles, onDetach: ctx.detachFile, onChangeSensitive: ctx.updateFileSensitive, onChangeName: ctx.updateFileName }),
    ctx.uploaderItems.length > 0
      ? Box(
        Component(C.MkTip, { k: 'postFormUploader' }, Text(t.uploaderTip)),
        Component(C.MkUploaderItems, { items: ctx.uploaderItems, onShowMenu: ctx.showPerUploadItemMenu, onShowMenuViaContextmenu: ctx.showPerUploadItemMenuViaContextmenu }),
      ).padding(12)
      : null,
    ctx.poll ? Component(C.MkPollEditor, { modelValue: ctx.poll, 'onUpdate:modelValue': ctx.setPoll, onDestroyed: ctx.clearPoll }) : null,
    ctx.showPreview
      ? Component(C.MkNotePreview, { class: c.preview, text: ctx.text, files: ctx.files, poll: ctx.poll ?? undefined, useCw: ctx.useCw, cw: ctx.cw, user: ctx.account })
      : null,
    ctx.showingOptions ? Box().padding(8) : null,
    HStack({ alignment: 'stretch' },
      Grid(
        footerButton(t.attachFromPc, cls('_button', c.footerButton), ctx.chooseFileFromPc, 'ti ti-photo-plus'),
        footerButton(t.attachFromDrive, cls('_button', c.footerButton), ctx.chooseFileFromDrive, 'ti ti-cloud-download'),
        footerButton(t.poll, cls('_button', c.footerButton, ctx.poll && c.footerButtonActive), ctx.togglePoll, 'ti ti-chart-arrows'),
        footerButton(t.useCw, cls('_button', c.footerButton, ctx.useCw && c.footerButtonActive), ctx.toggleCw, 'ti ti-eye-off'),
        footerButton(t.hashtags, cls('_button', c.footerButton, ctx.withHashtags && c.footerButtonActive), ctx.toggleHashtags, 'ti ti-hash'),
        footerButton(t.mention, cls('_button', c.footerButton), ctx.insertMention, 'ti ti-at'),
        ctx.showAddMfmFunction ? footerButton(t.addMfmFunction, cls('_button', c.footerButton), ctx.insertMfmFunction, 'ti ti-palette') : null,
        ctx.hasPostFormActions ? footerButton(t.plugins, cls('_button', c.footerButton), ctx.showActions, 'ti ti-plug') : null,
      ).className(c.footerLeft),
      Grid(
        footerButton(t.emoji, cls('_button', c.footerButton), ctx.insertEmoji, 'ti ti-mood-happy'),
      ).className(c.footerRight),
    ).elementRef(ctx.refs.footerEl).className(c.footer),
    // Mün has no datalist view; this feeds the hashtag field's suggestions.
    Element('datalist', { id: 'hashtags' },
      ...ctx.recentHashtags.map(hashtag => Element('option', { key: hashtag, value: hashtag }))),
  ]
}
