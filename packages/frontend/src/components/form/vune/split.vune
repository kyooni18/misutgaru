/* @misutgaru-vune-native */
import { Grid, type ViewGraphValue } from 'vune-ui';
import '@/components/vune/misskey-vune.scss';

export struct FormSplit: View {
	let minWidth: number
	let content: ViewGraphValue

	init(minWidth: number = 210, @ViewBuilder content: () => ViewGraphValue) {
		self.minWidth = minWidth
		self.content = content()
	}

	var body: some View {
		Grid({ columns: `repeat(auto-fill, minmax(${minWidth}px, 1fr))` }) {
			content
		}
			.className('mk-vune-form-split')
	}
}

export default FormSplit
