/* @misutgaru-vune-native */
import { State, Text } from 'vune-ui';
import { dateTimeFormat } from '@@/js/intl-const.js';
import { i18n } from '@/i18n.js';

type TimeValue = Date | string | number | null;
const now = State(Date.now());
if (typeof window !== 'undefined') {
	window.setInterval(() => { now.value = Date.now(); }, 30_000);
}

function timestamp(value: TimeValue): number {
	if (value == null) return Number.NaN;
	try { return value instanceof Date ? value.getTime() : new Date(value).getTime(); } catch { return Number.NaN; }
}
function relativeText(seconds: number): string {
	return seconds >= 31536000 ? i18n.tsx._ago.yearsAgo({ n: Math.round(seconds / 31536000).toString() }) :
		seconds >= 2592000 ? i18n.tsx._ago.monthsAgo({ n: Math.round(seconds / 2592000).toString() }) :
		seconds >= 604800 ? i18n.tsx._ago.weeksAgo({ n: Math.round(seconds / 604800).toString() }) :
		seconds >= 86400 ? i18n.tsx._ago.daysAgo({ n: Math.round(seconds / 86400).toString() }) :
		seconds >= 3600 ? i18n.tsx._ago.hoursAgo({ n: Math.round(seconds / 3600).toString() }) :
		seconds >= 60 ? i18n.tsx._ago.minutesAgo({ n: Math.trunc(seconds / 60).toString() }) :
		seconds >= 10 ? i18n.tsx._ago.secondsAgo({ n: Math.trunc(seconds % 60).toString() }) :
		seconds >= -3 ? i18n.ts._ago.justNow :
		seconds < -31536000 ? i18n.tsx._timeIn.years({ n: Math.round(-seconds / 31536000).toString() }) :
		seconds < -2592000 ? i18n.tsx._timeIn.months({ n: Math.round(-seconds / 2592000).toString() }) :
		seconds < -604800 ? i18n.tsx._timeIn.weeks({ n: Math.round(-seconds / 604800).toString() }) :
		seconds < -86400 ? i18n.tsx._timeIn.days({ n: Math.round(-seconds / 86400).toString() }) :
		seconds < -3600 ? i18n.tsx._timeIn.hours({ n: Math.round(-seconds / 3600).toString() }) :
		seconds < -60 ? i18n.tsx._timeIn.minutes({ n: Math.trunc(-seconds / 60).toString() }) :
		i18n.tsx._timeIn.seconds({ n: Math.trunc(-seconds % 60).toString() });
}

function absoluteText(time: TimeValue): string {
	const value = timestamp(time);
	return Number.isNaN(value) ? i18n.ts._ago.invalid : dateTimeFormat.format(value);
}
function ageSeconds(time: TimeValue): number {
	const value = timestamp(time);
	return Number.isNaN(value) ? 0 : (now.value - value) / 1000;
}
function displayText(time: TimeValue, mode: 'relative' | 'absolute' | 'detail'): string {
	const absolute = absoluteText(time);
	const value = timestamp(time);
	const relative = Number.isNaN(value) ? i18n.ts._ago.invalid : relativeText(ageSeconds(time));
	return mode === 'absolute' ? absolute : mode === 'detail' ? `${absolute} (${relative})` : relative;
}

export struct MkTimeValue: View {
	let time: TimeValue
	let mode: 'relative' | 'absolute' | 'detail'
	let colored: boolean
	let className: string
	init(_ time: TimeValue, mode: 'relative' | 'absolute' | 'detail' = 'relative', colored: boolean = false, className: string = '') {
		self.time = time
		self.mode = mode
		self.colored = colored
		self.className = className
	}
	var body: some View {
		Text(displayText(time, mode))
			.className([className, colored && ageSeconds(time) > 60 * 60 * 24 * 90 ? 'mk-vune-time-value--old1' : null, colored && ageSeconds(time) > 60 * 60 * 24 * 180 ? 'mk-vune-time-value--old2' : null])
			.withProps({ title: absoluteText(time) })
	}
}

export default MkTimeValue
