/* @misutgaru-vune-native */
import type * as Misskey from 'misskey-js';
import MkPlainMfm from './MkPlainMfm.vune';

type Props = {
	user: Misskey.entities.User;
	nowrap?: boolean;
	className?: string;
};

export struct MkUserName: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkPlainMfm(
			props.user.name ?? props.user.username,
			author: props.user,
			emojiUrls: props.user.emojis,
			nowrap: props.nowrap ?? true,
			className: props.className ?? '',
		)
	}
}

export default MkUserName
