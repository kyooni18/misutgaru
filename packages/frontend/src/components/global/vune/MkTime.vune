import { Text } from 'vune-ui';
import { i18n } from '@/i18n.js';

function timeContent(invalid: boolean, mode: 'relative' | 'absolute' | 'detail', absolute: string, relative: string): string {
	return invalid
		? i18n.ts._ago.invalid
		: mode === 'absolute'
			? absolute
			: mode === 'detail'
				? `${absolute} (${relative})`
				: relative
}

export struct MkTime: View {
	let absolute: string
	let relative: string
	let ago: number
	let old1Class: string
	let old2Class: string
	let invalid: boolean
	let mode: 'relative' | 'absolute' | 'detail'
	let colored: boolean

	init(
		_ absolute: string,
		_ relative: string,
		_ ago: number,
		_ old1Class: string,
		_ old2Class: string,
		invalid: boolean = false,
		mode: 'relative' | 'absolute' | 'detail' = 'relative',
		colored: boolean = false,
	) {
		self.absolute = absolute
		self.relative = relative
		self.ago = ago
		self.old1Class = old1Class
		self.old2Class = old2Class
		self.invalid = invalid
		self.mode = mode
		self.colored = colored
	}

	var body: some View {
		return Text(timeContent(invalid, mode, absolute, relative))
			.className([
				colored && ago > 60 * 60 * 24 * 90 ? old1Class : null,
				colored && ago > 60 * 60 * 24 * 180 ? old2Class : null,
			])
			.withProps({ title: absolute })
	}
}

export default MkTime
