/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Image, Text, type ViewGraphValue } from 'vune-ui';
import * as mfm from 'mfm-js';
import type * as Misskey from 'misskey-js';
import { colorizeEmoji } from '@@/js/emojilist.js';
import { char2fluentEmojiFilePath, char2twemojiFilePath } from '@@/js/emoji-base.js';
import { getCustomEmojiImagePath } from '@@/js/emoji-name.js';
import { customEmojisMap } from '@/custom-emojis.js';
import { prefer } from '@/preferences.js';
import { getProxiedImageUrl, getStaticImageUrl } from '@/utility/media-proxy.js';
import './MkPlainMfm.scss';

type EmojiUrls = Record<string, string> | undefined;

function isMuted(key: string): boolean {
	return prefer.r.mutingEmojis.value.includes(key);
}

function unicodeEmoji(emoji: string): ViewGraphValue {
	if (isMuted(emoji)) {
		return Image('/client-assets/unknown.png', { alt: emoji }).className('mk-vune-plain-mfm__emoji').withProps({ decoding: 'async' });
	}
	if (prefer.s.emojiStyle === 'native') return Text(colorizeEmoji(emoji));
	const src = (prefer.s.emojiStyle === 'twemoji' ? char2twemojiFilePath : char2fluentEmojiFilePath)(emoji);
	return Image(src, { alt: emoji }).className('mk-vune-plain-mfm__emoji').withProps({ decoding: 'async', draggable: false });
}

function customEmojiSource(name: string, author: Misskey.entities.User | undefined, emojiUrls: EmojiUrls): string | null {
	const host = author?.host ?? null;
	if (host != null && emojiUrls && emojiUrls[name] == null) return null;
	const explicit = emojiUrls?.[name];
	const raw = explicit ?? (host == null ? customEmojisMap.get(name)?.url : undefined) ?? getCustomEmojiImagePath(name, host);
	if (!raw) return null;
	const proxied = raw.startsWith('/emoji/') ? raw : getProxiedImageUrl(raw, 'emoji', false, true);
	return prefer.s.disableShowingAnimatedImages ? getStaticImageUrl(proxied) : proxied;
}

function customEmoji(name: string, author: Misskey.entities.User | undefined, emojiUrls: EmojiUrls): ViewGraphValue {
	const host = author?.host ?? null;
	const alt = `:${name}:`;
	const muteKey = `:${name}${host ? `@${host}` : ''}:`;
	if (isMuted(muteKey)) {
		return Image('/client-assets/unknown.png', { alt }).className('mk-vune-plain-mfm__emoji mk-vune-plain-mfm__emoji--custom').withProps({ title: alt, decoding: 'async' });
	}
	const src = customEmojiSource(name, author, emojiUrls);
	if (!src) return Text(alt);
	return Image(src, { alt })
		.className('mk-vune-plain-mfm__emoji mk-vune-plain-mfm__emoji--custom')
		.withProps({ title: alt, decoding: 'async', draggable: false, onError: (event: Event) => {
			const element = event.currentTarget as HTMLImageElement | null;
			if (element?.parentNode) element.replaceWith(document.createTextNode(alt));
		} });
}

function nodeView(node: mfm.MfmSimpleNode, author: Misskey.entities.User | undefined, emojiUrls: EmojiUrls): ViewGraphValue {
	if (node.type === 'text') return Text(node.props.text);
	if (node.type === 'unicodeEmoji') return unicodeEmoji(node.props.emoji);
	if (node.type === 'emojiCode') return customEmoji(node.props.name, author, emojiUrls);
	return Group() {
		ForEach(node.children, key: (_child: mfm.MfmText, index: number) => index) { child in
			Text(child.props.text)
		}
	};
}

function parsedText(text: string): mfm.MfmSimpleNode[] {
	return text ? mfm.parseSimple(text) : [];
}

export struct MkPlainMfm: View {
	let text: string
	let author: Misskey.entities.User | undefined
	let emojiUrls: EmojiUrls
	let nowrap: boolean
	let className: string

	init(
		_ text: string,
		author: Misskey.entities.User | undefined = undefined,
		emojiUrls: EmojiUrls = undefined,
		nowrap: boolean = false,
		className: string = '',
	) {
		self.text = text
		self.author = author
		self.emojiUrls = emojiUrls
		self.nowrap = nowrap
		self.className = className
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			ForEach(parsedText(text), key: (_node: mfm.MfmSimpleNode, index: number) => index) { node in
				nodeView(node, author, emojiUrls)
			}
		}.className(['mk-vune-plain-mfm', nowrap ? 'mk-vune-plain-mfm--nowrap' : null, className])
	}
}

export default MkPlainMfm
