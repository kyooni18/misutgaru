/* @misutgaru-vune-native */
import { ScrollView, VStack, type ViewGraphValue } from 'vune-ui';
import type { PageMetadata } from '@/page.js';
import type { PageHeaderItem } from '@/types/page-header.js';
import MkStickyContainer from './MkStickyContainer.vune';
import MkPageHeader from './MkPageHeader.vune';
import MkTabs, { type NativeTab } from '@/components/vune/MkTabs.vune';
import { prefer } from '@/preferences.js';
import './PageWithHeader.scss';

type TabAction = (key: string) => void;
function ignoreTab(_key: string): void {}

function swipeRef(tabs: NativeTab[], tab: string, enabled: boolean, onTab: TabAction) {
	let startX = 0;
	let startY = 0;
	let tracking = false;
	const pointerDown = (event: PointerEvent) => { startX = event.clientX; startY = event.clientY; tracking = true; };
	const pointerUp = (event: PointerEvent) => {
		if (!tracking) return;
		tracking = false;
		const dx = event.clientX - startX;
		const dy = event.clientY - startY;
		if (!enabled || tabs.length < 2 || Math.abs(dx) < 55 || Math.abs(dx) < Math.abs(dy) * 1.25) return;
		const current = Math.max(0, tabs.findIndex(item => item.key === tab));
		const next = dx < 0 ? Math.min(tabs.length - 1, current + 1) : Math.max(0, current - 1);
		if (next !== current) onTab(tabs[next].key);
	};
	return (element: HTMLElement | null) => {
		if (!element) return;
		element.addEventListener('pointerdown', pointerDown, { passive: true });
		element.addEventListener('pointerup', pointerUp, { passive: true });
	};
}

export struct PageWithHeader: View {
	let pageMetadata: PageMetadata | null
	let tab: string
	let actions: PageHeaderItem[]
	let tabs: NativeTab[]
	let reversed: boolean
	let swipable: boolean
	let thin: boolean
	let hideTitle: boolean
	let canOmitTitle: boolean
	let displayMyAvatar: boolean
	let onTab: TabAction
	let footer: ViewGraphValue
	let content: ViewGraphValue

	init(
		pageMetadata: PageMetadata | null,
		tab: string = '',
		actions: PageHeaderItem[] = [],
		tabs: NativeTab[] = [],
		reversed: boolean = false,
		swipable: boolean = true,
		thin: boolean = false,
		hideTitle: boolean = false,
		canOmitTitle: boolean = false,
		displayMyAvatar: boolean = false,
		@Action onTab: TabAction = ignoreTab,
		footer: ViewGraphValue = null,
		@ViewBuilder content: () => ViewGraphValue,
	) {
		self.pageMetadata=pageMetadata;self.tab=tab;self.actions=actions;self.tabs=tabs;self.reversed=reversed;self.swipable=swipable;self.thin=thin;self.hideTitle=hideTitle;self.canOmitTitle=canOmitTitle;self.displayMyAvatar=displayMyAvatar;self.onTab=onTab;self.footer=footer;self.content=content()
	}
	var body: some View {
		ScrollView('vertical') {
			MkStickyContainer(
				header: MkPageHeader(pageMetadata: pageMetadata, tabs: prefer.s.showPageTabBarBottom ? [] : tabs, tab: tab, actions: actions, thin: thin, hideTitle: hideTitle, canOmitTitle: canOmitTitle, displayMyAvatar: displayMyAvatar, onTab: onTab),
				footer: VStack(alignment: 'stretch', spacing: 0) {
					footer
					if (prefer.s.showPageTabBarBottom && tabs.length > 0) {
						VStack(alignment: 'leading', spacing: 0) { MkTabs(tabs, tab: tab, centered: true, tabHighlightUpper: true, onTab: onTab) }
							.className('_materialBar mk-vune-page-with-header__footer-tabs')
					}
				},
			) {
				VStack(alignment: 'leading', spacing: 0) { content }.className('mk-vune-page-with-header__body')
			}
		}
			.className(reversed ? '_pageScrollableReversed' : '_pageScrollable')
			.elementRef(swipeRef(tabs, tab, prefer.s.enableHorizontalSwipe && swipable, onTab))
	}
}
export default PageWithHeader
