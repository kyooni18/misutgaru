import { VStack, type ViewGraphValue } from 'vune-ui';
import './MkStickyContainer.scss';

type ElementRef = (element: HTMLElement | null) => void;

function stickyRefs() {
	let root: HTMLElement | null = null;
	let header: HTMLElement | null = null;
	let footer: HTMLElement | null = null;
	let body: HTMLElement | null = null;
	let observer: ResizeObserver | null = null;
	let frame: number | null = null;

	const schedule = () => {
		if (frame != null) return;
		frame = window.requestAnimationFrame(() => {
			frame = null;
			if (!root || !body) return;
			const parentBody = root.parentElement?.closest<HTMLElement>('[data-vune-sticky-body]') ?? null;
			const parentTop = Number(parentBody?.dataset.stickyTopTotal ?? 0) || 0;
			const parentBottom = Number(parentBody?.dataset.stickyBottomTotal ?? 0) || 0;
			const headerHeight = header?.offsetHeight ?? 0;
			const footerHeight = footer?.offsetHeight ?? 0;
			const top = parentTop + headerHeight;
			const bottom = parentBottom + footerHeight;
			body.dataset.stickyContainerHeaderHeight = String(headerHeight);
			body.dataset.stickyContainerFooterHeight = String(footerHeight);
			body.dataset.stickyTopTotal = String(top);
			body.dataset.stickyBottomTotal = String(bottom);
			body.style.setProperty('--MI-stickyTop', `${top}px`);
			body.style.setProperty('--MI-stickyBottom', `${bottom}px`);
			if (header) header.style.top = `${parentTop}px`;
			if (footer) footer.style.bottom = `${parentBottom}px`;
		});
	};

	const reconnect = () => {
		observer?.disconnect();
		observer = null;
		if (typeof ResizeObserver !== 'undefined') {
			observer = new ResizeObserver(schedule);
			if (header) observer.observe(header);
			if (footer) observer.observe(footer);
		}
		schedule();
	};

	const setRoot: ElementRef = element => { root = element; reconnect(); };
	const setHeader: ElementRef = element => { header = element; reconnect(); };
	const setFooter: ElementRef = element => { footer = element; reconnect(); };
	const setBody: ElementRef = element => { body = element; reconnect(); };
	return { setRoot, setHeader, setFooter, setBody };
}

export struct MkStickyContainer: View {
	let className: string
	let header: ViewGraphValue
	let footer: ViewGraphValue
	let content: ViewGraphValue
	let refs: ReturnType<typeof stickyRefs>

	init(
		className: string = '',
		header: ViewGraphValue = null,
		footer: ViewGraphValue = null,
		@ViewBuilder content: () => ViewGraphValue,
	) {
		self.className = className
		self.header = header
		self.footer = footer
		self.content = content()
		self.refs = stickyRefs()
	}

	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			VStack(alignment: 'leading', spacing: 0) { header }
				.className('mk-vune-sticky-container__header')
				.elementRef(refs.setHeader)
			VStack(alignment: 'leading', spacing: 0) { content }
				.className('mk-vune-sticky-container__body')
				.withProps({ 'data-vune-sticky-body': true })
				.elementRef(refs.setBody)
			VStack(alignment: 'leading', spacing: 0) { footer }
				.className('mk-vune-sticky-container__footer')
				.elementRef(refs.setFooter)
		}
			.className(['mk-vune-sticky-container', className])
			.elementRef(refs.setRoot)
	}
}

export default MkStickyContainer
