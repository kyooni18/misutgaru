/* @misutgaru-vune-native */
import { VStack, Image, Link, Text } from 'vune-ui';
export struct MkAd: View {
	let ad: any
	init(_ ad: any) { self.ad = ad }
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			if (ad?.imageUrl) { Image(String(ad.imageUrl), { alt: String(ad.title ?? '') }) }
			Text(String(ad?.title ?? ad?.url ?? ''))
		}.className('mk-vune-ad').withProps({ onClick: () => { if (ad?.url) window.open(String(ad.url), '_blank', 'noopener') } })
	}
}
export default MkAd
