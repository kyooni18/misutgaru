import { Element, Text } from 'vune-ui';
import MkButton from '@/components/MkButton.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent, VueSlot } from '@/vune/vue.js';

type Props = { hidden?: boolean; warn?: boolean; rootClass: string; warnClass: string; onClose?: () => void; onMenu?: (event: PointerEvent) => void };
export default createVuneComponent<Props>((props, slots) =>
	props.hidden ? Element('span', { style: { display: 'none' } }) : Element('div', { className: [props.rootClass, props.warn ? props.warnClass : null, '_selectable', '_gaps_s'] },
		Element('div', { style: { fontWeight: 'bold' } }, Element('i', { className: 'ti ti-bulb' }), ` ${i18n.ts.tip}:`),
		Element('div', {}, VueSlot(slots.default)),
		Element('div', {},
			VueComponent(MkButton, { inline: true, primary: true, rounded: true, small: true, onClick: () => props.onClose?.() }, {
				default: () => Element('span', {}, Element('i', { className: 'ti ti-check' }), ` ${i18n.ts.gotIt}`),
			}),
			Element('button', { className: '_button', style: { padding: '8px', marginLeft: '4px' }, onClick: (event: PointerEvent) => props.onMenu?.(event) }, Element('i', { className: 'ti ti-dots' })),
		),
	)
);
