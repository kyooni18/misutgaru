import { Group, HStack, Text, VStack, type ViewGraphValue } from 'vune-ui';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
import './MkTip.scss';

function ignoreTipClose(): void {}
function ignoreTipMenu(_event: PointerEvent): void {}

export struct MkTip: View {
	let hidden: boolean
	let warn: boolean
	let onClose: () => void
	let onMenu: (event: PointerEvent) => void
	let content: ViewGraphValue

	init(
		hidden: boolean = false,
		warn: boolean = false,
		@Action onClose: () => void = ignoreTipClose,
		@Action onMenu: (event: PointerEvent) => void = ignoreTipMenu,
		@ViewBuilder content: () => ViewGraphValue,
	) {
		self.hidden = hidden
		self.warn = warn
		self.onClose = onClose
		self.onMenu = onMenu
		self.content = content()
	}

	var body: some View {
		Group() {
			if (!hidden) {
				VStack(alignment: 'leading', spacing: 8) {
					HStack(alignment: 'center', spacing: 4) {
						VuneIcon('ti ti-bulb')
						Text(`${i18n.ts.tip}:`)
					}.bold()
					VStack(alignment: 'leading', spacing: 0) { content }
					HStack(alignment: 'center', spacing: 4) {
						MkButton(inline: true, primary: true, rounded: true, small: true, onClick: { onClose() }) {
							Group() {
								VuneIcon('ti ti-check')
								Text(` ${i18n.ts.gotIt}`)
							}
						}
						MkButton(transparent: true, iconOnly: true, onClick: onMenu) {
							VuneIcon('ti ti-dots')
						}
							.style({ padding: '8px', marginLeft: '4px' })
					}
				}
					.className(['mk-vune-tip', warn ? 'mk-vune-tip--warn' : null, '_selectable', '_gaps_s'])
			}
		}
	}
}

export default MkTip
