import { Image, Text, VStack } from 'vune-ui';
import { instance } from '@/instance.js';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
import '@/components/vune/misskey-vune.scss';

export type ResultType = 'empty' | 'notFound' | 'error';

function resultText(type: ResultType): string {
	if (type === 'empty') return i18n.ts.nothing;
	if (type === 'notFound') return i18n.ts.notFound;
	return i18n.ts.somethingHappened;
}

function resultImage(type: ResultType): string | null | undefined {
	if (type === 'empty') return instance.infoImageUrl;
	if (type === 'notFound') return instance.notFoundImageUrl;
	return instance.serverErrorImageUrl;
}

function resultIcon(type: ResultType): string {
	if (type === 'empty') return 'ti ti-info-circle';
	if (type === 'notFound') return 'ti ti-help-circle';
	return 'ti ti-alert-circle';
}

export struct MkResult: View {
	let type: ResultType
	let text: string | undefined

	init(_ type: ResultType, text: string | undefined = undefined) {
		self.type = type
		self.text = text
	}

	var body: some View {
		VStack(alignment: 'center', spacing: 12) {
			if (resultImage(type)) {
				Image(resultImage(type)!, { alt: '' })
					.className('mk-vune-result__img')
					.withProps({ draggable: false })
			} else {
				VuneIcon(resultIcon(type)).className('mk-vune-result__fallback-icon')
			}
			Text(text ?? resultText(type)).opacity(0.7)
		}
			.className(['_gaps', 'mk-vune-result'])
	}
}

export default MkResult
