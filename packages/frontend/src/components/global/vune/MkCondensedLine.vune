/* @misutgaru-vune-native */
import { Group, type ViewGraphValue } from 'vune-ui';

export struct MkCondensedLine: View {
	let content: ViewGraphValue
	init(minScale: number = 0.5, @ViewBuilder content: () => ViewGraphValue) { self.content = content() }
	var body: some View { Group() { content }.lineLimit(1).minimumScaleFactor(0.5) }
}

export default MkCondensedLine
