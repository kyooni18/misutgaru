/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Image, type ViewGraphValue } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import { extractAvgColorFromBlurhash } from '@@/js/extract-avg-color-from-blurhash.js';
import MkUserOnlineIndicator from './MkUserOnlineIndicator.vune';
import MkA from './MkA.vune';
import { getStaticImageUrl } from '@/utility/media-proxy.js';
import { acct, userPage } from '@/filters/user.js';
import { prefer } from '@/preferences.js';
import { UserPreview } from '@/directives/user-preview.js';
import { isTouchUsing } from '@/utility/touch.js';
import './MkAvatar.scss';

type Decoration = Misskey.entities.UserDetailed['avatarDecorations'][number];
type EditorDecoration = Omit<Decoration, 'id'> & { blink?: boolean };
type AvatarClick = (event: PointerEvent) => void;

const previews = new WeakMap<HTMLElement, UserPreview>();
function ignoreAvatarClick(_event: PointerEvent): void {}

function previewRef(enabled: boolean, user: Misskey.entities.User) {
	let current: HTMLElement | null = null;
	return (element: HTMLElement | null) => {
		if (current != null) {
			previews.get(current)?.detach();
			previews.delete(current);
			current = null;
		}
		if (element == null || !enabled || isTouchUsing) return;
		const preview = new UserPreview(element, user.id);
		previews.set(element, preview);
		current = element;
	};
}

function imageUrl(url: string): string {
	return prefer.s.disableShowingAnimatedImages || prefer.s.dataSaver.avatar ? getStaticImageUrl(url) : url;
}

function decorationUrl(decoration: Decoration | EditorDecoration): string {
	return imageUrl(decoration.url);
}

function decorationStyle(decoration: Decoration | EditorDecoration) {
	const angle = decoration.angle ?? 0;
	const offsetX = decoration.offsetX ?? 0;
	const offsetY = decoration.offsetY ?? 0;
	return {
		rotate: angle === 0 ? undefined : `${angle * 360}deg`,
		scale: decoration.flipH ? '-1 1' : undefined,
		translate: offsetX === 0 && offsetY === 0 ? undefined : `${offsetX * 100}% ${offsetY * 100}%`,
	};
}

function avatarContents(
	user: Misskey.entities.User,
	indicator: boolean,
	decorations: EditorDecoration[] | undefined,
	forceShowDecoration: boolean,
): ViewGraphValue {
	const url = imageUrl(user.avatarUrl);
	const color = user.avatarBlurhash == null ? undefined : extractAvgColorFromBlurhash(user.avatarBlurhash);
	const items = decorations ?? ('avatarDecorations' in user ? user.avatarDecorations : []);
	const showDecoration = forceShowDecoration || prefer.s.showAvatarDecorations;
	return Group() {
		Image(url, { alt: '' })
			.className('mk-vune-avatar__inner')
			.style({ pointerEvents: 'none', background: color })
			.withProps({ decoding: 'async', draggable: false })
		if (indicator) { MkUserOnlineIndicator(user, className: 'mk-vune-avatar__indicator') }
		if (user.isCat) {
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0).className('mk-vune-avatar__ear-left')
				VStack(alignment: 'stretch', spacing: 0).className('mk-vune-avatar__ear-right')
			}.className('mk-vune-avatar__ears')
		}
		if (showDecoration) {
			ForEach(items, key: (decoration: Decoration | EditorDecoration, index: number) => 'id' in decoration ? decoration.id : `${index}:${decoration.url}`) { decoration in
				Image(decorationUrl(decoration), { alt: '' })
					.className(['mk-vune-avatar__decoration', 'blink' in decoration && decoration.blink === true ? 'mk-vune-avatar__decoration--blink' : null])
					.style(decorationStyle(decoration))
					.withProps({ draggable: false })
			}
		}
	};
}

function avatarRoot(
	user: Misskey.entities.User,
	link: boolean,
	preview: boolean,
	target: string | null,
	indicator: boolean,
	decorations: EditorDecoration[] | undefined,
	forceShowDecoration: boolean,
	className: any,
	style: any,
	onClick: AvatarClick,
) {
	const classes = [
		'_noSelect',
		'mk-vune-avatar',
		prefer.s.animation ? 'mk-vune-avatar--animation' : '',
		user.isCat ? 'mk-vune-avatar--cat' : '',
		prefer.s.squareAvatars ? 'mk-vune-avatar--square' : '',
		typeof className === 'string' ? className : '',
	].filter(Boolean).join(' ');
	const content = avatarContents(user, indicator, decorations, forceShowDecoration);
	const reference = previewRef(preview, user);
	if (link) {
		const to = userPage(user);
		return MkA(to, behavior: target == null ? null : 'browser', className: classes, onClick: onClick) { content }
			.style(style ?? {})
			.elementRef(reference)
			.withProps({ target: target ?? undefined, title: acct(user) });
	}
	return VStack(alignment: 'stretch', spacing: 0) { content }
		.className(classes)
		.style(style ?? {})
		.elementRef(reference)
		.withProps({ title: acct(user), onClick });
}

export struct MkAvatar: View {
	let user: Misskey.entities.User
	let target: string | null
	let link: boolean
	let preview: boolean
	let indicator: boolean
	let decorations: EditorDecoration[] | undefined
	let forceShowDecoration: boolean
	let className: any
	let style: any
	let onClick: AvatarClick

	init(
		_ user: Misskey.entities.User,
		target: string | null = null,
		link: boolean = false,
		preview: boolean = false,
		indicator: boolean = false,
		decorations: EditorDecoration[] | undefined = undefined,
		forceShowDecoration: boolean = false,
		className: any = '',
		style: any = undefined,
		@Action onClick: AvatarClick = ignoreAvatarClick,
	) {
		self.user = user
		self.target = target
		self.link = link
		self.preview = preview
		self.indicator = indicator
		self.decorations = decorations
		self.forceShowDecoration = forceShowDecoration
		self.className = className
		self.style = style
		self.onClick = onClick
	}

	var body: some View {
		return avatarRoot(user, link, preview, target, indicator, decorations, forceShowDecoration, className, style, onClick)
	}
}

export default MkAvatar
