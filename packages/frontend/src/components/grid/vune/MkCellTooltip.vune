import { Text } from 'vune-ui';
import MkTooltip from '@/components/vune/MkTooltip.vune';
import '../../vune/misskey-vune.scss';

type Props = {
	showing: boolean;
	content: string;
	anchorElement: HTMLElement;
	onClosed?: () => void;
};

export struct MkCellTooltip: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkTooltip(
			showing: props.showing,
			anchorElement: props.anchorElement,
			maxWidth: 250,
			onClosed: { props.onClosed?.() },
		) {
			Text(props.content ?? '').className('mk-vune-grid-cell-tooltip')
		}
	}
}

export default MkCellTooltip
