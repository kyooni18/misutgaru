/* @misutgaru-vune-native */
import { VStack, Image, Text } from 'vune-ui';
import type { GridCell } from '@/components/grid/cell.js';
import VuneIcon from '@/vune/Icon.vune';

export struct MkDataCell: View {
	let cell: GridCell
	init(_ cell: GridCell) { self.cell = cell }
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			if (cell.column.setting.type === 'boolean') {
				if (cell.value === true) { VuneIcon('ti ti-check') }
			} else if (cell.column.setting.type === 'image' && typeof cell.value === 'string') {
				Image(cell.value, { alt: cell.value }).className('mk-vune-grid-data-cell__image')
			} else {
				Text(cell.value == null ? '' : String(cell.value))
			}
		}.className(['mk_grid_td', 'mk-vune-grid-data-cell', cell.selected ? 'mk-vune-grid-data-cell--selected' : null])
			.style({ maxWidth: cell.column.width, minWidth: cell.column.width })
			.withProps({ tabIndex: -1, 'data-grid-cell': '', 'data-grid-cell-row': cell.row.index, 'data-grid-cell-col': cell.column.index })
	}
}
export default MkDataCell
