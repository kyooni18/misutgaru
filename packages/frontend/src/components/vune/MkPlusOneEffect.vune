/* @misutgaru-vune-native */
import { Animation, Box, Text } from 'vune-ui';

export struct MkPlusOneEffect: View {
	let x: number
	let y: number
	let value: number | string
	let zIndex: number
	let up: boolean
	let angle: string
	let rootClass: string

	init(
		_ x: number,
		_ y: number,
		value: number | string,
		zIndex: number,
		up: boolean = false,
		angle: string,
		rootClass: string,
	) {
		self.x = x
		self.y = y
		self.value = value
		self.zIndex = zIndex
		self.up = up
		self.angle = angle
		self.rootClass = rootClass
	}

	var body: some View {
		Box() {
			Text(`+${value}`)
				.className(['text', up ? 'up' : null])
				.style(up ? { transform: `translateY(-50px) rotateZ(${angle})` } : {})
				.animation(Animation.easeInOut(1), value: up)
		}
			.className(rootClass)
			.style({ zIndex, top: `${y - 64}px`, left: `${x - 64}px` })
	}
}

export default MkPlusOneEffect
