/* @misutgaru-vune-native */
import { VStack, Text, State, type StateRef } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkA from '@/components/global/vune/MkA.vune';
import MkTimeValue from '@/components/global/vune/MkTimeValue.vune';
import { $i as currentUser } from '@/i.js';
import { i18n } from '@/i18n.js';
import { miLocalStorage } from '@/local-storage.js';
import VuneIcon from '@/vune/Icon.vune';
import './MkChannelPreview.scss';

const readStates = new Map<string, StateRef<number | null>>();
function readState(channelId: string): StateRef<number | null> {
	let state = readStates.get(channelId);
	if (!state) {
		state = State<number | null>(miLocalStorage.getItemAsJson(`channelLastReadedAt:${channelId}`) ?? null);
		readStates.set(channelId, state);
	}
	return state;
}
function countText(template: string, value: number): string {
	return template.replace('{n}', String(value));
}
function isChannelUnread(channel: Misskey.entities.Channel, lastRead: StateRef<number | null>): boolean {
	return channel.lastNotedAt != null && (channel.isFavorited || channel.isFollowing) && (lastRead.value == null || Date.parse(channel.lastNotedAt) > lastRead.value);
}
function markChannelRead(channel: Misskey.entities.Channel, lastRead: StateRef<number | null>): void {
	lastRead.value = channel.lastNotedAt ? Date.parse(channel.lastNotedAt) : Date.now();
}

export struct MkChannelPreview: View {
	let channel: Misskey.entities.Channel
	let lastRead: StateRef<number | null>
	let description: string | null
	init(_ channel: Misskey.entities.Channel) {
		self.channel = channel
		self.lastRead = readState(channel.id)
		self.description = channel.description ? (channel.description.length > 85 ? `${channel.description.slice(0, 85)}…` : channel.description) : null
	}
	var body: some View {
	VStack(alignment: 'leading', spacing: 0) {
		MkA(`/channels/${channel.id}`, className: '_panel mk-vune-channel-preview', onClick: {
			markChannelRead(channel, lastRead)
		}) {
			VStack(alignment: 'leading', spacing: 0) {
				VStack(alignment: 'leading', spacing: 0).className('mk-vune-channel-preview__fade')
				VStack(alignment: 'leading', spacing: 0) { VuneIcon('ti ti-device-tv'); Text(` ${channel.name}`) }.className('mk-vune-channel-preview__name')
				if (channel.isSensitive) { Text(i18n.ts.sensitive).className('mk-vune-channel-preview__sensitive') }
				VStack(alignment: 'leading', spacing: 0) {
					VStack(alignment: 'leading', spacing: 0) { VuneIcon('ti ti-users ti-fw'); Text(` ${countText(i18n.ts._channel.usersCount, channel.usersCount)}`) }
					VStack(alignment: 'leading', spacing: 0) { VuneIcon('ti ti-pencil ti-fw'); Text(` ${countText(i18n.ts._channel.notesCount, channel.notesCount)}`) }
					if (currentUser != null && currentUser.id === channel.userId) { VStack(alignment: 'leading', spacing: 0) { VuneIcon('ti ti-user-star ti-fw'); Text(` ${i18n.ts.youAreAdmin}`) }.foregroundStyle('var(--MI_THEME-warn)') }
				}.className('mk-vune-channel-preview__status')
			}
				.className('mk-vune-channel-preview__banner')
				.style(channel.bannerUrl ? { backgroundImage: `url(${channel.bannerUrl})` } : { backgroundColor: '#4c5e6d' })
			if (description) { Text(description).withProps({ title: channel.description ?? '' }) }
			if (channel.lastNotedAt) { VStack(alignment: 'leading', spacing: 0) { Text(`${i18n.ts.updatedAt}: `); MkTimeValue(channel.lastNotedAt) } }
		}
		if (isChannelUnread(channel, lastRead)) { VStack(alignment: 'leading', spacing: 0).className('mk-vune-channel-preview__indicator') }
	}.className('mk-vune-channel-preview-wrap')
	}
}
export default MkChannelPreview
