/* @misutgaru-vune-native */
import { Button, ForEach, HStack, Text } from 'vune-ui';
import { i18n } from '@/i18n.js';
import '@/components/vune/misskey-vune-paging-buttons.scss';

type PageAction = (page: number) => void;
function ignorePageAction(_page: number): void {}

export struct MkPagingButtons: View {
	let min: number
	let current: number
	let max: number
	let buttonRanges: number[]
	let prevDotVisible: boolean
	let nextDotVisible: boolean
	let rootClass: string
	let buttonsClass: string
	let headTailClass: string
	let onPage: PageAction

	init(
		min: number,
		current: number,
		max: number,
		buttonRanges: number[],
		rootClass: string = '',
		buttonsClass: string = '',
		headTailClass: string = '',
		prevDotVisible: boolean = false,
		nextDotVisible: boolean = false,
		@Action onPage: PageAction = ignorePageAction,
	) {
		self.min = min
		self.current = current
		self.max = max
		self.buttonRanges = buttonRanges
		self.prevDotVisible = prevDotVisible
		self.nextDotVisible = nextDotVisible
		self.rootClass = rootClass
		self.buttonsClass = buttonsClass
		self.headTailClass = headTailClass
		self.onPage = onPage
	}

	var body: some View {
		HStack(alignment: 'center', spacing: 24) {
			Button('<') { onPage(Math.max(min, current - 1)) }
				.className(['_button', '_buttonPrimary', 'mk-vune-paging-buttons__button'])
				.disabled(min === current)
				.withProps({ 'aria-label': i18n.ts.goBack })
			HStack(alignment: 'center', spacing: 8) {
				if (prevDotVisible) {
					HStack(alignment: 'center', spacing: 8) {
						Button(String(min)) { onPage(min) }.className(['_button', 'mk-vune-paging-buttons__button'])
						Text('').className(['ti ti-dots', 'mk-vune-paging-buttons__dots']).withProps({ 'aria-hidden': true })
					}
						.className(['mk-vune-paging-buttons__head-tail', headTailClass])
				}
				ForEach(buttonRanges, key: page => page) { page in
					Button(String(page)) { onPage(page) }
						.className(['_button', 'mk-vune-paging-buttons__button'])
						.disabled(current === page)
						.withProps({ 'aria-current': current === page ? 'page' : undefined })
				}
				if (nextDotVisible) {
					HStack(alignment: 'center', spacing: 8) {
						Text('').className(['ti ti-dots', 'mk-vune-paging-buttons__dots']).withProps({ 'aria-hidden': true })
						Button(String(max)) { onPage(max) }.className(['_button', 'mk-vune-paging-buttons__button'])
					}
						.className(['mk-vune-paging-buttons__head-tail', headTailClass])
				}
			}
				.className(['mk-vune-paging-buttons__buttons', buttonsClass])
			Button('>') { onPage(Math.min(max, current + 1)) }
				.className(['_button', '_buttonPrimary', 'mk-vune-paging-buttons__button'])
				.disabled(max === current)
				.withProps({ 'aria-label': i18n.ts.next })
		}
			.className(['mk-vune-paging-buttons', rootClass])
	}
}

export default MkPagingButtons
