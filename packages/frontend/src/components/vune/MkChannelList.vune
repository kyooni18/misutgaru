/* @misutgaru-vune-native */
import { ForEach, Group } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import type { IPaginator } from '@/utility/paginator.js';
import MkChannelPreview from '@/components/vune/MkChannelPreview.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import { i18n } from '@/i18n.js';

type Props = { paginator: IPaginator };
function channels(paginator: IPaginator): Misskey.entities.Channel[] { return paginator.items.value as Misskey.entities.Channel[]; }

export struct MkChannelList: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		return MkPagination(props.paginator, empty: MkResult('empty')) {
			Group() {
				ForEach(channels(props.paginator), key: channel => channel.id) { channel in MkChannelPreview(channel) }
			}.className('_gaps')
		}
	}
}
export default MkChannelList
