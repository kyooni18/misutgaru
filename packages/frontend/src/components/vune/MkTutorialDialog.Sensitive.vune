import { VStack, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkFolder from '@/components/vune/MkFolder.vune';
import MkInfo from '@/components/vune/MkInfo.vune';
import MkNote from '@/components/vune/MkNote.vune';
import MkPostForm from '@/components/vune/MkPostForm.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
import '@/vune/phase6-migration.scss';

type Props = {
	exampleNote: Misskey.entities.Note;
	onceSucceeded?: boolean;
	onFileChangeSensitive?: (fileId: string, to: boolean) => void;
};



export struct VuneMkTutorialDialogSensitiveView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			Text(i18n.ts._initialTutorial._howToMakeAttachmentsSensitive.description).multilineTextAlignment('center').padding({ horizontal: 16 })
			Text(i18n.ts._initialTutorial._howToMakeAttachmentsSensitive.tryThisFile)
			MkInfo() { Text(i18n.ts._initialTutorial._howToMakeAttachmentsSensitive.method) }
			MkPostForm(mock: true, autofocus: false, className: 'mk-vune-tutorial-sensitive-example')
			if (props.onceSucceeded === true) {
				VStack(alignment: 'stretch', spacing: 0) { Group() { VuneIcon('ti ti-check'); Text(` ${i18n.ts._initialTutorial.wellDone}`).bold() }.foregroundStyle('var(--MI_THEME-accent)'); Text(` ${i18n.ts._initialTutorial._howToMakeAttachmentsSensitive.sensitiveSucceeded}`) }
			}
			MkFolder(header: Text(i18n.ts.previewNoteText)) { MkNote(props.exampleNote, className: 'mk-vune-tutorial-sensitive-example') }
		}.className('_gaps')
	}
}

export default VuneMkTutorialDialogSensitiveView
