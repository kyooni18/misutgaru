/* @misutgaru-vune-native */
import { VStack, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkMfm from '@/components/global/vune/MkMfm.vune';
import MkA from '@/components/global/vune/MkA.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkTimeValue from '@/components/global/vune/MkTimeValue.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import number from '@/filters/number.js';
import { $i as currentUser } from '@/i.js';
import { i18n } from '@/i18n.js';
import '@/vune/phase6-migration.scss';

type Props = { clip: Misskey.entities.Clip; noUserInfo?: boolean };

function clipRemaining(clip: Misskey.entities.Clip): string | number {
	return (currentUser?.policies && clip.notesCount != null) ? (currentUser.policies.noteEachClipsLimit - clip.notesCount) : i18n.ts.unknown;
}

struct ClipPreviewBody: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
		Text(props.clip.name).bold()
		VStack(alignment: 'leading', spacing: 0) {
			if (props.clip.description) { MkMfm({ text: props.clip.description, plain: true, nowrap: true }) }
			if (props.clip.lastClippedAt) { VStack(alignment: 'leading', spacing: 0) { Text(`${i18n.ts.updatedAt}: `); MkTimeValue(props.clip.lastClippedAt, mode: 'detail') } }
			if (props.clip.notesCount != null) { Text(`${i18n.ts.notesCount}: ${number(props.clip.notesCount)} / ${currentUser?.policies.noteEachClipsLimit} (${i18n.tsx.remainingN({ n: clipRemaining(props.clip) })})`) }
		}.className('mk-vune-clip-preview__description')
		if (!props.noUserInfo) {
			Group() {
				VStack(alignment: 'leading', spacing: 0).className('mk-vune-clip-preview__divider')
				VStack(alignment: 'leading', spacing: 0) {
					MkAvatar(props.clip.user, indicator: true, link: true, preview: true, className: 'mk-vune-clip-preview__avatar')
					MkUserName({ user: props.clip.user, nowrap: false })
				}
			}
		}
	}.className('_panel _gaps_s mk-vune-clip-preview')
	}
}

export struct MkClipPreview: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		MkA(`/clips/${props.clip.id}`, className: 'mk-vune-clip-preview-link') { ClipPreviewBody(props) }
	}
}

export default MkClipPreview
