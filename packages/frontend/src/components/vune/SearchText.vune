import { Group, type ViewGraphValue } from 'vune-ui';

export struct SearchText: View {
	let content: ViewGraphValue

	init(@ViewBuilder content: () => ViewGraphValue) {
		self.content = content()
	}

	var body: some View {
		Group() { content }
	}
}

export default SearchText
