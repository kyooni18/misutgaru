/* @misutgaru-vune-native */
import { svgElement } from '@/vune/native.js';

export struct MkMiniChart: View {
	let viewBoxX: number
	let viewBoxY: number
	let gradientId: string
	let color: string
	let polygonPoints: string
	let polylinePoints: string
	let headX: number | null | undefined
	let headY: number | null | undefined
	let className: string | undefined

	init(
		viewBoxX: number,
		viewBoxY: number,
		gradientId: string,
		color: string,
		polygonPoints: string,
		polylinePoints: string,
		headX: number | null | undefined = undefined,
		headY: number | null | undefined = undefined,
		className: string | undefined = undefined,
	) {
		self.viewBoxX = viewBoxX
		self.viewBoxY = viewBoxY
		self.gradientId = gradientId
		self.color = color
		self.polygonPoints = polygonPoints
		self.polylinePoints = polylinePoints
		self.headX = headX
		self.headY = headY
		self.className = className
	}

	var body: some View {
		svgElement('svg',
			{
				className,
				// A viewBox-only SVG has an auto-sized intrinsic box. Keep the
				// mini chart compact even when a legacy parent's `.chart` rule
				// is not loaded across the Vune compatibility boundary.
				style: { height: '30px', overflow: 'visible' },
				viewBox: `0 0 ${viewBoxX} ${viewBoxY}`,
			},
			svgElement('defs',
				null,
				svgElement('linearGradient',
					{ id: gradientId, x1: '0', x2: '0', y1: '1', y2: '0' },
					svgElement('stop', { offset: '0%', 'stop-color': color, 'stop-opacity': '0' }),
					svgElement('stop', { offset: '100%', 'stop-color': color, 'stop-opacity': '0.65' }),
				),
			),
			svgElement('polygon', { points: polygonPoints, style: `stroke: none; fill: url(#${gradientId});` }),
			svgElement('polyline', { points: polylinePoints, fill: 'none', stroke: color, 'stroke-width': '2' }),
			svgElement('circle', { cx: headX ?? undefined, cy: headY ?? undefined, r: '3', fill: color }),
		)
	}
}

export default MkMiniChart
