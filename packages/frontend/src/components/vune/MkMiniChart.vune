/* @misutgaru-vune-native */
import { Canvas } from '@vune-ui/core/web-primitives';

function parsePoints(value: string): Array<[number, number]> {
	return value.trim().split(/\s+/).flatMap(pair => {
		const [x, y] = pair.split(',').map(Number);
		return Number.isFinite(x) && Number.isFinite(y) ? [[x, y] as [number, number]] : [];
	});
}

function chartRef(viewBoxX: number, viewBoxY: number, color: string, polygonPoints: string, polylinePoints: string, headX: number | null | undefined, headY: number | null | undefined) {
	return (value: unknown) => {
		if (!(value instanceof HTMLCanvasElement)) return;
		const context = value.getContext('2d');
		if (!context) return;
		context.clearRect(0, 0, viewBoxX, viewBoxY);
		const polygon = parsePoints(polygonPoints);
		if (polygon.length > 1) {
			const gradient = context.createLinearGradient(0, viewBoxY, 0, 0);
			gradient.addColorStop(0, 'transparent');
			gradient.addColorStop(1, color);
			context.globalAlpha = 0.65;
			context.fillStyle = gradient;
			context.beginPath();
			polygon.forEach(([x, y], index) => index === 0 ? context.moveTo(x, y) : context.lineTo(x, y));
			context.closePath();
			context.fill();
			context.globalAlpha = 1;
		}
		const line = parsePoints(polylinePoints);
		if (line.length > 1) {
			context.strokeStyle = color;
			context.lineWidth = 2;
			context.beginPath();
			line.forEach(([x, y], index) => index === 0 ? context.moveTo(x, y) : context.lineTo(x, y));
			context.stroke();
		}
		if (headX != null && headY != null) {
			context.fillStyle = color;
			context.beginPath();
			context.arc(headX, headY, 3, 0, Math.PI * 2);
			context.fill();
		}
	};
}

export struct MkMiniChart: View {
	let viewBoxX: number
	let viewBoxY: number
	let gradientId: string
	let color: string
	let polygonPoints: string
	let polylinePoints: string
	let headX: number | null | undefined
	let headY: number | null | undefined
	let className: string | undefined

	init(
		viewBoxX: number,
		viewBoxY: number,
		gradientId: string,
		color: string,
		polygonPoints: string,
		polylinePoints: string,
		headX: number | null | undefined = undefined,
		headY: number | null | undefined = undefined,
		className: string | undefined = undefined,
	) {
		self.viewBoxX = viewBoxX
		self.viewBoxY = viewBoxY
		self.gradientId = gradientId
		self.color = color
		self.polygonPoints = polygonPoints
		self.polylinePoints = polylinePoints
		self.headX = headX
		self.headY = headY
		self.className = className
	}

	var body: some View {
		Canvas(viewBoxX, viewBoxY, chartRef(viewBoxX, viewBoxY, color, polygonPoints, polylinePoints, headX, headY))
			.className(className ?? '')
			.style({ height: '30px', overflow: 'visible' })
			.withProps({ 'data-gradient-id': gradientId })
	}
}

export default MkMiniChart
