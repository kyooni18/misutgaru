import { Canvas } from '@vune-ui/core/web-primitives';

type Vars = Record<'bg'|'panel'|'fg'|'mention'|'hashtag'|'link'|'divider'|'accent'|'accentedBg'|'navBg'|'pageHeaderBg'|'success'|'warn'|'error', string>;

function previewRef(theme: Vars) {
	return (value: unknown) => {
		if (!(value instanceof HTMLCanvasElement)) return;
		const context = value.getContext('2d');
		if (!context) return;
		context.clearRect(0, 0, 200, 150);
		context.fillStyle = theme.bg; context.fillRect(0, 0, 200, 150);
		context.fillStyle = theme.navBg; context.fillRect(0, 0, 64, 150);
		context.fillStyle = theme.pageHeaderBg; context.fillRect(64, 0, 136, 41);
		context.fillStyle = theme.panel; context.fillRect(96, 65, 104, 85);
		context.fillStyle = theme.accentedBg; context.beginPath(); context.arc(32, 83, 21, 0, Math.PI * 2); context.fill();
		const bar = (x: number, y: number, width: number, color: string) => { context.fillStyle = color; context.fillRect(x, y, width, 6); };
		bar(120, 88, 40, theme.fg); bar(170, 88, 20, theme.mention); bar(120, 108, 20, theme.hashtag); bar(150, 108, 40, theme.fg); bar(120, 128, 40, theme.fg); bar(170, 128, 20, theme.link);
		context.strokeStyle = theme.divider; context.lineWidth = 0.75; context.beginPath(); context.moveTo(65, 41); context.lineTo(200, 41); context.stroke();
		for (const [x, color] of [[140, theme.success], [160, theme.warn], [180, theme.error]] as const) { context.fillStyle = color; context.beginPath(); context.arc(x, 20, 6, 0, Math.PI * 2); context.fill(); }
		context.fillStyle = theme.accent; context.beginPath(); context.arc(32, 32, 16, 0, Math.PI * 2); context.fill();
	};
}

export struct MkThemePreview: View {
	let themeVariables: Vars

	init(_ themeVariables: Vars) {
		self.themeVariables = themeVariables
	}

	var body: some View {
		Canvas(200, 150, previewRef(themeVariables))
	}
}

export default MkThemePreview
