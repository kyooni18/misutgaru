import { VStack, type ViewGraphValue } from 'vune-ui';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import './MkPreviewWithControls.scss';

export struct MkPreviewWithControls: View {
	let previewLoading: boolean
	let animation: boolean
	let preview: ViewGraphValue
	let controls: ViewGraphValue

	init(
		previewLoading: boolean = false,
		animation: boolean = false,
		preview: ViewGraphValue,
		controls: ViewGraphValue,
	) {
		self.previewLoading = previewLoading
		self.animation = animation
		self.preview = preview
		self.controls = controls
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) {
					VStack(alignment: 'stretch', spacing: 0) { preview }.className('mk-vune-preview-controls__preview-content')
					if (previewLoading) { VStack(alignment: 'stretch', spacing: 0) { MkLoading() }.className('mk-vune-preview-controls__loading') }
				}.className(['mk-vune-preview-controls__preview', animation ? 'mk-vune-preview-controls__preview--animated' : null])
				VStack(alignment: 'stretch', spacing: 0) { controls }.className('mk-vune-preview-controls__controls')
			}.className('mk-vune-preview-controls__container')
		}.className('mk-vune-preview-controls')
	}
}

export default MkPreviewWithControls
