/* @misutgaru-vune-native */
import { VStack, ForEach, Image, Text, type StateRef } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import { misskeyApi } from '@/utility/misskey-api.js';
import MkLoading from '@/components/global/vune/MkLoading.vune';

function loadDrive(files: StateRef<Misskey.entities.DriveFile[] | null>, folderId: string | null) {
	return (element: HTMLElement | null) => {
		if (!element || files.value != null) return;
		void misskeyApi('drive/files', { folderId, limit: 100 }).then(result => { files.value = result; });
	};
}

export struct MkDrive: View {
	let initialFolder: Misskey.entities.DriveFolder | null
	@State var files: Misskey.entities.DriveFile[] | null = null
	init(initialFolder: Misskey.entities.DriveFolder | null = null) { self.initialFolder = initialFolder }
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			if (files.value == null) { MkLoading() }
			else {
				ForEach(files.value, key: file => file.id) { file in
					VStack(alignment: 'stretch', spacing: 0) {
						if (file.thumbnailUrl) { Image(file.thumbnailUrl, { alt: file.name }).className('mk-vune-drive__thumb') }
						Text(file.name).lineLimit(1)
					}.className('mk-vune-drive__file')
				}
			}
		}.className('mk-vune-drive').elementRef(loadDrive(files, initialFolder?.id ?? null))
	}
}

export default MkDrive
