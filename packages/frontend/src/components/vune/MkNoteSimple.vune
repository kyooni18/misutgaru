/* @misutgaru-vune-native */
import { VStack, Group, Text } from 'vune-ui';
import * as Misskey from 'misskey-js';
import MkMfm from '@/components/global/vune/MkMfm.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import MkTimeValue from '@/components/global/vune/MkTimeValue.vune';
import MkCwButton from '@/components/vune/MkCwButton.vune';
import MkNoteMediaGrid from '@/components/vune/MkNoteMediaGrid.vune';
import { i18n } from '@/i18n.js';

type Props = { note: Misskey.entities.Note | null; showContent?: boolean; showCwMedia?: boolean; useStickyIcons?: boolean; classes: Record<string, string>; onShowContent?: (value: boolean) => void };
function updateShowContent(props: Props, value: boolean): void { props.onShowContent?.(value); }

struct MkNoteSimpleContent: View {
	let note: Misskey.entities.Note
	let props: Props
	let showCwMedia: boolean

	init(_ note: Misskey.entities.Note, props: Props) {
		self.note = note
		self.props = props
		self.showCwMedia = props.showCwMedia === true && note.cw != null && props.showContent !== true
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			MkAvatar(note.user, link: true, preview: true, className: [props.classes.avatar, props.useStickyIcons ? props.classes.useSticky : null].filter(Boolean).join(' '))
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) {
					MkUserName({ user: note.user, nowrap: true })
					Text(' · ')
					MkTimeValue(note.createdAt)
				}.className(props.classes.header)
				VStack(alignment: 'stretch', spacing: 0) {
					if (note.cw != null) {
						VStack(alignment: 'stretch', spacing: 0) {
							if (note.cw !== '') { MkMfm({ text: note.cw, author: note.user, nyaize: 'respect', emojiUrls: note.emojis }) }
							MkCwButton(props.showContent ?? false, text: note.text, files: note.files, poll: note.poll, onChange: value => updateShowContent(props, value))
						}.className(props.classes.cw)
					}
					if (showCwMedia && note.files && note.files.length > 0) { MkNoteMediaGrid({ note, square: false }) }
					VStack(alignment: 'stretch', spacing: 0) {
						if (note.text) { MkMfm({ text: note.text, author: note.user, isNote: true, emojiUrls: note.emojis, nyaize: 'respect' }) }
						if (note.files && note.files.length > 0 && (!showCwMedia || props.showContent)) { MkNoteMediaGrid({ note, square: false }) }
					}.className(props.classes.text).style({ display: note.cw == null || props.showContent ? '' : 'none' })
				}
			}.className(props.classes.main)
		}.className(props.classes.root)
	}
}

export struct VuneMkNoteSimpleView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		Group() {
			if (props.note) { MkNoteSimpleContent(props.note, props: props) }
			else { Text(i18n.ts.deletedNote).className(props.classes.deleted) }
		}
	}
}

export default VuneMkNoteSimpleView
