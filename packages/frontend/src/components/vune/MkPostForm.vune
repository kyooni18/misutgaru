import { VStack, Binding, Button, Text, TextEditor } from 'vune-ui';
import { misskeyApi } from '@/utility/misskey-api.js';
import { i18n } from '@/i18n.js';

async function submitPost(text: any, mock: boolean): Promise<void> {
	const value = String(text.value ?? '').trim();
	if (!value || mock) return;
	await misskeyApi('notes/create', { text: value });
	text.value = '';
}

export struct MkPostForm: View {
	let mock: boolean
	let autofocus: boolean
	let className: string
	@State var text: string = ''

	init(mock: boolean = false, autofocus: boolean = false, className: string = '') {
		self.mock = mock; self.autofocus = autofocus; self.className = className
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			TextEditor(Binding(text), i18n.ts._postForm._placeholders.a, 4)
				.className('mk-vune-post-form__editor')
				.withProps({ autofocus })
			Button(i18n.ts.note) { void submitPost(text, mock) }
				.className('_buttonPrimary mk-vune-post-form__submit')
		}.className(['mk-vune-post-form', className])
	}
}

export default MkPostForm
