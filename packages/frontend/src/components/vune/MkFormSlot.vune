import { VStack, type ViewGraphValue } from 'vune-ui';
import './misskey-vune.scss';

export struct MkFormSlot: View {
	let label: ViewGraphValue
	let caption: ViewGraphValue
	let content: ViewGraphValue

	init(
		label: ViewGraphValue = null,
		caption: ViewGraphValue = null,
		@ViewBuilder content: () => ViewGraphValue,
	) {
		self.label = label
		self.caption = caption
		self.content = content()
	}

	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			VStack(alignment: 'leading', spacing: 0) { label }.className('mk-vune-form-slot__label')
			VStack(alignment: 'leading', spacing: 0) { content }
			VStack(alignment: 'leading', spacing: 0) { caption }.className('mk-vune-form-slot__caption')
		}
	}
}

export default MkFormSlot
