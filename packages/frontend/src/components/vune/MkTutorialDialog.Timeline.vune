/* @misutgaru-vune-native */
import { Divider, ForEach, Group, Image, Link, Text, VStack } from 'vune-ui';
import { i18n } from '@/i18n.js';
import { basicTimelineIconClass, basicTimelineTypes } from '@/timelines.js';
import VuneIcon from '@/vune/Icon.vune';
import '@/vune/phase5-migration.scss';

struct TimelineTutorialHelp: View {
	let before: string
	let after: string
	init() {
		const parts = i18n.ts._initialTutorial._timeline.description3.split('{link}')
		self.before = parts[0] ?? ''
		self.after = parts[1] ?? ''
	}
	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			Text(before)
			Link(i18n.ts.help, 'https://misskey-hub.net/docs/for-users/features/timeline/')
				.className('_link')
				.withProps({ target: '_blank', rel: 'noopener noreferrer' })
			Text(after)
		}.padding({ horizontal: 16 })
	}
}

export struct MkTutorialDialogTimeline: View {
	init() {}

	var body: some View {
		VStack(spacing: 0) {
			Text(i18n.ts._initialTutorial._timeline.description1).multilineTextAlignment('center').padding({ horizontal: 16 })
			VStack(alignment: 'stretch', spacing: 0) { Group() {
				ForEach(basicTimelineTypes, key: (timeline: string) => timeline) { timeline in
					VStack(alignment: 'stretch', spacing: 0) {
						VuneIcon(basicTimelineIconClass(timeline as any))
						Text(' ')
						Text((i18n.ts._timelines as any)[timeline]).bold()
						Text(' … ' + ((i18n.ts._initialTutorial._timeline as any)[timeline] ?? ''))
					}
				}
			} }.className('_gaps_s')
			VStack(alignment: 'stretch', spacing: 0) {
				Text(i18n.ts._initialTutorial._timeline.description2)
				Image('/client-assets/tutorial/timeline_tab.png', { alt: '' }).className('mk-vune-tutorial-image')
			}.className('_gaps_s')
			Divider().className('mk-vune-tutorial-divider')
			TimelineTutorialHelp()
		}
			.className('_gaps')
	}
}

export default MkTutorialDialogTimeline
