/* @misutgaru-vune-native */
import { VStack, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkMfm from '@/components/global/vune/MkMfm.vune';
import MkA from '@/components/global/vune/MkA.vune';
import MkAcct from '@/components/global/vune/MkAcct.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import MkFollowButton from '@/components/vune/MkFollowButton.vune';
import number from '@/filters/number.js';
import { userPage } from '@/filters/user.js';
import * as signIn from '@/i.js';
import { i18n } from '@/i18n.js';
import { prefer } from '@/preferences.js';
import { getStaticImageUrl } from '@/utility/media-proxy.js';
import { isFollowersVisibleForMe, isFollowingVisibleForMe } from '@/utility/isFfVisibleForMe.js';
import '@/vune/phase6-migration.scss';

type Props = { user: Misskey.entities.UserDetailed };

struct UserInfoStatusItem: View {
	let user: Misskey.entities.UserDetailed
	let label: string
	let value: number
	let path: string
	var body: some View {
		MkA(userPage(user, path), className: 'mk-vune-user-info__status-item') {
			Group() {
				Text(label).className('mk-vune-user-info__status-label')
				Text(number(value)).className('mk-vune-user-info__status-value')
			}
		}
	}
}

export struct MkUserInfo: View {
	let props: Props
	let bannerUrl: string | undefined
	init(_ props: Props) {
		self.props = props
		self.bannerUrl = props.user.bannerUrl ? (prefer.s.disableShowingAnimatedImages ? getStaticImageUrl(props.user.bannerUrl) : props.user.bannerUrl) : undefined
	}
	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			VStack(alignment: 'leading', spacing: 0).className('mk-vune-user-info__banner').style({ backgroundImage: bannerUrl ? `url(${bannerUrl})` : undefined })
			MkA(userPage(props.user)) { MkAvatar(props.user, indicator: true, className: 'mk-vune-user-info__avatar') }
			VStack(alignment: 'leading', spacing: 0) {
				MkA(userPage(props.user), className: 'mk-vune-user-info__name') { MkUserName({ user: props.user, nowrap: false }) }
				VStack(alignment: 'leading', spacing: 0) { MkAcct(props.user) }.className('mk-vune-user-info__username')
			}.className('mk-vune-user-info__title')
			if (signIn.$i && signIn.$i.id !== props.user.id && props.user.isFollowed) { Text(i18n.ts.followsYou).className('mk-vune-user-info__followed') }
			VStack(alignment: 'leading', spacing: 0) {
				if (props.user.description) { VStack(alignment: 'leading', spacing: 0) { MkMfm({ text: props.user.description, author: props.user }) }.className('mk-vune-user-info__mfm') }
				else { Text(i18n.ts.noAccountDescription).opacity(0.7) }
			}.className('mk-vune-user-info__description')
			VStack(alignment: 'leading', spacing: 0) {
				UserInfoStatusItem(user: props.user, label: i18n.ts.notes, value: props.user.notesCount, path: 'notes')
				if (isFollowingVisibleForMe(props.user)) { UserInfoStatusItem(user: props.user, label: i18n.ts.following, value: props.user.followingCount, path: 'following') }
				if (isFollowersVisibleForMe(props.user)) { UserInfoStatusItem(user: props.user, label: i18n.ts.followers, value: props.user.followersCount, path: 'followers') }
			}.className('mk-vune-user-info__status')
			if (props.user.id !== signIn.$i?.id) { MkFollowButton({ user: props.user, className: 'mk-vune-user-info__follow' }) }
		}.className('_panel mk-vune-user-info')
	}
}
export default MkUserInfo
