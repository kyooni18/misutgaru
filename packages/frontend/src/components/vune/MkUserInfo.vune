import { Element, Group } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import Mfm from '@/components/global/MkMfm.js';
import MkA from '@/components/global/MkA.vue';
import MkAcct from '@/components/global/MkAcct.vue';
import MkAvatar from '@/components/global/MkAvatar.vue';
import MkUserName from '@/components/global/MkUserName.vue';
import MkFollowButton from '@/components/MkFollowButton.vue';
import number from '@/filters/number.js';
import { userPage } from '@/filters/user.js';
import * as signIn from '@/i.js';
import { i18n } from '@/i18n.js';
import { prefer } from '@/preferences.js';
import { getStaticImageUrl } from '@/utility/media-proxy.js';
import { isFollowersVisibleForMe, isFollowingVisibleForMe } from '@/utility/isFfVisibleForMe.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';
import '@/vune/phase6-migration.scss';

type Props = { user: Misskey.entities.UserDetailed };

function statusItem(user: Misskey.entities.UserDetailed, label: string, value: number, path: string) {
	return VueComponent(MkA, {
		class: 'mk-vune-user-info__status-item',
		to: userPage(user, path),
	}, {
		default: () => Group() {
			Element('p', { className: 'mk-vune-user-info__status-label' }, label)
			Element('span', { className: 'mk-vune-user-info__status-value' }, number(value))
		},
	});
}

export default createVuneComponent<Props>((props) => {
	const user = props.user;
	const bannerUrl = user.bannerUrl
		? (prefer.s.disableShowingAnimatedImages ? getStaticImageUrl(user.bannerUrl) : user.bannerUrl)
		: undefined;

	return Element('div', { className: '_panel mk-vune-user-info' },
		Element('div', {
			className: 'mk-vune-user-info__banner',
			style: { backgroundImage: bannerUrl ? `url(${bannerUrl})` : undefined },
		}),
		VueComponent(MkA, { to: userPage(user) }, {
			default: () => VueComponent(MkAvatar, {
				class: 'mk-vune-user-info__avatar',
				user,
				indicator: true,
			}),
		}),
		Element('div', { className: 'mk-vune-user-info__title' },
			VueComponent(MkA, { class: 'mk-vune-user-info__name', to: userPage(user) }, {
				default: () => VueComponent(MkUserName, { user, nowrap: false }),
			}),
			Element('p', { className: 'mk-vune-user-info__username' }, VueComponent(MkAcct, { user })),
		),
		(signIn.$i && signIn.$i.id !== user.id && user.isFollowed)
			? Element('span', { className: 'mk-vune-user-info__followed' }, i18n.ts.followsYou)
			: null,
		Element('div', { className: 'mk-vune-user-info__description' },
			user.description
				? Element('div', { className: 'mk-vune-user-info__mfm' }, VueComponent(Mfm as any, { text: user.description, author: user }))
				: Element('span', { style: { opacity: .7 } }, i18n.ts.noAccountDescription),
		),
		Element('div', { className: 'mk-vune-user-info__status' },
			statusItem(user, i18n.ts.notes, user.notesCount, 'notes'),
			isFollowingVisibleForMe(user) ? statusItem(user, i18n.ts.following, user.followingCount, 'following') : null,
			isFollowersVisibleForMe(user) ? statusItem(user, i18n.ts.followers, user.followersCount, 'followers') : null,
		),
		user.id !== signIn.$i?.id
			? VueComponent(MkFollowButton, { class: 'mk-vune-user-info__follow', user, mini: true })
			: null,
	);
});
