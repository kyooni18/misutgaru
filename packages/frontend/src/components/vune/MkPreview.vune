/* @misutgaru-vune-native */
import { VStack, Binding, Group, Text } from 'vune-ui';
import * as config from '@@/js/config.js';
import MkInput from './MkInput.vune';
import MkSwitch from './MkSwitch.vune';
import MkButton from './MkButton.vune';
import MkMfm from '@/components/global/vune/MkMfm.vune';
import * as os from '@/os.js';
import { $i as currentUser } from '@/i.js';
import { chooseDriveFile } from '@/utility/drive.js';

function previewMfm(): string {
	return `Hello world! This is an @example mention. BTW you are @${currentUser ? currentUser.username : 'guest'}.\nAlso, here is ${config.url} and [example link](${config.url}). for more details, see https://example.com.\nAs you know #misskey is open-source software.`;
}

function openPreviewMenu(event: PointerEvent): void {
	os.popupMenu([
		{ type: 'label', text: 'Fruits' },
		{ text: 'Create some apples', action: () => {} },
		{ text: 'Read some oranges', action: () => {} },
		{ text: 'Update some melons', action: () => {} },
		{ text: 'Delete some bananas', danger: true, action: () => {} },
	], event.currentTarget ?? event.target);
}

export struct MkPreview: View {
	@State var text: string = ''
	@State var flag: boolean = true
	init() {}
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			MkInput(text.value, onChange: { value in text.value = String(value ?? '') }, label: Text('Text'))
			MkSwitch(flag.value, onChange: { value in flag.value = value }, label: Text(`Switch is now ${flag.value ? 'on' : 'off'}`))
			VStack(alignment: 'stretch', spacing: 0) {
				MkButton(inline: true) { Text('This is') }
				MkButton(inline: true, primary: true) { Text('the button') }
			}.className('mk-vune-preview__buttons')
			VStack(alignment: 'stretch', spacing: 0) { MkMfm({ text: previewMfm() }) }.className('mk-vune-preview__mfm').allowsHitTesting(false)
			VStack(alignment: 'stretch', spacing: 0) {
				MkButton(inline: true, primary: true, onClick: { event in openPreviewMenu(event) }) { Text('Open menu') }
				MkButton(inline: true, primary: true, onClick: { void os.alert({ type: 'warning', title: 'Oh my Aichan', text: 'Lorem ipsum dolor sit amet.' }) }) { Text('Open dialog') }
				MkButton(inline: true, primary: true, onClick: { void os.form('Example form', { foo: { type: 'boolean', default: true, label: 'Boolean' } }) }) { Text('Open form') }
				MkButton(inline: true, primary: true, onClick: { void chooseDriveFile({ multiple: false }) }) { Text('Open drive') }
			}.className('mk-vune-preview__actions')
		}.className('mk-vune-preview').padding(16)
	}
}

export default MkPreview
