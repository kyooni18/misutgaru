/* @misutgaru-vune-native */
import { ForEach, Group } from 'vune-ui';
export struct MkDraggable: View {
	let items: any[]
	let content: (item: any, index: number) => any
	init(_ items: any[], @ViewBuilder content: (item: any, index: number) => any) { self.items = items; self.content = content }
	var body: some View { Group() { ForEach(items, key: (item, index) => item?.id ?? index) { item, index in content(item, index) } } }
}
export default MkDraggable
