import { VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkA from '@/components/global/vune/MkA.vune';
import MkRolePreviewBody from '@/components/vune/MkRolePreviewBody.vune';
import VuneIcon from '@/vune/Icon.vune';
import { adaptiveBgRef } from '@/vune/adaptive-bg.js';
import './MkRolePreview.scss';

type Role = Misskey.entities.Role | Misskey.entities.IResponse['roles'][number];

const roleClasses = {
	bodyTitle: 'mk-vune-role-preview__body-title',
	bodyIcon: 'mk-vune-role-preview__body-icon',
	bodyBadge: 'mk-vune-role-preview__body-badge',
	bodyName: 'mk-vune-role-preview__body-name',
	bodyUsers: 'mk-vune-role-preview__body-users',
	bodyDescription: 'mk-vune-role-preview__body-description',
};

export struct MkRolePreview: View {
	let role: Role
	let forModeration: boolean
	let detailed: boolean

	init(_ role: Role, forModeration: boolean, detailed: boolean = true) {
		self.role = role
		self.forModeration = forModeration
		self.detailed = detailed
	}

	var body: some View {
		MkA(forModeration ? `/admin/roles/${role.id}` : `/roles/${role.id}`, className: 'mk-vune-role-preview') {
			if (forModeration) {
				VuneIcon('isPublic' in role && role.isPublic ? 'ti ti-world' : 'ti ti-lock', className: 'mk-vune-role-preview__icon')
					.foregroundStyle('isPublic' in role && role.isPublic ? 'var(--MI_THEME-success)' : 'var(--MI_THEME-warn)')
			}
			VStack(alignment: 'stretch', spacing: 0) { MkRolePreviewBody(role, detailed: detailed, classes: roleClasses) }
				.className(['_panel', 'mk-vune-role-preview__body'])
				.elementRef(adaptiveBgRef)
		}
			.style({ '--color': role.color })
			.withProps({ tabindex: -1 })
	}
}

export default MkRolePreview
