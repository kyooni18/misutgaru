import { Button, Text, VStack } from 'vune-ui';
import { i18n } from '@/i18n.js';
import '@/vune/phase6-migration.scss';

type SelectAction = () => void;
function ignoreSelect(): void {}

export struct MkFormFile: View {
	let fileName: string
	let friendlyFileName: string
	let onSelect: SelectAction

	init(_ fileName: string, friendlyFileName: string, @Action onSelect: SelectAction = ignoreSelect) {
		self.fileName = fileName
		self.friendlyFileName = friendlyFileName
		self.onSelect = onSelect
	}

	var body: some View {
		VStack(alignment: 'leading', spacing: 8) {
			Button(i18n.ts.selectFile) { onSelect() }
				.className(['_button', '_buttonPrimary', 'mk-vune-form-file__select'])
			Text(friendlyFileName)
				.className(['_nowrap', !fileName ? 'mk-vune-form-file__missing' : null])
		}
	}
}

export default MkFormFile
