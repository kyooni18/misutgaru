import { Group, Image, Text } from 'vune-ui';
import { colorizeEmoji } from '@@/js/emojilist.js';
import { char2fluentEmojiFilePath, char2twemojiFilePath } from '@@/js/emoji-base.js';
import { getCustomEmojiImagePath, normalizeCustomEmojiName } from '@@/js/emoji-name.js';
import { customEmojisMap } from '@/custom-emojis.js';
import { prefer } from '@/preferences.js';
import { getProxiedImageUrl, getStaticImageUrl } from '@/utility/media-proxy.js';
import './MkReactionIcon.scss';

type ElementRefAction = (element: unknown) => void;

const compactReactionImageStyle = Object.freeze({
	height: '1.1em',
	verticalAlign: '-0.18em',
	WebkitUserDrag: 'none',
});

function ignoreElementRef(_element: unknown): void {}

function isMutedReaction(reaction: string): boolean {
	const key = reaction.startsWith(':')
		? `:${normalizeCustomEmojiName(reaction)}:`
		: reaction;
	return prefer.r.mutingEmojis.value.includes(key);
}

function customEmojiUrl(reaction: string, explicitUrl?: string): string {
	if (isMutedReaction(reaction)) return '/client-assets/unknown.png';
	const normalized = normalizeCustomEmojiName(reaction);
	const rawUrl = explicitUrl
		?? (!normalized.includes('@') ? customEmojisMap.get(normalized)?.url : undefined)
		?? getCustomEmojiImagePath(normalized, null);
	const proxied = rawUrl.startsWith('/emoji/')
		? `${rawUrl}${rawUrl.includes('?') ? '&' : '?'}fallback=1`
		: getProxiedImageUrl(rawUrl, 'emoji', false, true);
	return prefer.s.disableShowingAnimatedImages ? getStaticImageUrl(proxied) : proxied;
}

function unicodeEmojiUrl(reaction: string): string | null {
	if (isMutedReaction(reaction)) return '/client-assets/unknown.png';
	if (prefer.s.emojiStyle === 'native') return null;
	return (prefer.s.emojiStyle === 'twemoji' ? char2twemojiFilePath : char2fluentEmojiFilePath)(reaction);
}

function reactionImageError(event: Event): void {
	const target = event.currentTarget as HTMLImageElement | null;
	if (target && !target.src.endsWith('/client-assets/dummy.png')) target.src = '/client-assets/dummy.png';
}

export struct MkReactionIcon: View {
	let reaction: string
	let noStyle: boolean
	let emojiUrl: string | undefined
	let className: string
	let onRef: ElementRefAction
	let classes: Array<string | null>
	let unicodeImageUrl: string | null

	init(
		_ reaction: string,
		noStyle: boolean = false,
		emojiUrl: string | undefined = undefined,
		className: string = '',
		@Action onRef: ElementRefAction = ignoreElementRef,
	) {
		self.reaction = reaction
		self.noStyle = noStyle
		self.emojiUrl = emojiUrl
		self.className = className
		self.onRef = onRef
		self.classes = ['mk-vune-reaction-icon', noStyle ? 'mk-vune-reaction-icon--no-style' : null, className]
		self.unicodeImageUrl = unicodeEmojiUrl(reaction)
	}

	var body: some View {
		Group() {
			if (reaction.startsWith(':')) {
				Image(customEmojiUrl(reaction, emojiUrl), { alt: reaction })
					.className(classes)
					.style(noStyle ? {} : compactReactionImageStyle)
					.elementRef(onRef)
					.withProps({ title: reaction.replace(/^:|:$/g, ''), decoding: 'async', draggable: false, onError: reactionImageError })
			} else if (unicodeImageUrl) {
				Image(unicodeImageUrl, { alt: reaction })
					.className(classes)
					.style(noStyle ? {} : compactReactionImageStyle)
					.elementRef(onRef)
					.withProps({ decoding: 'async', draggable: false })
			} else {
				Text(colorizeEmoji(reaction))
					.className(['mk-vune-reaction-icon', 'mk-vune-reaction-icon--text', noStyle ? 'mk-vune-reaction-icon--no-style' : null, className])
					.withProps({ ref: onRef, 'aria-label': reaction })
			}
		}
	}
}

export default MkReactionIcon
