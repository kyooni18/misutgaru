import { Image } from 'vune-ui';
export struct MkMediaImage: View {
	let image: any
	let cover: boolean
	init(_ image: any, cover: boolean = false) { self.image = image; self.cover = cover }
	var body: some View { Image(image?.thumbnailUrl ?? image?.url ?? '', { alt: image?.name ?? '' }).withProps({ loading: 'eager', fetchpriority: 'high', decoding: 'sync' }).style({ width: '100%', height: '100%', objectFit: cover ? 'cover' : 'contain' }) }
}
export default MkMediaImage
