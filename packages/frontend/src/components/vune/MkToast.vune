import { Text, VStack } from 'vune-ui';
import MaterialSurface from '@/vune/MaterialSurface.vune';
import { Material } from '@/vune/material.js';
import './MkToast.scss';

export struct MkToast: View {
	let message: string
	let zIndex: number

	init(_ message: string, zIndex: number) {
		self.message = message
		self.zIndex = zIndex
	}

	var body: some View {
		MaterialSurface(Material.thin, opaqueBackground: 'var(--MI_THEME-bg)', animated: true) {
			VStack(alignment: 'center', spacing: 0) {
				Text(message).className('mk-vune-toast__message')
			}
		}
			.className('mk-vune-toast')
			.style({ zIndex, borderRadius: 'var(--MI-radius)' })
	}
}

export default MkToast
