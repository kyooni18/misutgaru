import { Text } from 'vune-ui';
import number from '@/filters/number.js';

export struct MkNumber: View {
	let value: number

	init(_ value: number) {
		self.value = value
	}

	var body: some View {
		Text(String(number(Math.floor(value))))
	}
}

export default MkNumber
