/* @misutgaru-vune-native */
import { VStack, Animation, State, Text, type StateRef, type ViewGraphValue } from 'vune-ui';
import { isLink } from '@@/js/is-link.js';
import type { IPaginator } from '@/utility/paginator.js';
import MkButton from '@/components/vune/MkButton.vune';
import MkError from '@/components/vune/MkError.vune';
import MkInput from '@/components/vune/MkInput.vune';
import MkSelect from '@/components/vune/MkSelect.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import VuneIcon from '@/vune/Icon.vune';
import { formatDateTimeString } from '@/utility/format-time-string.js';
import { i18n } from '@/i18n.js';
import { prefer } from '@/preferences.js';
import * as os from '@/os.js';
import './MkPagination.scss';

type Direction = 'up' | 'down' | 'both';
type ControlState = { searchOpened: StateRef<boolean> };

const initialized = new WeakSet<object>();
const paramsSnapshots = new WeakMap<object, string>();
const controlStates = new WeakMap<object, ControlState>();

function controlsFor(paginator: IPaginator): ControlState {
	let state = controlStates.get(paginator as object);
	if (!state) {
		state = { searchOpened: State(false) };
		controlStates.set(paginator as object, state);
	}
	return state;
}

function syncComputedParams(paginator: IPaginator): void {
	if (!paginator.computedParams) return;
	let next = '';
	try { next = JSON.stringify(paginator.computedParams.value ?? null); } catch { next = String(paginator.computedParams.value); }
	const previous = paramsSnapshots.get(paginator as object);
	paramsSnapshots.set(paginator as object, next);
	if (previous !== undefined && previous !== next) queueMicrotask(() => { void paginator.reload(); });
}

function rootRef(paginator: IPaginator, autoLoad: boolean) {
	return (element: HTMLElement | null) => {
		if (element == null || !autoLoad || initialized.has(paginator as object)) return;
		initialized.add(paginator as object);
		queueMicrotask(() => { void paginator.init(); });
	};
}

function appearRef(enabled: boolean, action: () => void) {
	let observer: IntersectionObserver | null = null;
	return (element: HTMLElement | null) => {
		observer?.disconnect();
		observer = null;
		if (!enabled || element == null || typeof IntersectionObserver === 'undefined') return;
		observer = new IntersectionObserver(entries => {
			if (!entries.some(entry => entry.isIntersecting)) return;
			observer?.disconnect();
			observer = null;
			action();
		}, { rootMargin: '320px 0px' });
		observer.observe(element);
	};
}

function onContextMenu(paginator: IPaginator, event: PointerEvent): void {
	if (event.target && isLink(event.target as HTMLElement)) return;
	if (window.getSelection()?.toString() !== '') return;
	event.preventDefault();
	event.stopPropagation();
	os.contextMenu([{
		icon: 'ti ti-refresh',
		text: i18n.ts.reload,
		action: () => { void paginator.reload(); },
	}], event);
}

function changeOrder(paginator: IPaginator, value: unknown): void {
	const order = value === 'oldest' ? 'oldest' : 'newest';
	paginator.order.value = order;
	paginator.initialDirection = order === 'oldest' ? 'newer' : 'older';
	void paginator.reload();
}

function changeSearch(paginator: IPaginator, value: string | number | null): void {
	paginator.searchQuery.value = value == null ? null : String(value);
	void paginator.reload();
}

function changeDate(paginator: IPaginator, value: string | number | null): void {
	const next = value == null ? null : new Date(String(value)).getTime();
	paginator.initialDate = next != null && Number.isFinite(next) ? next : null;
	void paginator.reload();
}

function orderControl(paginator: IPaginator): ViewGraphValue {
	return MkSelect(paginator.order.value, items: [
		{ label: i18n.ts._order.newest, value: 'newest' },
		{ label: i18n.ts._order.oldest, value: 'oldest' },
	], className: 'mk-vune-pagination__order', onChange: { value in changeOrder(paginator, value) });
}

function paginationControl(paginator: IPaginator): ViewGraphValue {
	const state = controlsFor(paginator);
	return VStack(alignment: 'stretch', spacing: 0) {
		VStack(alignment: 'stretch', spacing: 0) {
			orderControl(paginator)
			if (paginator.canSearch) { MkButton(iconOnly: true, transparent: true, rounded: true, active: state.searchOpened.value, onClick: { state.searchOpened.value = !state.searchOpened.value }) { VuneIcon('ti ti-search') } }
			MkButton(iconOnly: true, transparent: true, rounded: true, active: paginator.initialDate != null, onClick: {
				paginator.initialDate = paginator.initialDate == null ? Date.now() : null;
				void paginator.reload();
			}) { VuneIcon('ti ti-calendar-clock') }
			MkButton(iconOnly: true, transparent: true, rounded: true, onClick: { void paginator.reload() }) {
				VuneIcon('ti ti-refresh')
			}
		}.className('mk-vune-pagination__control-row')
		if (state.searchOpened.value) { MkInput(paginator.searchQuery.value, type: 'search', debounce: true, onChange: { value in changeSearch(paginator, value) }, label: Text(i18n.ts.search), prefix: VuneIcon('ti ti-search')) }
		if (paginator.initialDate != null) { MkInput(formatDateTimeString(new Date(paginator.initialDate), 'yyyy-MM-dd'), type: 'date', onChange: { value in changeDate(paginator, value) }) }
	}.className('mk-vune-pagination__controls');
}

function upVisible(paginator: IPaginator): boolean {
	return paginator.order.value === 'oldest' ? paginator.canFetchOlder.value : paginator.canFetchNewer.value;
}
function upLoading(paginator: IPaginator): boolean {
	return paginator.order.value === 'oldest' ? paginator.fetchingOlder.value : paginator.fetchingNewer.value;
}
function downVisible(paginator: IPaginator): boolean {
	return paginator.order.value === 'oldest' ? paginator.canFetchNewer.value : paginator.canFetchOlder.value;
}
function downLoading(paginator: IPaginator): boolean {
	return paginator.order.value === 'oldest' ? paginator.fetchingNewer.value : paginator.fetchingOlder.value;
}
function fetchUp(paginator: IPaginator): void {
	void (paginator.order.value === 'oldest' ? paginator.fetchOlder() : paginator.fetchNewer());
}
function fetchDown(paginator: IPaginator): void {
	void (paginator.order.value === 'oldest' ? paginator.fetchNewer() : paginator.fetchOlder());
}

function moreButton(paginator: IPaginator, direction: 'up' | 'down', infinite: boolean): ViewGraphValue {
	const loading = direction === 'up' ? upLoading(paginator) : downLoading(paginator);
	if (loading) return MkLoading();
	const action = direction === 'up' ? () => fetchUp(paginator) : () => fetchDown(paginator);
	return MkButton(primary: true, className: 'mk-vune-pagination__more', onClick: { action() }) { Text(i18n.ts.loadMore) }
		.elementRef(appearRef(infinite, action));
}

function paginationState(
	paginator: IPaginator,
	direction: Direction,
	forceDisableInfiniteScroll: boolean,
	empty: ViewGraphValue,
	content: ViewGraphValue,
): ViewGraphValue {
	if (paginator.fetching.value) return MkLoading();
	if (paginator.error.value) return MkError(onRetry: { void paginator.init() });
	if (paginator.items.value.length === 0) return empty ?? MkResult('empty');
	const infinite = prefer.r.enableInfiniteScroll.value && !forceDisableInfiniteScroll;
	return VStack(alignment: 'stretch', spacing: 0) {
		if ((direction === 'up' || direction === 'both') && upVisible(paginator)) { moreButton(paginator, 'up', infinite) }
		content
		if ((direction === 'down' || direction === 'both') && downVisible(paginator)) { moreButton(paginator, 'down', infinite) }
	}.className('_gaps')
		.animation(Animation.easeInOut(0.125), value: `${paginator.fetching.value}:${paginator.items.value.length}:${paginator.error.value}`);
}

export struct MkPagination: View {
	let paginator: IPaginator
	let autoLoad: boolean
	let direction: Direction
	let withControl: boolean
	let forceDisableInfiniteScroll: boolean
	let empty: ViewGraphValue
	let content: ViewGraphValue

	init(
		_ paginator: IPaginator,
		autoLoad: boolean = true,
		direction: Direction = 'down',
		withControl: boolean = false,
		forceDisableInfiniteScroll: boolean = false,
		empty: ViewGraphValue = null,
		@ViewBuilder content: () => ViewGraphValue,
	) {
		self.paginator = paginator
		self.autoLoad = autoLoad
		self.direction = direction
		self.withControl = withControl
		self.forceDisableInfiniteScroll = forceDisableInfiniteScroll
		self.empty = empty
		self.content = content()
	}

	var body: some View {
		syncComputedParams(paginator)
		return VStack(alignment: 'stretch', spacing: 0) {
			if (withControl) { paginationControl(paginator) }
			paginationState(paginator, direction, forceDisableInfiniteScroll, empty, content)
		}
			.className('mk-vune-pagination')
			.elementRef(rootRef(paginator, autoLoad))
			.withProps({ onContextMenu: (event: PointerEvent) => onContextMenu(paginator, event) })
	}
}

export default MkPagination
