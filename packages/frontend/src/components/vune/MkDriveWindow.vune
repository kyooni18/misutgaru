import { Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkDrive from '@/components/vune/MkDrive.vune';
import MkWindow from '@/components/vune/MkWindow.vune';
import { i18n } from '@/i18n.js';

type Props = { initialFolder?: Misskey.entities.DriveFolder | null; onClosed?: () => void };


export struct VuneMkDriveWindowView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkWindow(title: Text(i18n.ts.drive), onClosed: props.onClosed) { MkDrive(initialFolder: props.initialFolder ?? null) }
	}
}

export default VuneMkDriveWindowView
