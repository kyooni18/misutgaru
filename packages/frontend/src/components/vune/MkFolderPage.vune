/* @misutgaru-vune-native */
import { Button, HStack, VStack, ZStack } from 'vune-ui';
import VuneIcon from '@/vune/Icon.vune';
import './MkFolderPage.scss';

type CloseAction = () => void;
function ignoreClose(): void {}

export struct MkFolderPage: View {
	let pageId: number
	let zIndex: number
	let onClose: CloseAction

	init(_ pageId: number = 0, zIndex: number, @Action onClose: CloseAction = ignoreClose) {
		self.pageId = pageId
		self.zIndex = zIndex
		self.onClose = onClose
	}

	var body: some View {
		ZStack(alignment: 'center') {
			ZStack().className('mk-vune-folder-page__bg').style({ zIndex })
			VStack(alignment: 'stretch', spacing: 0) {
				HStack(alignment: 'center', spacing: 0) {
					Button(action: { onClose() }, label: { VuneIcon('ti ti-chevron-left') })
						.className(['_button', 'mk-vune-folder-page__back'])
					VStack(spacing: 0) {}
						.className('mk-vune-folder-page__title')
						.withProps({ id: `v-${pageId}-header` })
					VStack(spacing: 0) {}.className('mk-vune-folder-page__spacer')
				}
					.className(['mk-vune-folder-page__header', '_materialBar'])
				VStack(alignment: 'stretch', spacing: 0) {}
					.className('mk-vune-folder-page__body')
					.withProps({ id: `v-${pageId}-body` })
			}
				.className('mk-vune-folder-page__content')
				.style({ zIndex })
		}
			.className('mk-vune-folder-page')
			.style({ zIndex })
	}
}

export default MkFolderPage
