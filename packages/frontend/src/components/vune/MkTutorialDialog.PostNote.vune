import { Element, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkInfo from '@/components/MkInfo.vue';
import MkNote from '@/components/MkNote.vue';
import MkPostForm from '@/components/MkPostForm.vue';
import MkFormSection from '@/components/form/section.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';
import '@/vune/phase6-migration.scss';

type Props = { exampleCWNote: Misskey.entities.Note };

function visibilityRow(icon: string, title: string, description: string) {
	return Element('div', {},
		Element('i', { className: icon }),
		' ',
		Element('b', {}, title),
		` … ${description}`,
	);
}

export default createVuneComponent<Props>((props) =>
	Element('div', { className: '_gaps' },
		Element('div', { style: { textAlign: 'center', padding: '0 16px' } }, i18n.ts._initialTutorial._postNote.description1),
		VueComponent(MkPostForm, { class: 'mk-vune-tutorial-example', mock: true, autofocus: false }),
		VueComponent(MkFormSection, {}, {
			label: () => Text(i18n.ts.visibility),
			default: () => Element('div', { className: '_gaps' },
				Element('div', {}, i18n.ts._initialTutorial._postNote._visibility.description),
				visibilityRow('ti ti-world', i18n.ts._visibility.public, i18n.ts._initialTutorial._postNote._visibility.public),
				visibilityRow('ti ti-home', i18n.ts._visibility.home, i18n.ts._initialTutorial._postNote._visibility.home),
				visibilityRow('ti ti-lock', i18n.ts._visibility.followers, i18n.ts._initialTutorial._postNote._visibility.followers),
				Element('div', { className: '_gaps_s' },
					visibilityRow('ti ti-mail', i18n.ts._visibility.specified, i18n.ts._initialTutorial._postNote._visibility.direct),
					VueComponent(MkInfo, { warn: true }, {
						default: () => Group() {
							Element('b', {}, i18n.ts._initialTutorial._postNote._visibility.doNotSendConfidencialOnDirect1)
							` ${i18n.ts._initialTutorial._postNote._visibility.doNotSendConfidencialOnDirect2}`
						},
					}),
				),
				visibilityRow('ti ti-rocket-off', i18n.ts._visibility.disableFederation, i18n.ts._initialTutorial._postNote._visibility.localOnly),
			),
		}),
		VueComponent(MkFormSection, {}, {
			label: () => Text(i18n.ts._initialTutorial._postNote._cw.title),
			default: () => Element('div', { className: '_gaps' },
				Element('div', {}, i18n.ts._initialTutorial._postNote._cw.description),
				VueComponent(MkNote, { class: 'mk-vune-tutorial-example', note: props.exampleCWNote, mock: true }),
				Element('div', {}, i18n.ts._initialTutorial._postNote._cw.useCases),
			),
		}),
	)
);
