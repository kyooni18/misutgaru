import { VStack, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkInfo from '@/components/vune/MkInfo.vune';
import MkNote from '@/components/vune/MkNote.vune';
import MkPostForm from '@/components/vune/MkPostForm.vune';
import MkFormSection from '@/components/vune/MkFormSection.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
import '@/vune/phase6-migration.scss';

type Props = { exampleCWNote: Misskey.entities.Note };

struct VisibilityTutorialRow: View {
	let icon: string
	let title: string
	let description: string
	var body: some View {
		VStack(alignment: 'leading', spacing: 0) { VuneIcon(icon); Text(' '); Text(title).bold(); Text(` … ${description}`) }
	}
}



export struct VuneMkTutorialDialogPostNoteView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			Text(i18n.ts._initialTutorial._postNote.description1).multilineTextAlignment('center').padding({ horizontal: 16 })
			MkPostForm(mock: true, autofocus: false, className: 'mk-vune-tutorial-example')
			MkFormSection(label: Text(i18n.ts.visibility)) {
				VStack(alignment: 'stretch', spacing: 0) {
					Text(i18n.ts._initialTutorial._postNote._visibility.description)
					VisibilityTutorialRow(icon: 'ti ti-world', title: i18n.ts._visibility.public, description: i18n.ts._initialTutorial._postNote._visibility.public)
					VisibilityTutorialRow(icon: 'ti ti-home', title: i18n.ts._visibility.home, description: i18n.ts._initialTutorial._postNote._visibility.home)
					VisibilityTutorialRow(icon: 'ti ti-lock', title: i18n.ts._visibility.followers, description: i18n.ts._initialTutorial._postNote._visibility.followers)
					VStack(alignment: 'stretch', spacing: 0) {
						VisibilityTutorialRow(icon: 'ti ti-mail', title: i18n.ts._visibility.specified, description: i18n.ts._initialTutorial._postNote._visibility.direct)
						MkInfo(warn: true) {
							Group() {
								Text(i18n.ts._initialTutorial._postNote._visibility.doNotSendConfidencialOnDirect1).bold()
								Text(` ${i18n.ts._initialTutorial._postNote._visibility.doNotSendConfidencialOnDirect2}`)
							}
						}
					}.className('_gaps_s')
					VisibilityTutorialRow(icon: 'ti ti-rocket-off', title: i18n.ts._visibility.disableFederation, description: i18n.ts._initialTutorial._postNote._visibility.localOnly)
				}.className('_gaps')
			}
			MkFormSection(label: Text(i18n.ts._initialTutorial._postNote._cw.title)) {
				VStack(alignment: 'stretch', spacing: 0) {
					Text(i18n.ts._initialTutorial._postNote._cw.description)
					MkNote(props.exampleCWNote, className: 'mk-vune-tutorial-example')
					Text(i18n.ts._initialTutorial._postNote._cw.useCases)
				}.className('_gaps')
			}
		}.className('_gaps')
	}
}

export default VuneMkTutorialDialogPostNoteView
