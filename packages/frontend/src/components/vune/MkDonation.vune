import { Element, Text } from 'vune-ui';
import I18n from '@/components/global/I18n.vue';
import MkButton from '@/components/MkButton.vue';
import MkLink from '@/components/MkLink.vue';
import { host } from '@@/js/config.js';
import { i18n } from '@/i18n.js';
import { instance } from '@/instance.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';
import '@/vune/phase6-migration.scss';

type Props = {
	zIndex: number | string;
	onClose?: () => void;
	onNeverShow?: () => void;
};

function donationIcon() {
	return Element('i', { className: 'ti ti-pig-money', style: { fontSize: '40px' } });
}

export default createVuneComponent<Props>((props) =>
	Element('div', {
		className: '_panel _shadow mk-vune-bottom-prompt',
		style: { zIndex: String(props.zIndex) },
	},
		Element('div', { className: 'mk-vune-bottom-prompt__icon' }, donationIcon()),
		Element('div', { className: 'mk-vune-bottom-prompt__main' },
			Element('div', { className: 'mk-vune-bottom-prompt__title' }, i18n.ts.didYouLikeMisskey),
			Element('div', { className: 'mk-vune-bottom-prompt__text' },
				VueComponent(I18n, { src: i18n.ts.pleaseDonate, tag: 'span' }, {
					host: () => Text(instance.name ?? host),
				}),
				Element('div', { style: { marginTop: '.2em' } },
					VueComponent(MkLink, {
						target: '_blank',
						url: 'https://misskey-hub.net/docs/for-users/resources/donate/',
					}, { default: () => Text(i18n.ts.learnMore) }),
				),
			),
			Element('div', { className: '_buttons' },
				VueComponent(MkButton, { onClick: () => props.onClose?.() }, { default: () => Text(i18n.ts.remindMeLater) }),
				VueComponent(MkButton, { onClick: () => props.onNeverShow?.() }, { default: () => Text(i18n.ts.neverShow) }),
			),
		),
		Element('button', {
			className: '_button mk-vune-bottom-prompt__close',
			onClick: () => props.onClose?.(),
		}, Element('i', { className: 'ti ti-x' })),
	)
);
