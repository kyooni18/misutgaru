/* @misutgaru-vune-native */
import { Button, HStack, NavigationLink, Text, VStack } from 'vune-ui';
import { host } from '@@/js/config.js';
import { i18n } from '@/i18n.js';
import { instance } from '@/instance.js';
import VuneIcon from '@/vune/Icon.vune';
import MaterialSurface from '@/vune/MaterialSurface.vune';
import { Material } from '@/vune/material.js';
import '@/vune/phase6-migration.scss';

export struct MkDonation: View {
	let zIndex: number | string
	let onClose: () => void
	let onNeverShow: () => void

	init(_ zIndex: number | string, @Action onClose: () => void, @Action onNeverShow: () => void) {
		self.zIndex = zIndex
		self.onClose = onClose
		self.onNeverShow = onNeverShow
	}

	var body: some View {
		MaterialSurface(Material.regular, opaqueBackground: 'var(--MI_THEME-bg)', animated: true) {
			HStack(alignment: 'stretch', spacing: 0) {
				VuneIcon('ti ti-pig-money')
					.className('mk-vune-bottom-prompt__icon')
					.style({ fontSize: '40px' })
				VStack(alignment: 'stretch', spacing: 0) {
					Text(i18n.ts.didYouLikeMisskey)
						.className('mk-vune-bottom-prompt__title')
					VStack(alignment: 'stretch', spacing: 0) {
						Text(i18n.tsx.pleaseDonate({ host: instance.name ?? host }))
						NavigationLink('https://misskey-hub.net/docs/for-users/resources/donate/', i18n.ts.learnMore)
							.className('_link mk-vune-bottom-prompt__link')
							.withProps({ target: '_blank', rel: 'nofollow noopener' })
					}
						.className('mk-vune-bottom-prompt__text')
					HStack(alignment: 'center', spacing: 8) {
						Button(i18n.ts.remindMeLater) { onClose() }
							.className('_button mk-vune-bottom-prompt__button')
						Button(i18n.ts.neverShow) { onNeverShow() }
							.className('_button mk-vune-bottom-prompt__button')
					}
						.className('_buttons mk-vune-bottom-prompt__actions')
				}
					.className('mk-vune-bottom-prompt__main')
				Button('×') { onClose() }
					.className('_button mk-vune-bottom-prompt__close')
					.withProps({ 'aria-label': i18n.ts.close })
			}
				.style({ width: '100%', minWidth: 0 })
		}
			.className(['_shadow', 'mk-vune-bottom-prompt'])
			.style({ zIndex })
	}
}

export default MkDonation
