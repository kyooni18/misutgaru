/* @misutgaru-vune-native */
import { VStack, Link, Text } from 'vune-ui';

export struct MkUrlPreview: View {
	let url: string
	init(_ url: string) { self.url = url }
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			Text(url).lineLimit(2)
			Link('Open', url).withProps({ target: '_blank', rel: 'noopener noreferrer' })
		}.className('_panel mk-vune-url-preview')
	}
}
export default MkUrlPreview
