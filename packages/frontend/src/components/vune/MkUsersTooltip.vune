/* @misutgaru-vune-native */
import { VStack, ForEach, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkTooltip from '@/components/vune/MkTooltip.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import '@/vune/phase5-migration.scss';

type Props = { showing: boolean; users: Misskey.entities.UserLite[]; count: number; anchorElement: HTMLElement; onClosed?: () => void };

export struct MkUsersTooltip: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkTooltip(showing: props.showing, anchorElement: props.anchorElement, maxWidth: 250, onClosed: { props.onClosed?.() }) {
			VStack(alignment: 'stretch', spacing: 0) {
				ForEach(props.users, key: user => user.id) { user in
					VStack(alignment: 'stretch', spacing: 0) {
						MkAvatar(user, className: 'mk-vune-users-tooltip__avatar')
						MkUserName({ user, nowrap: true })
					}.className('mk-vune-users-tooltip__user')
				}
				if (props.users.length < props.count) { Text(`+${props.count - props.users.length}`) }
			}.className('mk-vune-users-tooltip')
		}
	}
}

export default MkUsersTooltip
