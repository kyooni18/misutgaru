import { Text } from 'vune-ui';
import './misskey-vune.scss';

export struct MkCodeInline: View {
	let code: string

	init(_ code: string) {
		self.code = code
	}

	var body: some View {
		Text(code)
			.className('mk-vune-code-inline')
	}
}

export default MkCodeInline
