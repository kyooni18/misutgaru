/* @misutgaru-vune-native */
import { VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkMfm from '@/components/global/vune/MkMfm.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import MkCwButton from '@/components/vune/MkCwButton.vune';
import type { PollEditorModelValue } from '@/components/MkPollEditor.types.js';

type Props = { text: string; files: Misskey.entities.DriveFile[]; poll?: PollEditorModelValue; useCw: boolean; cw: string | null; user: Misskey.entities.User; showContent?: boolean; classes: Record<string, string>; onShowContent?: (value: boolean) => void };
export struct MkNotePreview: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		return VStack(alignment: 'stretch', spacing: 0) {
			MkAvatar(props.user, className: props.classes.avatar)
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) { MkUserName({ user: props.user, nowrap: true }) }.className(props.classes.header)
				VStack(alignment: 'stretch', spacing: 0) {
					if (props.useCw) {
						VStack(alignment: 'stretch', spacing: 0) {
							if (props.cw) { MkMfm({ text: props.cw, author: props.user, nyaize: 'respect' }) }
								MkCwButton(
									props.showContent ?? false,
									text: props.text.trim(),
									files: props.files,
									poll: props.poll,
									onChange: { value in
										props.onShowContent?.(value)
									},
								)
						}.className(props.classes.cw)
					}
					VStack(alignment: 'stretch', spacing: 0) { MkMfm({ text: props.text.trim(), author: props.user, nyaize: 'respect' }) }
						.style({ display: !props.useCw || props.showContent ? '' : 'none' })
				}
			}.className(props.classes.main)
		}.className(props.classes.root)
	}
}
export default MkNotePreview
