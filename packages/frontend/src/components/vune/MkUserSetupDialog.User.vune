import type * as Misskey from 'misskey-js';
import MkMfm from '@/components/global/vune/MkMfm.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import MkAcct from '@/components/global/vune/MkAcct.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import { Group, Text, VStack } from 'vune-ui';
import VuneIcon from '@/vune/Icon.vune';

type Props = { user: Misskey.entities.UserDetailed; isFollowing?: boolean; classes: Record<string, string>; onFollow?: () => void };

export struct MkUserSetupDialogUser: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		return Group() {
			VStack(alignment: 'stretch', spacing: 0).className(props.classes.banner).style(props.user.bannerUrl ? { backgroundImage: `url(${props.user.bannerUrl})` } : {})
			MkAvatar(props.user, indicator: true, className: props.classes.avatar),
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) { MkUserName({ user: props.user, nowrap: false }) }.className(props.classes.name)
				VStack(alignment: 'stretch', spacing: 0) { MkAcct(props.user) }.className(props.classes.username)
			}.className(props.classes.title)
			VStack(alignment: 'stretch', spacing: 0) {
				if (props.user.description) { VStack(alignment: 'stretch', spacing: 0) { MkMfm({ text: props.user.description, author: props.user }) }.className(props.classes.mfm) }
				else { Text(i18n.ts.noAccountDescription).opacity(0.7) }
			}.className(props.classes.description)
			VStack(alignment: 'stretch', spacing: 0) {
				if (!props.isFollowing) {
					MkButton(primary: true, gradate: true, rounded: true, full: true, onClick: { props.onFollow?.() }) {
						Group() { VuneIcon('ti ti-plus'); Text(` ${i18n.ts.follow}`) }
					}
				} else {
					Group() { Text(`${i18n.ts.youFollowing} `); VuneIcon('ti ti-check') }.opacity(0.7)
				}
			}.className(props.classes.footer)
		}
	}
}

export default MkUserSetupDialogUser
