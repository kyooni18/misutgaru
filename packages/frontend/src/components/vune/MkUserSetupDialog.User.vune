import { Element, Text } from 'vune-ui';
import * as Misskey from 'misskey-js';
import Mfm from '@/components/global/MkMfm.js';
import MkAvatar from '@/components/global/MkAvatar.vue';
import MkUserName from '@/components/global/MkUserName.vue';
import MkAcct from '@/components/global/MkAcct.vue';
import MkButton from '@/components/MkButton.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type Props = { user: Misskey.entities.UserDetailed; isFollowing?: boolean; classes: Record<string, string>; onFollow?: () => void };
export default createVuneComponent<Props>((props) =>
	Element('div', { style: { display: 'contents' } },
		Element('div', { className: props.classes.banner, style: props.user.bannerUrl ? { backgroundImage: `url(${props.user.bannerUrl})` } : {} }),
		VueComponent(MkAvatar, { class: props.classes.avatar, user: props.user, indicator: true }),
		Element('div', { className: props.classes.title },
			Element('div', { className: props.classes.name }, VueComponent(MkUserName, { user: props.user, nowrap: false })),
			Element('p', { className: props.classes.username }, VueComponent(MkAcct, { user: props.user })),
		),
		Element('div', { className: props.classes.description },
			props.user.description
				? Element('div', { className: props.classes.mfm }, VueComponent(Mfm as any, { text: props.user.description, author: props.user }))
				: Element('span', { style: { opacity: 0.7 } }, i18n.ts.noAccountDescription),
		),
		Element('div', { className: props.classes.footer },
			!props.isFollowing
				? VueComponent(MkButton, { primary: true, gradate: true, rounded: true, full: true, onClick: () => props.onFollow?.() }, { default: () => Element('span', {}, Element('i', { className: 'ti ti-plus' }), ` ${i18n.ts.follow}`) })
				: Element('div', { style: { opacity: 0.7, textAlign: 'center' } }, `${i18n.ts.youFollowing} `, Element('i', { className: 'ti ti-check' })),
		),
	)
);
