/* @misutgaru-vune-native */
import { Canvas } from '@vune-ui/core/web-primitives';
import { blurhashCanvasRef } from './blurhash-controller.js';

export struct MkBlurhash: View {
	let blurhash: string | null
	let onlyAvgColor: boolean
	let width: number
	let height: number
	let show: boolean
	let className: string
	init(_ blurhash: string | null, onlyAvgColor: boolean = false, width: number = 64, height: number = 64, show: boolean = true, className: string = '') {
		self.blurhash = blurhash; self.onlyAvgColor = onlyAvgColor; self.width = width; self.height = height; self.show = show; self.className = className
	}
	var body: some View {
		Canvas(width, height, blurhashCanvasRef(blurhash, onlyAvgColor, width, height))
			.className(className)
			.withProps({ draggable: false, tabindex: -1, hidden: !show })
			.style({ WebkitUserDrag: 'none' })
	}
}
export default MkBlurhash
