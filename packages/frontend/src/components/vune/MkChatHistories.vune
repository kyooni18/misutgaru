import { VStack, ForEach, Text, type StateRef } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import { misskeyApi } from '@/utility/misskey-api.js';
import MkA from '@/components/global/vune/MkA.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import MkTimeValue from '@/components/global/vune/MkTimeValue.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import { i18n } from '@/i18n.js';
import { $i as currentUser } from '@/i.js';

type Row = { id: string; message: Misskey.entities.ChatMessage; other: any; isMe: boolean };

function historyRef(rows: StateRef<Row[] | null>) {
	return (element: HTMLElement | null) => {
		if (!element || rows.value != null) return;
		void Promise.all([misskeyApi('chat/history', { room: false }), misskeyApi('chat/history', { room: true })]).then(([users, rooms]) => {
			rows.value = [...users, ...rooms].toSorted((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()).map(message => ({
				id: message.id,
				message,
				other: ('room' in message && message.room != null) ? null : (message.fromUserId === currentUser?.id ? message.toUser : message.fromUser),
				isMe: message.fromUserId === currentUser?.id,
			}));
		});
	};
}

export struct MkChatHistories: View {
	@State var rows: Row[] | null = null
	init() {}
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			if (rows.value == null) { MkLoading() }
			else if (rows.value.length === 0) { MkResult('empty', text: i18n.ts._chat.noHistory) }
			else {
				ForEach(rows.value, key: row => row.id) { row in
					MkA(row.message.toRoomId ? `/chat/room/${row.message.toRoomId}` : `/chat/user/${row.other?.id ?? ''}`, className: '_panel mk-vune-chat-history') {
						if (row.other) { MkAvatar(row.other, indicator: true, className: 'mk-vune-chat-history__avatar') }
						VStack(alignment: 'stretch', spacing: 0) {
							if (row.other) { MkUserName({ user: row.other, nowrap: true }) }
							MkTimeValue(row.message.createdAt)
							Text(`${row.isMe ? `${i18n.ts.you}: ` : ''}${row.message.text ?? ''}`)
						}.className('mk-vune-chat-history__body')
					}
				}
			}
		}.className('_gaps_s').elementRef(historyRef(rows))
	}
}

export default MkChatHistories
