/* @misutgaru-vune-native */
import { Box, Button, ForEach, Group, Text } from 'vune-ui';
import type { LegendItem } from 'chart.js';
import '@/vune/phase6-migration.scss';

type ChartLegendAction = (item: LegendItem) => void;

function ignoreChartLegendAction(_item: LegendItem): void {}

type ChartLegendActions = { itemClick: ChartLegendAction };

export struct MkChartLegend: View {
	let items: LegendItem[]
	let type: string | undefined
	let actions: ChartLegendActions

	init(
		_ items: LegendItem[],
		type: string | undefined = undefined,
		@Action onItemClick: ChartLegendAction = ignoreChartLegendAction,
	) {
		self.items = items
		self.type = type
		self.actions = { itemClick: onItemClick }
	}

	var body: some View {
		Box() {
			ForEach(items, key: (item, index) => `${item.datasetIndex ?? ''}:${item.index ?? ''}:${item.text}:${index}`) { item in
				Button(action: {
					actions.itemClick(item)
				}, label: {
					Group() {
						Text('')
							.className('mk-vune-chart-legend__box')
							.style({ background: type === 'line' ? item.strokeStyle?.toString() : item.fillStyle?.toString() })
						Text(` ${item.text}`)
					}
				})
					.className(['_button', 'mk-vune-chart-legend__item', item.hidden ? 'mk-vune-chart-legend__item--disabled' : null])
			}
		}
			.className('mk-vune-chart-legend')
	}
}

export default MkChartLegend
