/* @misutgaru-vune-native */
import { Animation, Group, Text } from 'vune-ui';

struct ClockColon: View {
	let visible: boolean
	init(_ visible: boolean) { self.visible = visible }
	var body: some View {
		Text(':')
			.className('mk-vune-digital-clock__colon')
			.style({ opacity: visible ? 1 : 0 })
			.animation(visible ? Animation.linear(0) : Animation.easeInOut(1), value: visible)
	}
}

export struct MkDigitalClock: View {
	let hh: string
	let mm: string
	let ss: string
	let ms: string
	let showS: boolean
	let showMs: boolean
	let showColon: boolean

	init(
		_ hh: string,
		_ mm: string,
		_ ss: string,
		_ ms: string,
		showS: boolean = true,
		showMs: boolean = false,
		showColon: boolean = false,
	) {
		self.hh = hh
		self.mm = mm
		self.ss = ss
		self.ms = ms
		self.showS = showS
		self.showMs = showMs
		self.showColon = showColon
	}

	var body: some View {
		Group() {
			Text(hh)
			ClockColon(showColon)
			Text(mm)
			if (showS) { ClockColon(showColon); Text(ss) }
			if (showMs) { ClockColon(showColon); Text(ms) }
		}
	}
}

export default MkDigitalClock
