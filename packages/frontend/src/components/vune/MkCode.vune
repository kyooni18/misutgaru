import { VStack, Button, Text } from 'vune-ui';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
type Props = { code: string; lang?: string; show?: boolean; copyButton?: boolean; withOuterStyle?: boolean; classes: Record<string,string>; onCopy?: () => void; onShow?: () => void };
function copyCode(props: Props): void { props.onCopy?.(); }
function showCode(props: Props): void { props.onShow?.(); }
struct CodeFallback: View {
	let props: Props
	var body: some View {
		Text(props.code)
			.className(['_selectable', props.classes.codeBlockFallbackRoot, props.withOuterStyle !== false ? props.classes.outerStyle : null, props.classes.codeBlockFallbackCode])
			.fontDesign('monospaced')
			.withProps({ 'data-lang': props.lang ?? '' })
	}
}


export struct VuneMkCodeView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			if (props.copyButton !== false) {
				Button('') { copyCode(props) }
					.overlay(VuneIcon('ti ti-copy'))
					.className([props.classes.codeBlockCopyButton, props.withOuterStyle !== false ? props.classes.withOuterStyle : null, '_button'])
			}
			if (props.show === true) { CodeFallback(props: props) }
			else {
				Button('') { showCode(props) }
					.overlay(
						VStack(alignment: 'leading', spacing: 0) {
							VStack(alignment: 'leading', spacing: 0) {
								VuneIcon('ti ti-code')
								Text(` ${i18n.ts.code}`)
							}
							Text(i18n.ts.clickToShow)
						}.className(props.classes.codePlaceholderContainer)
					)
					.className(props.classes.codePlaceholderRoot)
			}
		}.className(props.classes.codeBlockRoot)
	}
}

export default VuneMkCodeView
