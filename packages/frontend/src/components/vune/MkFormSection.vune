import { VStack, type ViewGraphValue } from 'vune-ui';
import './misskey-vune.scss';

export struct MkFormSection: View {
	let first: boolean
	let label: ViewGraphValue
	let description: ViewGraphValue
	let content: ViewGraphValue

	init(
		first: boolean = false,
		label: ViewGraphValue = null,
		description: ViewGraphValue = null,
		@ViewBuilder content: () => ViewGraphValue,
	) {
		self.first = first
		self.label = label
		self.description = description
		self.content = content()
	}

	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			VStack(alignment: 'leading', spacing: 0) { label }.className(['mk-vune-form-section__label', first ? 'mk-vune-form-section__label--first' : null])
			VStack(alignment: 'leading', spacing: 0) { description }.className('mk-vune-form-section__description')
			VStack(alignment: 'leading', spacing: 0) { content }.className('mk-vune-form-section__main')
		}.className(['mk-vune-form-section', first ? 'mk-vune-form-section--first' : null])
	}
}

export default MkFormSection
