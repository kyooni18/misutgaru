import { VStack, type ViewGraphValue } from 'vune-ui';
import { i18n } from '@/i18n.js';
import { copyToClipboard } from '@/utility/copy-to-clipboard.js';
import VuneIcon from '@/vune/Icon.vune';
import MkButton from '@/components/vune/MkButton.vune';
import './misskey-vune.scss';

export struct MkKeyValue: View {
	let copy: string | null
	let oneline: boolean
	let keyContent: ViewGraphValue
	let valueContent: ViewGraphValue

	init(
		copy: string | null = null,
		oneline: boolean = false,
		key keyContent: ViewGraphValue,
		value valueContent: ViewGraphValue,
	) {
		self.copy = copy
		self.oneline = oneline
		self.keyContent = keyContent
		self.valueContent = valueContent
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 0) { keyContent }.className('mk-vune-key-value__key')
			VStack(alignment: 'stretch', spacing: 0) {
				valueContent
				if (copy != null) {
					MkButton(transparent: true, iconOnly: true, className: '_textButton mk-vune-key-value__copy', onClick: { copyToClipboard(copy) }) { VuneIcon('ti ti-copy') }
						.withProps({ title: i18n.ts.copy })
				}
			}.className(['_selectable', 'mk-vune-key-value__value'])
		}.className(['mk-vune-key-value', oneline ? 'mk-vune-key-value--oneline' : null])
	}
}

export default MkKeyValue
