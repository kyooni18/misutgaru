import { Element } from 'vune-ui';
import { i18n } from '@/i18n.js';
import { copyToClipboard } from '@/utility/copy-to-clipboard.js';
import { createVuneComponent, VueSlot } from '@/vune/vue.js';

type Props = {
	copy?: string | null;
	oneline?: boolean;
	rootClass: string;
	onelineClass: string;
	keyClass: string;
	valueClass: string;
};

export default createVuneComponent<Props>((props, slots) =>
	Element('div', { className: [props.rootClass, props.oneline ? props.onelineClass : null] },
		Element('div', { className: props.keyClass }, VueSlot(slots.key)),
		Element('div', { className: [props.valueClass, '_selectable'] },
			VueSlot(slots.value),
			props.copy ? Element('button', {
				className: '_textButton',
				style: { marginLeft: '0.5em' },
				title: i18n.ts.copy,
				onClick: () => copyToClipboard(props.copy!),
			}, Element('i', { className: 'ti ti-copy' })) : null,
		),
	)
);
