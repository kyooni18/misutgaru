/* @misutgaru-vune-native */
import { Binding, Button, Element, ForEach, Group, ScrollView, Text, TextField, VStack, type ViewGraphValue } from 'vune-ui';
import { VueComponent, createVuneComponent } from '@/vune/vue.js';
import MkCustomEmoji from '@/components/global/MkCustomEmoji.vue';
import MkEmoji from '@/components/global/MkEmoji.vue';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
import type { NativeEmojiPickerItem, NativeEmojiPickerModel, NativeEmojiPickerSection } from './MkEmojiPicker.types.js';
import './MkEmojiPicker.vune.scss';

type Props = {
	model: NativeEmojiPickerModel;
	class?: string;
	style?: string | Record<string, unknown>;
};

function handleSearchKeydown(model: NativeEmojiPickerModel, event: KeyboardEvent): void {
	if (event.key === 'Escape') {
		event.preventDefault();
		event.stopPropagation();
		model.onEscape();
	}
	if (event.key === 'Enter') {
		event.preventDefault();
		event.stopPropagation();
		model.onSubmit();
	}
}

function handleEscape(model: NativeEmojiPickerModel, event: KeyboardEvent): void {
	if (event.key === 'Escape') {
		event.preventDefault();
		event.stopPropagation();
		model.onEscape();
	}
}

function handlePaste(model: NativeEmojiPickerModel, event: ClipboardEvent): void {
	const pasted = event.clipboardData?.getData('text') ?? '';
	if (model.onPaste(pasted)) event.preventDefault();
}

function emojiGrid(items: NativeEmojiPickerItem[], choose: (key: string) => void): ViewGraphValue {
	return Group() {
		ForEach(items, key: item => item.key) { item in
			Element('button', {
				className: ['_button', 'mk-vune-emoji-picker__emoji'],
				title: item.title,
				'aria-label': item.title,
				'data-emoji': item.key,
				disabled: item.disabled,
				onClick: () => {
					if (!item.disabled) choose(item.key)
				},
			}, item.view)
		}
	}
		.className('mk-vune-emoji-picker__grid');
}

function pickerSection(section: NativeEmojiPickerSection, choose: (key: string) => void): ViewGraphValue {
	return Group() {
		Button(action: section.onToggle, label: {
			VuneIcon(section.expanded ? 'ti ti-chevron-down' : 'ti ti-chevron-right').className('mk-vune-emoji-picker__section-icon')
			Text(section.title).className('mk-vune-emoji-picker__section-title')
			Text(String(section.count)).className('mk-vune-emoji-picker__section-count')
		})
			.className(['_button', 'mk-vune-emoji-picker__section-header'])
			.withProps({ 'aria-expanded': section.expanded })
		if (section.expanded) { emojiGrid(section.emojis, choose) }
	}
		.className('mk-vune-emoji-picker__section');
}

function quickBlock(title: string, items: NativeEmojiPickerItem[], choose: (key: string) => void): ViewGraphValue {
	return Element('div', { className: 'mk-vune-emoji-picker__quick-block' },
		Text(title).className('mk-vune-emoji-picker__section-title'),
		emojiGrid(items, choose),
	);
}

export default createVuneComponent<Props>((props) => {
	const model = props.model;
	const rootClasses = [
		'mk-vune-emoji-picker',
		model.asDrawer ? 'mk-vune-emoji-picker--drawer' : '',
		model.asWindow ? 'mk-vune-emoji-picker--window' : '',
		props.class ?? '',
	];

	return VStack(alignment: 'stretch', spacing: 0) {
		Group() {
			Group() {
				Group() {
					Text(i18n.ts.emojiPalette).className('mk-vune-emoji-picker__title')
					Text(i18n.ts.search).className('mk-vune-emoji-picker__subtitle')
				}
					.className('mk-vune-emoji-picker__heading-copy')
			Button(action: model.onSettings, label: { VuneIcon('ti ti-settings') })
				.className(['_button', 'mk-vune-emoji-picker__settings'])
				.withProps({ 'aria-label': i18n.ts.settings })
			}
				.className('mk-vune-emoji-picker__heading')
			TextField(Binding(() => model.query, (value: string) => model.onQuery(value)), model.placeholder)
				.className('mk-vune-emoji-picker__search')
				.withProps({ type: 'search', 'aria-label': model.placeholder, onKeyDown: (event: KeyboardEvent) => handleSearchKeydown(model, event), onPaste: (event: ClipboardEvent) => handlePaste(model, event) })
		}
			.className('mk-vune-emoji-picker__top')
		ScrollView('vertical') {
			if (model.query !== '') {
				Group() {
					Text(model.resultLabel).className('mk-vune-emoji-picker__section-title')
					if (model.results.length > 0) { emojiGrid(model.results, model.onChoose) } else { Text(i18n.ts.none).className('mk-vune-emoji-picker__empty') }
				}
					.className('mk-vune-emoji-picker__quick')
			} else {
				Group() {
					if (model.pinned.length > 0) { quickBlock(i18n.ts.pinned, model.pinned, model.onChoose) }
					if (model.recent.length > 0) { quickBlock(i18n.ts.recentUsed, model.recent, model.onChoose) }
				}
					.className('mk-vune-emoji-picker__quick')
			}
			ForEach(model.groups, key: group => group.key) { group in
				Group() {
					Group() {
						VuneIcon(group.icon).className('mk-vune-emoji-picker__group-icon')
						Text(group.title).className('mk-vune-emoji-picker__group-title')
					}
						.className('mk-vune-emoji-picker__group-heading')
					ForEach(group.sections, key: section => section.key) { section in pickerSection(section, model.onChoose) }
				}
					.className('mk-vune-emoji-picker__group')
			}
		}
			.className('mk-vune-emoji-picker__content')
			.style({ '--emoji-columns': model.columns, '--emoji-item-size': `${model.itemSize}px` })
			.withProps({ onKeyDown: (event: KeyboardEvent) => handleEscape(model, event) })
		Group() {
			Text('Enter').className('mk-vune-emoji-picker__key')
			Text(i18n.ts.search)
			Text(String(model.pinned.length + model.recent.length)).className('mk-vune-emoji-picker__subtitle')
		}
			.className('mk-vune-emoji-picker__footer')
	}
		.className(rootClasses)
		.style({
			width: model.asDrawer || model.asWindow ? '100%' : `${model.width}px`,
			height: model.asWindow ? '100%' : `${model.height}px`,
			maxHeight: model.maxHeight ? `${model.maxHeight}px` : undefined,
		})
		.withProps({ onKeyDown: (event: KeyboardEvent) => handleEscape(model, event) });
});
