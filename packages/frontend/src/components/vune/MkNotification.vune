/* @misutgaru-vune-native */
import { ForEach, Group, HStack, Image, State, Text, VStack, type StateRef, type ViewGraphValue } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkA from '@/components/global/vune/MkA.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkMfm from '@/components/global/vune/MkMfm.vune';
import MkTimeValue from '@/components/global/vune/MkTimeValue.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkReactionIcon from '@/components/vune/MkReactionIcon.vune';
import { getNoteSummary } from '@/utility/get-note-summary.js';
import { notePage } from '@/filters/note.js';
import { userPage } from '@/filters/user.js';
import { i18n } from '@/i18n.js';
import { $i as currentUser } from '@/i.js';
import { misskeyApi } from '@/utility/misskey-api.js';
import VuneIcon from '@/vune/Icon.vune';
import './MkNotification.scss';

type Notification = Misskey.entities.Notification;

const followRequestDone = new Map<string, StateRef<boolean>>();

function followRequestState(id: string): StateRef<boolean> {
	let state = followRequestDone.get(id);
	if (!state) {
		state = State(false);
		followRequestDone.set(id, state);
	}
	return state;
}

function typeLabel(notification: Notification): string {
	const labels = i18n.ts._notification._types as Record<string, string>;
	return labels[notification.type] ?? notification.type;
}

function headerUsesUser(notification: Notification): boolean {
	return [
		'follow',
		'mention',
		'reply',
		'renote',
		'quote',
		'reaction',
		'receiveFollowRequest',
		'followRequestAccepted',
	].includes(notification.type) && 'user' in notification && notification.user != null;
}

function avatarUser(notification: Notification): Misskey.entities.User | null {
	const value = notification as any;
	if ((notification.type === 'pollEnded' || notification.type === 'note') && value.note?.user) return value.note.user;
	if ([
		'roleAssigned',
		'achievementEarned',
		'exportCompleted',
		'login',
		'createToken',
		'scheduledNotePosted',
		'scheduledNotePostFailed',
	].includes(notification.type) && currentUser != null) return currentUser;
	if ('user' in notification && notification.user != null) return notification.user;
	return null;
}

function subIcon(notification: Notification): string | null {
	switch (notification.type) {
		case 'follow': return 'ti ti-plus';
		case 'receiveFollowRequest': return 'ti ti-clock';
		case 'followRequestAccepted': return 'ti ti-check';
		case 'renote': return 'ti ti-repeat';
		case 'reply': return 'ti ti-arrow-back-up';
		case 'mention': return 'ti ti-at';
		case 'quote': return 'ti ti-quote';
		case 'pollEnded': return 'ti ti-chart-arrows';
		case 'scheduledNotePosted': return 'ti ti-send';
		case 'scheduledNotePostFailed': return 'ti ti-alert-triangle';
		case 'achievementEarned': return 'ti ti-medal';
		case 'exportCompleted': return 'ti ti-archive';
		case 'login': return 'ti ti-login-2';
		case 'createToken': return 'ti ti-key';
		case 'chatRoomInvitationReceived': return 'ti ti-messages';
		case 'roleAssigned': return 'ti ti-badges';
		default: return null;
	}
}

function eventClass(notification: Notification): string {
	switch (notification.type) {
		case 'follow':
		case 'followRequestAccepted':
		case 'receiveFollowRequest': return 'mk-vune-notification__sub-icon--follow';
		case 'renote':
		case 'quote': return 'mk-vune-notification__sub-icon--renote';
		case 'reply': return 'mk-vune-notification__sub-icon--reply';
		case 'reaction': return 'mk-vune-notification__sub-icon--reaction';
		case 'achievementEarned': return 'mk-vune-notification__sub-icon--achievement';
		case 'login': return 'mk-vune-notification__sub-icon--login';
		case 'scheduledNotePostFailed': return 'mk-vune-notification__sub-icon--warning';
		default: return 'mk-vune-notification__sub-icon--other';
	}
}

function notificationHead(notification: Notification): ViewGraphValue {
	const value = notification as any;
	const user = avatarUser(notification);
	return VStack(alignment: 'stretch', spacing: 0) {
		if (notification.type === 'reaction:grouped') {
			VStack(alignment: 'center', spacing: 0) {
				VuneIcon(value.note?.reactionAcceptance === 'likeOnly' ? 'ti ti-heart' : 'ti ti-plus')
			}.className([
				'mk-vune-notification__event-avatar',
				value.note?.reactionAcceptance === 'likeOnly' ? 'mk-vune-notification__event-avatar--heart' : 'mk-vune-notification__event-avatar--reaction',
			])
		} else if (notification.type === 'renote:grouped') {
			VStack(alignment: 'center', spacing: 0) { VuneIcon('ti ti-repeat') }
				.className(['mk-vune-notification__event-avatar', 'mk-vune-notification__event-avatar--renote'])
		} else if (user != null) {
			MkAvatar(user, link: true, preview: true, className: 'mk-vune-notification__avatar')
		} else if ('icon' in notification && value.icon != null) {
			Image(value.icon, { alt: '' }).className('mk-vune-notification__app-icon')
		} else {
			VStack(alignment: 'center', spacing: 0) { VuneIcon('ti ti-bell') }
				.className(['mk-vune-notification__event-avatar', 'mk-vune-notification__event-avatar--other'])
		}

		if (notification.type === 'reaction') {
			VStack(alignment: 'center', spacing: 0) {
				MkReactionIcon(value.reaction.replace(/^(:(\w+):)$/, ':$2@.:'), noStyle: true, className: 'mk-vune-notification__reaction-icon')
			}.className(['mk-vune-notification__sub-icon', eventClass(notification)])
		} else if (subIcon(notification) != null) {
			VStack(alignment: 'center', spacing: 0) { VuneIcon(subIcon(notification)!) }
				.className(['mk-vune-notification__sub-icon', eventClass(notification)])
		}
	}.className('mk-vune-notification__head')
}

function notificationTitle(notification: Notification): ViewGraphValue {
	const value = notification as any;
	if (headerUsesUser(notification)) {
		return MkA(userPage(value.user), className: 'mk-vune-notification__header-name') {
			MkUserName({ user: value.user, nowrap: true })
		};
	}

	switch (notification.type) {
		case 'pollEnded': return Text(i18n.ts._notification.pollEnded);
		case 'scheduledNotePosted': return Text(i18n.ts._notification.scheduledNotePosted);
		case 'scheduledNotePostFailed': return Text(i18n.ts._notification.scheduledNotePostFailed);
		case 'note':
			return HStack(alignment: 'firstTextBaseline', spacing: 4) {
				Text(`${i18n.ts._notification.newNote}:`);
				if (value.note?.user) { MkUserName({ user: value.note.user, nowrap: true }) }
			};
		case 'roleAssigned': return Text(i18n.ts._notification.roleAssigned);
		case 'chatRoomInvitationReceived': return Text(i18n.ts._notification.chatRoomInvitationReceived);
		case 'achievementEarned': return Text(i18n.ts._notification.achievementEarned);
		case 'login': return Text(i18n.ts._notification.login);
		case 'createToken': return Text(i18n.ts._notification.createToken);
		case 'test': return Text(i18n.ts._notification.testNotification);
		case 'reaction:grouped': {
			const count = new Set((value.reactions ?? []).map((reaction: any) => reaction.user.id)).size;
			return Text(value.note?.reactionAcceptance === 'likeOnly'
				? i18n.tsx._notification.likedBySomeUsers({ n: count })
				: i18n.tsx._notification.reactedBySomeUsers({ n: count }));
		}
		case 'renote:grouped': return Text(i18n.tsx._notification.renotedBySomeUsers({ n: value.users?.length ?? 0 }));
		case 'app': return Text(value.header ?? typeLabel(notification));
		default: return Text(typeLabel(notification));
	}
}

function noteSummaryLink(notification: Notification, note: any, summaryNote: any = note): ViewGraphValue {
	const summary = getNoteSummary(summaryNote);
	return MkA(notePage(note), className: 'mk-vune-notification__text') {
		MkMfm({ text: summary, plain: true, nowrap: true, author: summaryNote?.user })
	}.withProps({ title: summary });
}

function reactionUsers(notification: Notification): ViewGraphValue {
	const value = notification as any;
	if (notification.type === 'reaction:grouped') {
		return HStack(alignment: 'center', spacing: 8) {
			ForEach(value.reactions ?? [], key: (reaction: any) => `${reaction.user.id}:${reaction.reaction}`) { reaction in
				VStack(alignment: 'stretch', spacing: 0) {
					MkAvatar(reaction.user, link: true, preview: true, className: 'mk-vune-notification__reaction-user-avatar')
					VStack(alignment: 'center', spacing: 0) {
						MkReactionIcon(reaction.reaction.replace(/^(:(\w+):)$/, ':$2@.:'), noStyle: true, className: 'mk-vune-notification__reaction-user-icon')
					}.className('mk-vune-notification__reaction-user-badge')
				}.className('mk-vune-notification__reaction-user')
			}
		}.className('mk-vune-notification__reaction-users');
	}
	if (notification.type === 'renote:grouped') {
		return HStack(alignment: 'center', spacing: 8) {
			ForEach(value.users ?? [], key: (user: any) => user.id) { user in
				MkAvatar(user, link: true, preview: true, className: 'mk-vune-notification__reaction-user-avatar')
			}
		}.className('mk-vune-notification__reaction-users');
	}
	return Group() {};
}

function acceptFollowRequest(notification: Notification, done: StateRef<boolean>): void {
	if (!('user' in notification) || notification.user == null) return;
	done.value = true;
	void misskeyApi('following/requests/accept', { userId: notification.user.id });
}

function rejectFollowRequest(notification: Notification, done: StateRef<boolean>): void {
	if (!('user' in notification) || notification.user == null) return;
	done.value = true;
	void misskeyApi('following/requests/reject', { userId: notification.user.id });
}

function notificationBody(notification: Notification, requestDone: StateRef<boolean>): ViewGraphValue {
	const value = notification as any;
	switch (notification.type) {
		case 'reaction':
		case 'reaction:grouped':
			return VStack(alignment: 'stretch', spacing: 8) {
				if (value.note) { noteSummaryLink(notification, value.note) }
				if (notification.type === 'reaction:grouped') { reactionUsers(notification) }
			};
		case 'renote':
		case 'renote:grouped':
			return VStack(alignment: 'stretch', spacing: 8) {
				if (value.note) { noteSummaryLink(notification, value.note, value.note.renote ?? value.note) }
				if (notification.type === 'renote:grouped') { reactionUsers(notification) }
			};
		case 'reply':
		case 'mention':
		case 'quote':
		case 'note':
		case 'pollEnded':
		case 'scheduledNotePosted':
			return value.note ? noteSummaryLink(notification, value.note) : Group() {};
		case 'roleAssigned': return Text(value.role?.name ?? typeLabel(notification)).className('mk-vune-notification__text');
		case 'chatRoomInvitationReceived': return Text(value.invitation?.room?.name ?? typeLabel(notification)).className('mk-vune-notification__text');
		case 'achievementEarned':
			return MkA('/my/achievements', className: 'mk-vune-notification__text') {
				Text((i18n.ts._achievements._types as any)[`_${value.achievement}`]?.title ?? typeLabel(notification))
			};
		case 'exportCompleted': return MkA(`/my/drive/file/${value.fileId}`, className: 'mk-vune-notification__text') { Text(i18n.ts.showFile) };
		case 'createToken':
			return MkA('/settings/apps', className: 'mk-vune-notification__text') {
				MkMfm({ text: i18n.tsx._notification.createTokenDescription({ text: i18n.ts.manageAccessTokens }) })
			};
		case 'follow': return Text(i18n.ts.youGotNewFollower).className(['mk-vune-notification__text', 'mk-vune-notification__text--muted']);
		case 'followRequestAccepted':
			return VStack(alignment: 'stretch', spacing: 4) {
				Text(i18n.ts.followRequestAccepted).className(['mk-vune-notification__text', 'mk-vune-notification__text--muted']);
				if (value.message) {
					HStack(alignment: 'firstTextBaseline', spacing: 4) {
						VuneIcon('ti ti-quote');
						MkMfm({ text: value.message, author: value.user, plain: true, nowrap: true });
					}.className(['mk-vune-notification__text', 'mk-vune-notification__text--muted', 'mk-vune-notification__message']);
				}
			};
		case 'receiveFollowRequest':
			return VStack(alignment: 'stretch', spacing: 8) {
				Text(i18n.ts.receiveFollowRequest).className(['mk-vune-notification__text', 'mk-vune-notification__text--muted']);
				if (!requestDone.value) {
					HStack(alignment: 'center', spacing: 8) {
						MkButton(primary: true, rounded: true, className: 'mk-vune-notification__request-button', onClick: { acceptFollowRequest(notification, requestDone) }) {
							Group() { VuneIcon('ti ti-check'); Text(i18n.ts.accept) }
						}
						MkButton(danger: true, rounded: true, className: 'mk-vune-notification__request-button', onClick: { rejectFollowRequest(notification, requestDone) }) {
							Group() { VuneIcon('ti ti-x'); Text(i18n.ts.reject) }
						}
					}.className('mk-vune-notification__request-actions');
				}
			};
		case 'test': return Text(i18n.ts._notification.notificationWillBeDisplayedLikeThis).className('mk-vune-notification__text');
		case 'app': return MkMfm({ text: value.body ?? '', nowrap: false }).className('mk-vune-notification__text');
		case 'scheduledNotePostFailed': return Text(typeLabel(notification)).className(['mk-vune-notification__text', 'mk-vune-notification__text--warning']);
		default: return Group() {};
	}
}

export struct MkNotification: View {
	let notification: Notification
	let requestDone: StateRef<boolean>

	init(_ notification: Notification) {
		self.notification = notification
		self.requestDone = followRequestState(notification.id)
	}

	var body: some View {
		HStack(alignment: 'top', spacing: 8) {
			notificationHead(notification)
			VStack(alignment: 'stretch', spacing: 4) {
				HStack(alignment: 'firstTextBaseline', spacing: 8) {
					notificationTitle(notification)
					MkTimeValue(notification.createdAt, className: 'mk-vune-notification__time')
				}.className('mk-vune-notification__header')
				notificationBody(notification, requestDone)
			}.className('mk-vune-notification__body')
		}.className('mk-vune-notification')
	}
}

export default MkNotification
