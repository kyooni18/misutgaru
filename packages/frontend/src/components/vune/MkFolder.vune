import { Group, VStack, type ViewGraphValue } from 'vune-ui';
import VuneIcon from '@/vune/Icon.vune';
import MkButton from './MkButton.vune';

function toggleFolder(open: any): void { open.value = !open.value; }

export struct MkFolder: View {
	let defaultOpen: boolean
	let className: string
	let header: ViewGraphValue
	let content: ViewGraphValue
	@State var open: boolean = true

	init(defaultOpen: boolean = true, className: string = '', header: ViewGraphValue = null, @ViewBuilder content: () => ViewGraphValue) {
		self.defaultOpen = defaultOpen
		self.className = className
		self.header = header
		self.content = content()
	}

	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			MkButton(transparent: true, className: 'mk-vune-folder__header', onClick: { toggleFolder(open) }) {
				Group() {
					header
					VuneIcon(open.value ? 'ti ti-chevron-up' : 'ti ti-chevron-down')
				}
			}
				.withProps({ 'aria-expanded': open.value })
			if (open.value) { VStack(alignment: 'leading', spacing: 0) { content }.className('mk-vune-folder__body') }
		}.className(['mk-vune-folder', className])
	}
}

export default MkFolder
