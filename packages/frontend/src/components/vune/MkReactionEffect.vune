import { VStack, Animation } from 'vune-ui';
import MkReactionIcon from './MkReactionIcon.vune';

export struct MkReactionEffect: View {
	let reaction: string
	let x: number
	let y: number
	let zIndex: number
	let up: boolean
	let angle: string
	let rootClass: string
	let textClass: string
	let upClass: string

	init(
		_ reaction: string,
		x: number,
		y: number,
		zIndex: number,
		up: boolean = false,
		angle: string,
		rootClass: string,
		textClass: string,
		upClass: string,
	) {
		self.reaction = reaction
		self.x = x
		self.y = y
		self.zIndex = zIndex
		self.up = up
		self.angle = angle
		self.rootClass = rootClass
		self.textClass = textClass
		self.upClass = upClass
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 0) { MkReactionIcon(reaction, className: 'icon') }
				.className([textClass, up ? upClass : null])
				.style(up ? { transform: `translateY(-50px) rotateZ(${angle})` } : undefined)
				.animation(Animation.easeInOut(1), value: up),
		}
			.className(rootClass)
			.style({ zIndex, top: `${y - 64}px`, left: `${x - 64}px` })
	}
}

export default MkReactionEffect
