import { Group, HStack, NavigationLink, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import { i18n } from '@/i18n.js';
import { acct, userPage } from '@/filters/user.js';
import VuneIcon from '@/vune/Icon.vune';

export struct MkAccountMoved: View {
	let user: Misskey.entities.UserLite | undefined
	let rootClass: string | undefined
	let linkClass: string | undefined

	init(_ user: Misskey.entities.UserLite | undefined = undefined, rootClass: string | undefined = undefined, linkClass: string | undefined = undefined) {
		self.user = user
		self.rootClass = rootClass
		self.linkClass = linkClass
	}

	var body: some View {
		Group() {
			if (user) {
				HStack(alignment: 'center', spacing: 8) {
					VuneIcon('ti ti-plane-departure')
					Text(i18n.ts.accountMoved)
					NavigationLink(userPage(user), `@${acct(user)}`)
						.className(linkClass)
				}
					.className(rootClass)
			}
		}
	}
}

export default MkAccountMoved
