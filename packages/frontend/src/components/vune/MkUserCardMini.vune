/* @misutgaru-vune-native */
import { VStack, Group, Text, type ViewGraphValue } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import ComputedMiniChart from '@/vune/ComputedMiniChart.vune';
import { acct } from '@/filters/user.js';
import './MkUserCardMini.scss';

type Props = {
	user: Misskey.entities.User;
	chartValues?: number[] | null;
	avatarClass?: string;
	bodyClass?: string;
	nameClass?: string;
	subClass?: string;
	chartClass?: string;
	sub?: ViewGraphValue;
};

export struct MkUserCardMini: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		Group() {
			MkAvatar(props.user, indicator: true, className: props.avatarClass ?? 'mk-vune-user-card-mini__avatar'),
			VStack(alignment: 'leading', spacing: 0) {
				VStack(alignment: 'leading', spacing: 0) { MkUserName({ user: props.user }) }.className(props.nameClass ?? 'mk-vune-user-card-mini__name')
				VStack(alignment: 'leading', spacing: 0) {
					if (props.sub) { props.sub }
					else { Text(`@${acct(props.user)}`).className('_monospace') }
				}.className(props.subClass ?? 'mk-vune-user-card-mini__sub')
			}.className(props.bodyClass ?? 'mk-vune-user-card-mini__body')
			if (props.chartValues && props.chartValues.length > 0) { ComputedMiniChart(props.chartValues, gradientId: `mk-vune-user-card-${props.user.id}`, className: props.chartClass ?? 'mk-vune-user-card-mini__chart') }
		}
	}
}

export default MkUserCardMini
