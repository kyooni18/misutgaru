import { htmlElement } from '@/vune/native.js';
import type * as Misskey from 'misskey-js';
import MkMiniChart from './MkMiniChart.vune';
import { getProxiedImageUrlNullable } from '@/utility/media-proxy.js';
import '@/vune/phase6-migration.scss';

type Props = {
	instance: Misskey.entities.FederationInstance;
	chartValues?: number[] | null;
};

function getInstanceIcon(instance: Misskey.entities.FederationInstance): string {
	return getProxiedImageUrlNullable(instance.iconUrl, 'preview')
		?? getProxiedImageUrlNullable(instance.faviconUrl, 'preview')
		?? '/client-assets/dummy.png';
}

function miniChart(values: number[], instanceId: string) {
	let viewBoxX = 50;
	let viewBoxY = 50;
	let stats = values.slice().reverse();
	let peak = Math.max.apply(null, stats) || 1;
	let step = stats.length > 1 ? viewBoxX / (stats.length - 1) : 0;
	let points = stats.map((value, index) => [
		index * step,
		(1 - (value / peak)) * viewBoxY,
	]);
	let polylinePoints = points.map(xy => `${xy[0]},${xy[1]}`).join(' ');
	let polygonPoints = `0,${viewBoxY} ${polylinePoints} ${viewBoxX},${viewBoxY}`;
	let head = points.at(-1);
	return MkMiniChart(
		viewBoxX: viewBoxX,
		viewBoxY: viewBoxY,
		gradientId: `mk-vune-instance-chart-${instanceId}`,
		color: 'var(--MI_THEME-accent)',
		polygonPoints: polygonPoints,
		polylinePoints: polylinePoints,
		headX: head?.[0],
		headY: head?.[1],
		className: 'mk-vune-instance-mini__chart',
	);
}

export struct MkInstanceCardMini: View {
	let instance: Misskey.entities.FederationInstance
	let chartValues: number[] | null | undefined

	init(_ instance: Misskey.entities.FederationInstance, _ chartValues: number[] | null | undefined = undefined) {
		self.instance = instance
		self.chartValues = chartValues
	}

	var body: some View {
		htmlElement('div', { style: { display: 'contents' } },
			htmlElement('div', {
				className: [
					'mk-vune-instance-mini',
					instance.isNotResponding ? 'mk-vune-instance-mini--yellow' : null,
					instance.isBlocked ? 'mk-vune-instance-mini--red' : null,
					instance.isSuspended ? 'mk-vune-instance-mini--gray' : null,
					instance.isSilenced ? 'mk-vune-instance-mini--blue' : null,
				],
			},
				htmlElement('img', { className: 'mk-vune-instance-mini__icon', src: getInstanceIcon(instance), alt: '', loading: 'lazy' }),
				htmlElement('div', { className: 'mk-vune-instance-mini__body' },
					htmlElement('span', { className: 'mk-vune-instance-mini__host' }, instance.name ?? instance.host),
					htmlElement('span', { className: 'mk-vune-instance-mini__sub _monospace' },
						htmlElement('b', {}, instance.host),
						` / ${instance.softwareName || '?'} ${instance.softwareVersion}`,
					),
				),
				chartValues && chartValues.length > 0 ? miniChart(chartValues, instance.id) : null,
			),
		)
	}
}

export default MkInstanceCardMini
