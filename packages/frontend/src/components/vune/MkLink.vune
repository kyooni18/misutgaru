/* @misutgaru-vune-native */
import { Link, Text, type ViewGraphValue } from 'vune-ui';
export struct MkLink: View {
	let url: string
	let content: ViewGraphValue
	init(_ url: string, @ViewBuilder content: () => ViewGraphValue = { Text(url) }) { self.url = url; self.content = content() }
	var body: some View { Link(url, url).overlay(content).className('mk-vune-link') }
}
export default MkLink
