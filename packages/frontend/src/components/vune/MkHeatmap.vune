/* @misutgaru-vune-native */
import { VStack, ForEach } from 'vune-ui';

export struct MkHeatmap: View {
	let values: number[]
	init(_ values: number[] = []) { self.values = values }
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			ForEach((values.length > 0 ? values : Array.from({ length: 84 }, () => 0)), key: (_value, index) => index) { value in
				VStack(alignment: 'stretch', spacing: 0).className('mk-vune-heatmap__cell').opacity(Math.max(0.08, Math.min(1, Number(value) || 0)))
			}
	}.className('mk-vune-heatmap').style({ display: 'grid', gridTemplateColumns: 'repeat(12, 1fr)', gap: '2px' })
	}
}

export default MkHeatmap
