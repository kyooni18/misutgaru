/* @misutgaru-vune-native */
import { Group, HStack, Text } from 'vune-ui';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import './misskey-vune.scss';

function ignoreFooterAction(): void {}

export struct MkFormFooter: View {
	let modified: boolean
	let modifiedCount: number
	let canSaving: boolean
	let onDiscard: () => void
	let onSave: () => void

	init(
		_ modified: boolean,
		modifiedCount: number,
		canSaving: boolean = true,
		@Action onDiscard: () => void = ignoreFooterAction,
		@Action onSave: () => void = ignoreFooterAction,
	) {
		self.modified = modified
		self.modifiedCount = modifiedCount
		self.canSaving = canSaving
		self.onDiscard = onDiscard
		self.onSave = onSave
	}

	var body: some View {
		Group() {
			if (modified) {
				HStack(alignment: 'center', spacing: 8) {
					Text(i18n.tsx.thereAreNChanges({ n: modifiedCount }))
						.className('mk-vune-form-footer__text')
					HStack(alignment: 'center', spacing: 8) {
						MkButton(danger: true, rounded: true, onClick: { onDiscard() }) {
							Group() {
								Text('').className('ti ti-x').withProps({ 'aria-hidden': true })
								Text(` ${i18n.ts.discard}`)
							}
						},
						MkButton(primary: true, rounded: true, disabled: !canSaving, onClick: { onSave() }) {
							Group() {
								Text('').className('ti ti-check').withProps({ 'aria-hidden': true })
								Text(` ${i18n.ts.save}`)
							}
						}
					}.className('_buttons mk-vune-form-footer__buttons')
				}
					.style({ justifyContent: 'flex-start' })
					.className('mk-vune-form-footer')
			}
		}
	}
}

export default MkFormFooter
