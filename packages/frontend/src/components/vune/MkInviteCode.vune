import { Element, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkFolder from '@/components/MkFolder.vue';
import MkButton from '@/components/MkButton.vue';
import MkAvatar from '@/components/global/MkAvatar.vue';
import MkUserName from '@/components/global/MkUserName.vue';
import MkTime from '@/components/global/MkTime.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent, vuneBoolean } from '@/vune/vue.js';

type Props = {
	invite: Misskey.entities.InviteCode;
	moderator?: boolean;
	isExpired?: boolean;
	classes: Record<string, string>;
	onDelete?: () => void;
	onCopy?: () => void;
};

export default createVuneComponent<Props>((props) => {
	const invite = props.invite;
	const moderator = vuneBoolean(props.moderator);
	const expired = vuneBoolean(props.isExpired);

	return VueComponent(MkFolder, {}, {
		label: () => Text(invite.code),
		suffix: () => invite.used
			? Text(i18n.ts.used)
			: expired
				? Element('span', { style: { color: 'var(--MI_THEME-error)' } }, i18n.ts.expired)
				: Element('span', { style: { color: 'var(--MI_THEME-success)' } }, i18n.ts.unused),
		footer: () => Element('div', { className: '_buttons' },
			!invite.used && !expired ? VueComponent(MkButton, { primary: true, rounded: true, onClick: () => props.onCopy?.() }, {
				default: () => Group() { Element('i', { className: 'ti ti-copy' }); ` ${i18n.ts.copy}` },
			}) : null,
			!invite.used || moderator ? VueComponent(MkButton, { danger: true, rounded: true, onClick: () => props.onDelete?.() }, {
				default: () => Group() { Element('i', { className: 'ti ti-trash' }); ` ${i18n.ts.delete}` },
			}) : null,
		),
		default: () => Element('div', { className: props.classes.root },
			Element('div', { className: props.classes.items },
				Element('div', {},
					Element('div', { className: props.classes.label }, i18n.ts.invitationCode),
					Element('div', { className: '_selectableAtomic' }, invite.code),
				),
				moderator ? Element('div', {},
					Element('div', { className: props.classes.label }, i18n.ts.inviteCodeCreator),
					invite.createdBy ? Element('div', { className: props.classes.user },
						VueComponent(MkAvatar, { user: invite.createdBy, class: props.classes.avatar, link: true, preview: true }),
						VueComponent(MkUserName, { user: invite.createdBy, nowrap: false }),
						Element('div', {}, `(${invite.createdBy.id})`),
					) : Element('div', {}, 'system'),
				) : null,
				invite.used ? Element('div', {},
					Element('div', { className: props.classes.label }, i18n.ts.registeredUserUsingInviteCode),
					invite.usedBy ? Element('div', { className: props.classes.user },
						VueComponent(MkAvatar, { user: invite.usedBy, class: props.classes.avatar, link: true, preview: true }),
						VueComponent(MkUserName, { user: invite.usedBy, nowrap: false }),
						moderator ? Element('div', {}, `(${invite.usedBy.id})`) : null,
					) : Element('div', {}, `${i18n.ts.unknown} (${i18n.ts.waitingForMailAuth})`),
				) : null,
				invite.expiresAt && !invite.used ? Element('div', {},
					Element('div', { className: props.classes.label }, i18n.ts.expirationDate),
					Element('div', {}, VueComponent(MkTime, { time: invite.expiresAt, mode: 'absolute' })),
				) : null,
				invite.usedAt ? Element('div', {},
					Element('div', { className: props.classes.label }, i18n.ts.inviteCodeUsedAt),
					Element('div', {}, VueComponent(MkTime, { time: invite.usedAt, mode: 'absolute' })),
				) : null,
				moderator ? Element('div', {},
					Element('div', { className: props.classes.label }, i18n.ts.createdAt),
					Element('div', {}, VueComponent(MkTime, { time: invite.createdAt, mode: 'absolute' })),
				) : null,
			),
		),
	});
});
