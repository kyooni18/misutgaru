import { VStack, Image, Text } from 'vune-ui';
import * as game from '@/utility/clicker-game.js';
import number from '@/filters/number.js';
import { claimAchievement } from '@/utility/achievements.js';
import MkButton from './MkButton.vune';

function loadClicker(loaded: any) {
	return (element: HTMLElement | null) => {
		if (!element || loaded.value) return;
		void game.load().then(() => { loaded.value = true; });
	};
}

function clickCookie(): void {
	if (!game.saveData.value) return;
	game.saveData.value.cookies += 1;
	game.saveData.value.totalCookies += 1;
	game.saveData.value.totalHandmadeCookies += 1;
	game.saveData.value.clicked += 1;
	if (game.saveData.value.cookies === 1) claimAchievement('cookieClicked');
}

export struct MkClickerGame: View {
	@State var loaded: boolean = false
	init() {}
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			if (!loaded.value || !game.saveData.value) {
				Text('…')
			} else {
				Text(number(game.saveData.value.cookies)).className('mk-vune-clicker__count').withProps({ 'data-testid': 'count' })
				MkButton(transparent: true, className: 'mk-vune-clicker__button', onClick: { clickCookie() }) {
					Image('/client-assets/cookie.png', { alt: 'Cookie' }).className('mk-vune-clicker__image')
				}
			}
		}.className('mk-vune-clicker__game').elementRef(loadClicker(loaded))
	}
}

export default MkClickerGame
