/* @misutgaru-vune-native */
import { VStack, ForEach, Text } from 'vune-ui';
import type { IPaginator } from '@/utility/paginator.js';
import MkPagination from './MkPagination.vune';
export struct MkFileListForAdmin: View {
	let paginator: IPaginator
	let viewMode: string
	init(_ paginator: IPaginator, viewMode: string = 'list') { self.paginator = paginator; self.viewMode = viewMode }
	var body: some View {
		MkPagination(paginator) { VStack(alignment: 'stretch', spacing: 0) { ForEach(paginator.items.value as any[], key: item => item.id) { item in Text(item.name ?? item.id).className('_panel') } }.className('_gaps_s') }
	}
}
export default MkFileListForAdmin
