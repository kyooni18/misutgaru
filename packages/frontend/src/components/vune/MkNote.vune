import type * as Misskey from 'misskey-js';
import MkNoteSimple from './MkNoteSimple.vune';
import './MkNote.scss';

const noteClasses = {
	root: 'mk-vune-note-native',
	deleted: 'mk-vune-note-native__deleted',
	avatar: 'mk-vune-note-native__avatar',
	useSticky: 'mk-vune-note-native__avatar--sticky',
	main: 'mk-vune-note-native__main',
	header: 'mk-vune-note-native__header',
	cw: 'mk-vune-note-native__cw',
	text: 'mk-vune-note-native__text',
};

export struct MkNote: View {
	let note: Misskey.entities.Note | null
	let showContent: boolean
	let className: string

	init(_ note: Misskey.entities.Note | null, showContent: boolean = true, className: string = '') {
		self.note = note
		self.showContent = showContent
		self.className = className
	}

	var body: some View {
		MkNoteSimple({ note, showContent, showCwMedia: true, useStickyIcons: true, classes: noteClasses })
			.className(className)
	}
}

export default MkNote
