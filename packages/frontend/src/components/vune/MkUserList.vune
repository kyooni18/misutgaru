/* @misutgaru-vune-native */
import { ForEach, Group } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import type { IPaginator, ExtractorFunction } from '@/utility/paginator.js';
import MkUserInfo from '@/components/vune/MkUserInfo.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import { i18n } from '@/i18n.js';
import '@/vune/phase5-migration.scss';

type Props = { paginator: IPaginator; noGap?: boolean; extractor?: ExtractorFunction<any, Misskey.entities.UserDetailed> };
type UserRow = { key: string; user: Misskey.entities.UserDetailed };

function rows(props: Props): UserRow[] {
	const extractor = props.extractor ?? ((item: any) => item as Misskey.entities.UserDetailed);
	return (props.paginator.items.value as any[]).map((item, index) => {
		const user = extractor(item);
		return { key: user.id || String(index), user };
	});
}

export struct MkUserList: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		return MkPagination(props.paginator, empty: MkResult('empty', text: i18n.ts.noUsers)) {
			Group() {
				ForEach(rows(props), key: row => row.key) { row in MkUserInfo({ user: row.user }) }
			}.className(['mk-vune-user-list', props.noGap ? 'mk-vune-user-list--no-gap' : null])
		}
	}
}
export default MkUserList
