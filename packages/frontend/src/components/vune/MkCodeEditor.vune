/* @misutgaru-vune-native */
import { Binding, TextEditor } from 'vune-ui';

export struct MkCodeEditor: View {
	let value: string
	let onChange: (value: string) => void
	init(_ value: string | null | undefined, @Action onChange: (value: string) => void = () => {}) { self.value = value ?? ''; self.onChange = onChange }
	var body: some View { TextEditor(Binding(() => value, onChange)).className('mk-vune-code-editor _monospace') }
}

export default MkCodeEditor
