import { VStack, Text } from 'vune-ui';
import MkA from '@/components/global/vune/MkA.vune';
import MkButton from '@/components/vune/MkButton.vune';
import VuneIcon from '@/vune/Icon.vune';
import { host } from '@@/js/config.js';
import { i18n } from '@/i18n.js';
import { instance } from '@/instance.js';
type Props = { zIndex:number|string; onClose?:()=>void };
function closePrompt(props:Props):void{props.onClose?.()}
export struct VuneMkSourceCodeAvailablePopupView: View {
 let props: Props
 init(_ props:Props){self.props=props}
 var body: some View {
  VStack(alignment: 'stretch', spacing: 0) {
   VStack(alignment: 'stretch', spacing: 0) { VuneIcon('ti ti-brand-open-source').fontSize('40px') }.className('mk-vune-bottom-prompt__icon')
   VStack(alignment: 'stretch', spacing: 0) {
    Text(`${i18n.ts.aboutX.replace('{x}', instance.name ?? host)}`).className('mk-vune-bottom-prompt__title')
    VStack(alignment: 'stretch', spacing: 0) { Text(i18n.ts._aboutMisskey.thisIsModifiedVersion.replace('{name}', instance.name ?? host)); Text(' '); Text(i18n.ts.correspondingSourceIsAvailable); Text(' '); MkA('/about-misskey', className:'_link') { Text(i18n.ts.aboutMisskey) } }.className('mk-vune-bottom-prompt__text')
    MkButton(onClick:{closePrompt(props)}) { Text(i18n.ts.gotIt) }
   }.className('mk-vune-bottom-prompt__main')
   MkButton(transparent:true, iconOnly:true, className:'mk-vune-bottom-prompt__close', onClick:{closePrompt(props)}) { VuneIcon('ti ti-x') }
  }.className('_acrylic _shadow mk-vune-bottom-prompt').style({zIndex:String(props.zIndex)})
 }
}
export default VuneMkSourceCodeAvailablePopupView
