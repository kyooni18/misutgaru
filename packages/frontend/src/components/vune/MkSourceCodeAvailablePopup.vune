import { Element, Text } from 'vune-ui';
import I18n from '@/components/global/I18n.vue';
import MkA from '@/components/global/MkA.vue';
import MkButton from '@/components/MkButton.vue';
import { host } from '@@/js/config.js';
import { i18n } from '@/i18n.js';
import { instance } from '@/instance.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';
import '@/vune/phase6-migration.scss';

type Props = {
	zIndex: number | string;
	onClose?: () => void;
};

function sourceIcon() {
	return Element('i', { className: 'ti ti-brand-open-source', style: { fontSize: '40px' } });
}

export default createVuneComponent<Props>((props) =>
	Element('div', {
		className: '_panel _shadow mk-vune-bottom-prompt',
		style: { zIndex: String(props.zIndex) },
	},
		Element('div', { className: 'mk-vune-bottom-prompt__icon' }, sourceIcon()),
		Element('div', { className: 'mk-vune-bottom-prompt__main' },
			Element('div', { className: 'mk-vune-bottom-prompt__title' },
				VueComponent(I18n, { src: i18n.ts.aboutX, tag: 'span' }, {
					x: () => Text(instance.name ?? host),
				}),
			),
			Element('div', { className: 'mk-vune-bottom-prompt__text' },
				VueComponent(I18n, { src: i18n.ts._aboutMisskey.thisIsModifiedVersion, tag: 'span' }, {
					name: () => Text(instance.name ?? host),
				}),
				VueComponent(I18n, { src: i18n.ts.correspondingSourceIsAvailable, tag: 'span' }, {
					anchor: () => VueComponent(MkA, { to: '/about-misskey', class: '_link' }, {
						default: () => Text(i18n.ts.aboutMisskey),
					}),
				}),
			),
			Element('div', { className: '_buttons' },
				VueComponent(MkButton, { onClick: () => props.onClose?.() }, {
					default: () => Text(i18n.ts.gotIt),
				}),
			),
		),
		Element('button', {
			className: '_button mk-vune-bottom-prompt__close',
			onClick: () => props.onClose?.(),
		}, Element('i', { className: 'ti ti-x' })),
	)
);
