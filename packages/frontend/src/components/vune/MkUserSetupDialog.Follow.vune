/* @misutgaru-vune-native */
import { VStack, ForEach, Text } from 'vune-ui';
import MkFolder from '@/components/vune/MkFolder.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import XUser from '@/components/vune/MkUserSetupDialog.User.vune';
import { i18n } from '@/i18n.js';
import type { IPaginator } from '@/utility/paginator.js';
const classes={banner:'mk-vune-setup-user__banner',avatar:'mk-vune-setup-user__avatar',title:'mk-vune-setup-user__title',name:'mk-vune-setup-user__name',username:'mk-vune-setup-user__username',description:'mk-vune-setup-user__description',mfm:'mk-vune-setup-user__mfm',footer:'mk-vune-setup-user__footer'};
struct SetupUserFolder: View {
	let label: string
	let paginator: IPaginator
	var body: some View {
		MkFolder(header: Text(label)) {
			MkPagination(paginator) {
				VStack(alignment: 'leading', spacing: 0) {
					ForEach(paginator.items.value as any[], key: item => item.id) { item in XUser({ user: item, classes }) }
				}.className('mk-vune-follow-setup-grid')
			}
		}
	}
}
type Props={pinnedUsersPaginator:IPaginator;popularUsersPaginator:IPaginator};
export struct VuneMkUserSetupDialogFollowView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { VStack(alignment: 'leading', spacing: 0){Text(i18n.ts._initialAccountSetting.followUsers).multilineTextAlignment('center');SetupUserFolder(label:i18n.ts.recommended,paginator:props.pinnedUsersPaginator);SetupUserFolder(label:i18n.ts.popularUsers,paginator:props.popularUsersPaginator)}.className('_gaps') } }
export default VuneMkUserSetupDialogFollowView
