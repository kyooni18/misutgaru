/* @misutgaru-vune-native */
import { VStack } from 'vune-ui';
import MaterialSurface from '@/vune/MaterialSurface.vune';
import { Material } from '@/vune/material.js';
import { createVuneComponent, VueSlot } from '@/vune/vue.js';

type Props = {
	class?: string;
	style?: string | Record<string, unknown>;
};

/** Material-backed shell for the legacy post form while its controls migrate. */
export default createVuneComponent<Props>((props, slots) =>
	MaterialSurface(Material.regular, opaqueBackground: 'var(--MI_THEME-bg)', animated: true) {
		VStack(spacing: 0) {
			VueSlot(slots.default)
		}
			.style({ width: '100%', minWidth: 0, alignItems: 'stretch' })
	}
		.className(['mk-vune-post-form-surface', props.class])
		.style({ width: '100%', minWidth: 0, alignSelf: 'stretch' })
		.withProps({ style: props.style }),
);
