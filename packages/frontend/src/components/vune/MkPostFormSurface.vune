import { VStack, type ViewGraphValue } from 'vune-ui';
import MaterialSurface from '@/vune/MaterialSurface.vune';
import { Material } from '@/vune/material.js';

/** Material-backed shell shared by native and legacy post-form placement. */
export struct MkPostFormSurface: View {
	let className: string
	let style: any
	let content: ViewGraphValue

	init(
		className: string = '',
		style: any = undefined,
		@ViewBuilder content: () => ViewGraphValue,
	) {
		self.className = className
		self.style = style
		self.content = content()
	}

	var body: some View {
		MaterialSurface(Material.regular, opaqueBackground: 'var(--MI_THEME-bg)', animated: true) {
			VStack(spacing: 0) {
				content
			}
				.style({ width: '100%', minWidth: 0, alignItems: 'stretch' })
		}
			.className(['mk-vune-post-form-surface', className])
			.style({ width: '100%', minWidth: 0, alignSelf: 'stretch' })
			.withProps({ style })
	}
}

export default MkPostFormSurface
