import { VStack, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkNote from '@/components/vune/MkNote.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = {
	phase: 'aboutNote' | 'howToReact';
	exampleNote: Misskey.entities.Note;
	onceReacted?: boolean;
	classes: Record<string, string>;
	onReaction?: (emoji: string) => void;
	onRemoveReaction?: (emoji: string) => void;
};

function react(props: Props, emoji: string): void { props.onReaction?.(emoji); }

struct TutorialNoteGuide: View {
	let icon: string
	let label: string
	let text: string
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) { VuneIcon(icon); Text(' '); Text(label).bold(); Text(` … ${text}`) }
	}
}

export struct VuneMkTutorialDialogNoteView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		Group() {
			if (props.phase === 'aboutNote') {
				VStack(alignment: 'stretch', spacing: 0) {
					Text(i18n.ts._initialTutorial._note.description).multilineTextAlignment('center').padding({ horizontal: 16 })
					MkNote(props.exampleNote, className: props.classes.exampleNoteRoot).allowsHitTesting(false)
					VStack(alignment: 'stretch', spacing: 0) {
						TutorialNoteGuide(icon: 'ti ti-arrow-back-up', label: i18n.ts.reply, text: i18n.ts._initialTutorial._note.reply)
						TutorialNoteGuide(icon: 'ti ti-repeat', label: i18n.ts.renote, text: i18n.ts._initialTutorial._note.renote)
						TutorialNoteGuide(icon: 'ti ti-plus', label: i18n.ts.reaction, text: i18n.ts._initialTutorial._note.reaction)
						TutorialNoteGuide(icon: 'ti ti-dots', label: i18n.ts.menu, text: i18n.ts._initialTutorial._note.menu)
					}.className('_gaps_s')
				}.className('_gaps')
			} else {
				VStack(alignment: 'stretch', spacing: 0) {
					Text(i18n.ts._initialTutorial._reaction.description).multilineTextAlignment('center').padding({ horizontal: 16 })
					Text(i18n.ts._initialTutorial._reaction.letsTryReacting)
					MkNote(props.exampleNote, className: props.classes.exampleNoteRoot)
					MkButton(primary: true, inline: true, onClick: { react(props, '👍') }) { Text('👍') }
					if (props.onceReacted === true) { VStack(alignment: 'stretch', spacing: 0) { Group() { VuneIcon('ti ti-check'); Text(` ${i18n.ts._initialTutorial.wellDone}`).bold() }.foregroundStyle('var(--MI_THEME-accent)'); Text(` ${i18n.ts._initialTutorial._reaction.reactNotification}`); Text(i18n.ts._initialTutorial._reaction.reactDone) } }
				}.className('_gaps')
			}
		}
	}
}

export default VuneMkTutorialDialogNoteView
