import { Element, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkNote from '@/components/MkNote.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent, vuneBoolean } from '@/vune/vue.js';

type Props = {
	phase: 'aboutNote' | 'howToReact';
	exampleNote: Misskey.entities.Note;
	onceReacted?: boolean;
	classes: Record<string, string>;
	onReaction?: (emoji: string) => void;
	onRemoveReaction?: (emoji: string) => void;
};

function guide(icon: string, label: string, text: string) {
	return Element('div', {},
		Element('i', { className: icon }),
		' ',
		Element('b', {}, label),
		` … ${text}`,
	);
}

export default createVuneComponent<Props>((props) => {
	if (props.phase === 'aboutNote') {
		return Element('div', { className: '_gaps' },
			Element('div', { style: { textAlign: 'center', padding: '0 16px' } }, i18n.ts._initialTutorial._note.description),
			VueComponent(MkNote, {
				class: props.classes.exampleNoteRoot,
				style: 'pointer-events: none;',
				note: props.exampleNote,
				mock: true,
			}),
			Element('div', { className: '_gaps_s' },
				guide('ti ti-arrow-back-up', i18n.ts.reply, i18n.ts._initialTutorial._note.reply),
				guide('ti ti-repeat', i18n.ts.renote, i18n.ts._initialTutorial._note.renote),
				guide('ti ti-plus', i18n.ts.reaction, i18n.ts._initialTutorial._note.reaction),
				guide('ti ti-dots', i18n.ts.menu, i18n.ts._initialTutorial._note.menu),
			),
		);
	}

	return Element('div', { className: '_gaps' },
		Element('div', { style: { textAlign: 'center', padding: '0 16px' } }, i18n.ts._initialTutorial._reaction.description),
		Element('div', {}, i18n.ts._initialTutorial._reaction.letsTryReacting),
		VueComponent(MkNote, {
			class: props.classes.exampleNoteRoot,
			note: props.exampleNote,
			mock: true,
			onReaction: (emoji: string) => props.onReaction?.(emoji),
			onRemoveReaction: (emoji: string) => props.onRemoveReaction?.(emoji),
		}),
		vuneBoolean(props.onceReacted) ? Element('div', {},
			Element('b', { style: { color: 'var(--MI_THEME-accent)' } },
				Element('i', { className: 'ti ti-check' }),
				` ${i18n.ts._initialTutorial.wellDone}`,
			),
			` ${i18n.ts._initialTutorial._reaction.reactNotification}`,
			Element('br'),
			Text(i18n.ts._initialTutorial._reaction.reactDone),
		) : null,
	);
});
