/* @misutgaru-vune-native */
import { Animation, HStack, Spacer, Text, VStack, ZStack, type ViewGraphValue } from 'vune-ui';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
import MkButton from './MkButton.vune';
import './MkContainer.scss';

function ignoreContainerAction(): void {}

function resolvedContentHeight(
	showBody: boolean,
	contentHeight: number | null,
	omitted: boolean,
	maxHeight: number | null,
): number | null {
	if (!showBody) return 0;
	if (contentHeight == null) return null;
	const height = Math.max(0, contentHeight);
	return omitted ? Math.min(height, maxHeight ?? Infinity) : height;
}

export struct MkContainer: View {
	let showHeader: boolean
	let thin: boolean
	let naked: boolean
	let foldable: boolean
	let scrollable: boolean
	let showBody: boolean
	let omitted: boolean
	let maxHeight: number | null
	let contentHeight: number | null
	let headerHeight: number
	let animated: boolean
	let className: string
	let style: any
	let testId: string
	let dataTransparent: unknown
	let onToggle: () => void
	let onShowMore: () => void
	let icon: ViewGraphValue
	let header: ViewGraphValue
	let func: ViewGraphValue
	let content: ViewGraphValue
	let resolvedHeight: number | null

	init(
		showHeader: boolean = true,
		thin: boolean = false,
		naked: boolean = false,
		foldable: boolean = false,
		scrollable: boolean = false,
		showBody: boolean = true,
		omitted: boolean = false,
		maxHeight: number | null = null,
		contentHeight: number | null = null,
		headerHeight: number = 0,
		animated: boolean = false,
		className: string = '',
		style: any = undefined,
		testId: string = '',
		dataTransparent: unknown = undefined,
		@Action onToggle: () => void = ignoreContainerAction,
		@Action onShowMore: () => void = ignoreContainerAction,
		icon: ViewGraphValue = null,
		header: ViewGraphValue = null,
		func: ViewGraphValue = null,
		@ViewBuilder content: () => ViewGraphValue,
	) {
		self.showHeader = showHeader
		self.thin = thin
		self.naked = naked
		self.foldable = foldable
		self.scrollable = scrollable
		self.showBody = showBody
		self.omitted = omitted
		self.maxHeight = maxHeight
		self.contentHeight = contentHeight
		self.headerHeight = headerHeight
		self.animated = animated
		self.className = className
		self.style = style
		self.testId = testId
		self.dataTransparent = dataTransparent
		self.onToggle = onToggle
		self.onShowMore = onShowMore
		self.icon = icon
		self.header = header
		self.func = func
		self.content = content()
		self.resolvedHeight = resolvedContentHeight(showBody, contentHeight, omitted, maxHeight)
	}

	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			if (showHeader) {
				HStack(alignment: 'center', spacing: 8) {
					HStack(alignment: 'center', spacing: 6) {
						ZStack(alignment: 'center') { icon }.className('mk-vune-container__title-icon')
						header
					}.className('mk-vune-container__title')
					Spacer()
					HStack(alignment: 'center', spacing: 4) {
						func
						if (foldable) {
							MkButton(transparent: true, iconOnly: true, className: 'mk-vune-container__header-button', onClick: { onToggle() }) { VuneIcon(showBody ? 'ti ti-chevron-up' : 'ti ti-chevron-down') }
								.withProps({ 'aria-expanded': showBody })
						}
					}.className('mk-vune-container__header-sub')
				}
					.className('mk-vune-container__header')
					.withProps({ 'data-vune-container-header': true })
			}
			VStack(alignment: 'leading', spacing: 0) {
				VStack(alignment: 'leading', spacing: 0) {
					content
					if (omitted) {
							MkButton(transparent: true, className: 'mk-vune-container__fade', onClick: { onShowMore() }) { Text(i18n.ts.showMore).className('mk-vune-container__fade-label') }
					}
				}
					.className(['mk-vune-container__content', omitted ? 'mk-vune-container__content--omitted' : null])
					.withProps({ 'data-vune-container-content': true })
					.style({
						'--mk-vune-container-max-height': maxHeight == null ? undefined : `${maxHeight}px`,
						maxHeight: omitted && maxHeight != null ? `${maxHeight}px` : undefined,
						overflow: scrollable ? 'auto' : undefined,
					})
			}
				.className('mk-vune-container__body')
				.withProps({ 'aria-hidden': !showBody, 'data-vune-container-body': true })
				.style({
					height: resolvedHeight == null ? undefined : `${resolvedHeight}px`,
					opacity: showBody ? 1 : 0,
					overflowY: 'clip',
				})
				.animation(animated ? Animation.easeInOut(0.5) : null, value: `${showBody}:${resolvedHeight ?? 'auto'}:${omitted}`)
		}
			.className([
				'_panel',
				'mk-vune-container',
				className,
				naked ? 'mk-vune-container--naked' : null,
				thin ? 'mk-vune-container--thin' : null,
				scrollable ? 'mk-vune-container--scrollable' : null,
			])
			.style(style ?? {})
			.withProps({ 'data-testid': testId || undefined, 'data-transparent': dataTransparent ?? undefined })
			.style({
				minHeight: headerHeight > 0 ? `${headerHeight}px` : undefined,
				flexBasis: showBody ? 'auto' : headerHeight > 0 ? `${headerHeight}px` : undefined,
			})
	}
}

export default MkContainer
