import { Box, Text } from 'vune-ui';
import { i18n } from '@/i18n.js';
import { nativeElement } from '@/vune/native.js';
import VuneIcon from '@/vune/Icon.vune';

type RevealAction = () => void | Promise<void>;

function ignoreRevealAction(): void {}

export struct MkMediaBanner: View {
	let hidden: boolean
	let mediaName: string
	let mediaUrl: string
	let rootClass: string
	let sensitiveClass: string
	let downloadClass: string
	let onReveal: RevealAction

	init(
		_ hidden: boolean = false,
		mediaName: string,
		mediaUrl: string,
		rootClass: string,
		sensitiveClass: string,
		downloadClass: string,
		@Action onReveal: RevealAction = ignoreRevealAction,
	) {
		self.hidden = hidden
		self.mediaName = mediaName
		self.mediaUrl = mediaUrl
		self.rootClass = rootClass
		self.sensitiveClass = sensitiveClass
		self.downloadClass = downloadClass
		self.onReveal = onReveal
	}

	var body: some View {
		Box() {
			if (hidden) {
				Box() {
					VuneIcon('ti ti-alert-triangle').fontSize('1.6em')
					Text(i18n.ts.sensitive).bold()
					Text(i18n.ts.clickToShow)
				}
					.className(sensitiveClass)
					.withProps({ onClick: () => onReveal() })
			} else {
				nativeElement('a', { className: downloadClass, href: mediaUrl, title: mediaName, download: mediaName },
					VuneIcon('ti ti-download').fontSize('1.6em'),
					Text(mediaName).bold(),
				)
			}
		}
			.className(rootClass)
	}
}

export default MkMediaBanner
