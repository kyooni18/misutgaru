import { HStack, VStack, type ViewGraphValue } from 'vune-ui';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
import MkButton from './MkButton.vune';
import './misskey-vune.scss';

function ignoreInfoClose(): void {}

export struct MkInfo: View {
	let warn: boolean
	let closable: boolean
	let onClose: () => void
	let content: ViewGraphValue

	init(
		warn: boolean = false,
		closable: boolean = false,
		@Action onClose: () => void = ignoreInfoClose,
		@ViewBuilder content: () => ViewGraphValue,
	) {
		self.warn = warn
		self.closable = closable
		self.onClose = onClose
		self.content = content()
	}

	var body: some View {
		HStack(alignment: 'center', spacing: 0) {
			VuneIcon(warn ? 'ti ti-alert-triangle' : 'ti ti-info-circle', className: 'mk-vune-info__icon')
			VStack(alignment: 'leading', spacing: 0) { content }.className('mk-vune-info__content')
			if (closable) {
				MkButton(transparent: true, iconOnly: true, className: 'mk-vune-info__close', onClick: { onClose() }) {
					VuneIcon('ti ti-x')
				}
					.accessibilityLabel(i18n.ts.close)
			}
		}
			.style({ justifyContent: 'flex-start' })
			.className(['_selectable', 'mk-vune-info', warn ? 'mk-vune-info--warn' : null])
	}
}

export default MkInfo
