import { VStack } from 'vune-ui';
import MkObjectValue from './MkObjectValue.vune';

type Props = { value: Record<string, unknown> };
export struct MkObjectView: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			MkObjectValue(props.value)
		}
			.className('_selectable')
	}
}
export default MkObjectView
