/* @misutgaru-vune-native */
import { VStack, ForEach, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import { getEmojiName } from '@@/js/emojilist.js';
import MkTooltip from '@/components/vune/MkTooltip.vune';
import MkReactionIcon from '@/components/vune/MkReactionIcon.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';

type Props = {
	showing: boolean;
	reaction: string;
	users: Misskey.entities.UserLite[];
	count: number;
	anchorElement: HTMLElement;
	classes: Record<string, string>;
	onClosed?: () => void;
};

function reactionName(reaction: string) {
	const trimLocal = reaction.replace('@.', '');
	return trimLocal.startsWith(':') ? trimLocal : getEmojiName(reaction);
}

export struct MkReactionsViewerDetails: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkTooltip(showing: props.showing, anchorElement: props.anchorElement, maxWidth: 340, onClosed: { props.onClosed?.() }) {
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) {
					MkReactionIcon(props.reaction, noStyle: true, className: props.classes.reactionIcon)
					Text(reactionName(props.reaction)).className(props.classes.reactionName)
				}.className(props.classes.reaction)
				VStack(alignment: 'stretch', spacing: 0) {
					ForEach(props.users, key: user => user.id) { user in
						VStack(alignment: 'stretch', spacing: 0) {
							MkAvatar(user, className: props.classes.avatar)
							MkUserName({ user, nowrap: true })
						}.className(props.classes.user)
					}
					if (props.count > 10) { Text(`+${props.count - 10}`).className(props.classes.more) }
				}.className(props.classes.users)
			}.className(props.classes.root)
		}
	}
}

export default MkReactionsViewerDetails
