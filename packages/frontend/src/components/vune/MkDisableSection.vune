/* @misutgaru-vune-native */
import { Rectangle, VStack, ZStack, type ViewGraphValue } from 'vune-ui';
import './misskey-vune.scss';

export struct MkDisableSection: View {
	let disabled: boolean
	let content: ViewGraphValue

	init(disabled: boolean = false, @ViewBuilder content: () => ViewGraphValue) {
		self.disabled = disabled
		self.content = content()
	}

	var body: some View {
		ZStack(alignment: 'center') {
			VStack(alignment: 'leading', spacing: 0) { content }
				.className(disabled ? 'mk-vune-disable-section__content--disabled' : null)
				.withProps({ inert: disabled ? true : undefined })
			if (disabled) { Rectangle().className('mk-vune-disable-section__cover') }
		}.className('mk-vune-disable-section')
	}
}

export default MkDisableSection
