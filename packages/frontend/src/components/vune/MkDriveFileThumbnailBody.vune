/* @misutgaru-vune-native */
import { Group, Image } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkImgWithBlurhash from '@/components/vune/MkImgWithBlurhash.vune';
import VuneIcon from '@/vune/Icon.vune';

type Props = { file: Misskey.entities.DriveFile; kind: string; thumbnailAvailable?: boolean; highQuality?: boolean; fit: 'cover'|'contain'; forceBlurhash?: boolean; classes: Record<string,string> };
function icon(kind: string) {
	if (kind === 'image') return 'ti ti-photo';
	if (kind === 'video') return 'ti ti-video';
	if (kind === 'audio' || kind === 'midi') return 'ti ti-file-music';
	if (kind === 'csv' || kind === 'pdf' || kind === 'textfile') return 'ti ti-file-text';
	if (kind === 'archive') return 'ti ti-file-zip';
	return 'ti ti-file';
}
export struct MkDriveFileThumbnailBody: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		Group() {
			if (props.thumbnailAvailable && props.highQuality) {
				MkImgWithBlurhash(src: props.file.thumbnailUrl, hash: props.file.blurhash ?? null, alt: props.file.name, title: props.file.name, className: props.classes.thumbnail, cover: props.fit !== 'contain', forceBlurhash: props.forceBlurhash ?? false)
			} else if (props.thumbnailAvailable && props.file.thumbnailUrl != null) {
				Image(props.file.thumbnailUrl, { alt: props.file.name })
					.className(props.classes.thumbnail)
					.withProps({ title: props.file.name })
					.style({ objectFit: props.fit })
			} else {
				VuneIcon(icon(props.kind), className: props.classes.icon)
			}
		}
	}
}
export default MkDriveFileThumbnailBody
