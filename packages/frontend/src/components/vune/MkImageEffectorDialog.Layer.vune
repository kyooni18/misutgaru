import { VStack, Group, Text } from 'vune-ui';
import type { ImageEffectorLayer } from '@/utility/image-effector/ImageEffector.js';
import MkFolder from '@/components/vune/MkFolder.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkCodeEditor from '@/components/vune/MkCodeEditor.vune';
import VuneIcon from '@/vune/Icon.vune';
type Props={label:string;params:ImageEffectorLayer['params'];paramDefs:unknown;onUpdateParams?:(params:ImageEffectorLayer['params'])=>void;onDelete?:()=>void;onSwapUp?:()=>void;onSwapDown?:()=>void};
function action(fn:(()=>void)|undefined){fn?.()} function update(props:Props,value:string){try{props.onUpdateParams?.(JSON.parse(value))}catch{}}
export struct VuneMkImageEffectorDialogLayerView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { MkFolder(header:Text(props.label)){MkCodeEditor(JSON.stringify(props.params,null,2),onChange:{value in update(props,value)});VStack(alignment: 'stretch', spacing: 0){MkButton(iconOnly:true,onClick:{action(props.onDelete)}){VuneIcon('ti ti-trash')};MkButton(iconOnly:true,onClick:{action(props.onSwapUp)}){VuneIcon('ti ti-arrow-up')};MkButton(iconOnly:true,onClick:{action(props.onSwapDown)}){VuneIcon('ti ti-arrow-down')}}.className('_buttons')} } }
export default VuneMkImageEffectorDialogLayerView
