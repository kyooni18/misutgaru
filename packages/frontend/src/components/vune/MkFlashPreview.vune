import type * as Misskey from 'misskey-js';
import MkA from '@/components/global/vune/MkA.vune';
import MkPlainMfm from '@/components/global/vune/MkPlainMfm.vune';
import { userName } from '@/filters/user.js';
import { Image, Text, VStack } from 'vune-ui';
import '@/vune/phase5-migration.scss';

type Props = { flash: Misskey.entities.Flash };

export struct MkFlashPreview: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkA(`/play/${props.flash.id}`, className: ['_panel', 'mk-vune-flash', props.flash.visibility === 'private' ? 'mk-vune-flash--private' : '']) {
			VStack(alignment: 'stretch', spacing: 0) {
				Text(props.flash.title).font(.title).withProps({ title: props.flash.title })
				if (props.flash.summary) {
					VStack(alignment: 'stretch', spacing: 0) { MkPlainMfm(props.flash.summary, nowrap: true, className: 'summaryMfm') }
						.className('mk-vune-flash__summary')
						.withProps({ title: props.flash.summary })
				}
				VStack(alignment: 'stretch', spacing: 0) {
					Image(props.flash.user.avatarUrl ?? '', { alt: '' }).className('mk-vune-flash__avatar')
					Text(userName(props.flash.user)).className('mk-vune-flash__user')
				}
			}
		}
	}
}

export default MkFlashPreview
