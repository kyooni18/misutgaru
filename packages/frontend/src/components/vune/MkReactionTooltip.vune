/* @misutgaru-vune-native */
import { VStack, Text } from 'vune-ui';
import MkTooltip from '@/components/vune/MkTooltip.vune';
import MkReactionIcon from '@/components/vune/MkReactionIcon.vune';
import '@/vune/phase5-migration.scss';

type Props = { showing: boolean; reaction: string; anchorElement: HTMLElement; onClosed?: () => void };

export struct MkReactionTooltip: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkTooltip(showing: props.showing, anchorElement: props.anchorElement, maxWidth: 340, onClosed: { props.onClosed?.() }) {
			VStack(alignment: 'stretch', spacing: 0) {
				MkReactionIcon(props.reaction, noStyle: true, className: 'mk-vune-reaction-tooltip__icon')
				Text(props.reaction.replace('@.', '')).className('mk-vune-reaction-tooltip__name')
			}.className('mk-vune-reaction-tooltip')
		}
	}
}

export default MkReactionTooltip
