/* @misutgaru-vune-native */
import { Binding, ProgressView, Slider, ZStack } from 'vune-ui';
import './MkMediaRange.scss';

type MediaRangeAction = (value: number) => void;
function ignoreMediaRangeAction(_value: number): void {}

function numeric(value: string | number): number {
	if (typeof value === 'number') return Number.isFinite(value) ? value : 0;
	let parsed = Number.parseFloat(value);
	return Number.isFinite(parsed) ? parsed : 0;
}

export struct MkMediaRange: View {
	let modelValue: string | number
	let buffer: number | undefined
	let onChange: MediaRangeAction
	let onDragEnded: MediaRangeAction

	init(
		_ modelValue: string | number,
		buffer: number | undefined = undefined,
		@Action onChange: MediaRangeAction = ignoreMediaRangeAction,
		@Action onDragEnded: MediaRangeAction = ignoreMediaRangeAction,
	) {
		self.modelValue = modelValue
		self.buffer = buffer
		self.onChange = onChange
		self.onDragEnded = onDragEnded
	}

	var body: some View {
		ZStack(alignment: 'center') {
			if (buffer !== undefined) {
				ProgressView(Number.isNaN(buffer) ? 0 : buffer, { max: 1 })
					.className('mk-vune-media-range__buffer')
			}
			Slider(Binding(
				() => numeric(modelValue),
				(value: number) => onChange(value),
			), { min: 0, max: 1 })
				.className('mk-vune-media-range__seek')
				.style({ '--value': `${numeric(modelValue) * 100}%` })
				.withProps({
					step: 'any',
					onChange: (event: Event) => onDragEnded(Number((event.currentTarget as HTMLInputElement).value)),
				})
		}
			.className('mk-vune-media-range')
	}
}

export default MkMediaRange
