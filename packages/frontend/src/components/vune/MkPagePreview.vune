/* @misutgaru-vune-native */
import { VStack, Group, Image, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkA from '@/components/global/vune/MkA.vune';
import { userName } from '@/filters/user.js';
import '@/vune/phase5-migration.scss';

type Props = { page: Misskey.entities.Page };

export struct VuneMkPagePreviewView: View {
	let page: Misskey.entities.Page
	let summary: string | null

	init(_ props: Props) {
		self.page = props.page
		self.summary = props.page.summary ? (props.page.summary.length > 85 ? props.page.summary.slice(0, 85) + '…' : props.page.summary) : null
	}

	var body: some View {
		MkA(`/@${page.user.username}/pages/${page.name}`, className: 'mk-vune-page-preview') {
			Group() {
				if (page.eyeCatchingImage) {
					VStack(alignment: 'stretch', spacing: 0) {
						Image(page.eyeCatchingImage.thumbnailUrl ?? page.eyeCatchingImage.url, { alt: page.title })
							.style({ width: '100%', height: '100%', objectFit: 'cover' })
					}.className('mk-vune-page-preview__thumb')
				}
				VStack(alignment: 'stretch', spacing: 0) {
					Text(page.title).font(.title2).bold().withProps({ title: page.title })
					if (summary) { Text(summary).className('mk-vune-page-preview__summary').withProps({ title: page.summary ?? '' }) }
					VStack(alignment: 'stretch', spacing: 0) {
						if (page.user.avatarUrl) { Image(page.user.avatarUrl, { alt: '' }).className('mk-vune-page-preview__avatar') }
						Text(userName(page.user)).className('mk-vune-page-preview__user')
					}.className('mk-vune-page-preview__footer')
				}
			}
		}
	}
}

export default VuneMkPagePreviewView
