import { HStack, Image, Text, Spacer } from 'vune-ui';
import { instanceName as localInstanceName } from '@@/js/config.js';
import { instance as localInstance } from '@/instance.js';
import { getProxiedImageUrlNullable } from '@/utility/media-proxy.js';
import './misskey-vune.scss';

export interface InstanceTickerInfo {
	faviconUrl?: string | null
	name?: string | null
	themeColor?: string | null
}

function tickerName(host: string | null, info: InstanceTickerInfo | undefined): string {
	return host == null ? localInstanceName : info?.name ?? host;
}

function tickerFavicon(host: string | null, info: InstanceTickerInfo | undefined): string | null {
	if (host == null) {
		return localInstance.iconUrl == null ? '/favicon.ico' : getProxiedImageUrlNullable(localInstance.iconUrl);
	}
	return getProxiedImageUrlNullable(info?.faviconUrl ?? null);
}

function tickerThemeColor(host: string | null, info: InstanceTickerInfo | undefined): string {
	return (host == null ? localInstance.themeColor : info?.themeColor) ?? '#777777';
}

export struct MkInstanceTicker: View {
	let host: string | null
	let instance: InstanceTickerInfo | undefined

	init(_ host: string | null, instance: InstanceTickerInfo | undefined = undefined) {
		self.host = host
		self.instance = instance
	}

	var body: some View {
		HStack(alignment: 'leading', spacing: 4) {
			if (tickerFavicon(host, instance)) {
				Image(tickerFavicon(host, instance) ?? '', { alt: '' })
					.className('mk-vune-instance-ticker__icon')
			}
			Text(tickerName(host, instance))
				.className('mk-vune-instance-ticker__name')
			Spacer()
		}
			.className('mk-vune-instance-ticker')
			.background(`linear-gradient(90deg, ${tickerThemeColor(host, instance)}, ${tickerThemeColor(host, instance)}00)`)
	}
}

export default MkInstanceTicker
