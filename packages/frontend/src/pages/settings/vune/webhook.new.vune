/* @misutgaru-vune-native */
import { Group, Text, VStack } from 'vune-ui';
import MkInput from '@/components/vune/MkInput.vune';
import FormSection from '@/components/vune/MkFormSection.vune';
import MkSwitch from '@/components/vune/MkSwitch.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = {
	name: string;
	url: string;
	secret: string;
	eventFollow: boolean;
	eventFollowed: boolean;
	eventNote: boolean;
	eventReply: boolean;
	eventRenote: boolean;
	eventReaction: boolean;
	eventMention: boolean;
	onName?: (value: string) => void;
	onUrl?: (value: string) => void;
	onSecret?: (value: string) => void;
	onEventFollow?: (value: boolean) => void;
	onEventFollowed?: (value: boolean) => void;
	onEventNote?: (value: boolean) => void;
	onEventReply?: (value: boolean) => void;
	onEventRenote?: (value: boolean) => void;
	onEventReaction?: (value: boolean) => void;
	onEventMention?: (value: boolean) => void;
	onCreate?: () => void;
};
function setWebhookName(props: Props, value: unknown): void { props.onName?.(String(value ?? '')); }
function setWebhookUrl(props: Props, value: unknown): void { props.onUrl?.(String(value ?? '')); }
function setWebhookSecret(props: Props, value: unknown): void { props.onSecret?.(String(value ?? '')); }
function createWebhook(props: Props): void { props.onCreate?.(); }

function setWebhookEvent(action: ((value: boolean) => void) | undefined, value: boolean): void { action?.(value); }

struct WebhookSwitchRow: View {
	let value: boolean
	let label: string
	let onChange: ((value: boolean) => void) | undefined
	let disabled: boolean
	init(_ value: boolean, label: string, onChange: ((value: boolean) => void) | undefined, disabled: boolean = false) {
		self.value = value
		self.label = label
		self.onChange = onChange
		self.disabled = disabled
	}
	var body: some View {
		MkSwitch(value, disabled: disabled, onChange: next => setWebhookEvent(onChange, next), label: Text(label))
	}
}



export struct VuneWebhookNewView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
			MkInput(props.name, onChange: value => setWebhookName(props, value), label: Text(i18n.ts._webhookSettings.name))
			MkInput(props.url, type: 'url', onChange: value => setWebhookUrl(props, value), label: Text('URL'))
			MkInput(props.secret,
				onChange: value => setWebhookSecret(props, value),
				prefix: VuneIcon('ti ti-lock'),
				label: Text(i18n.ts._webhookSettings.secret),
			)
			FormSection(label: Text(i18n.ts._webhookSettings.trigger)) {
				VStack(alignment: 'stretch', spacing: 'var(--MI-marginHalf)') {
					WebhookSwitchRow(props.eventFollow, label: i18n.ts._webhookSettings._events.follow, onChange: props.onEventFollow)
					WebhookSwitchRow(props.eventFollowed, label: i18n.ts._webhookSettings._events.followed, onChange: props.onEventFollowed)
					WebhookSwitchRow(props.eventNote, label: i18n.ts._webhookSettings._events.note, onChange: props.onEventNote)
					WebhookSwitchRow(props.eventReply, label: i18n.ts._webhookSettings._events.reply, onChange: props.onEventReply)
					WebhookSwitchRow(props.eventRenote, label: i18n.ts._webhookSettings._events.renote, onChange: props.onEventRenote)
					WebhookSwitchRow(props.eventReaction, label: i18n.ts._webhookSettings._events.reaction, onChange: props.onEventReaction, disabled: true)
					WebhookSwitchRow(props.eventMention, label: i18n.ts._webhookSettings._events.mention, onChange: props.onEventMention)
				}.className('_gaps_s')
			}
			MkButton(primary: true, inline: true, onClick: { createWebhook(props) }) { Group() { VuneIcon('ti ti-check'); Text(` ${i18n.ts.create}`) } }
		}.className('_gaps_m')
	}
}

export default VuneWebhookNewView
