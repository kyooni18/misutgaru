import { VStack, ForEach, Text } from 'vune-ui'; import type * as Misskey from 'misskey-js'; import MkFolder from '@/components/vune/MkFolder.vune'; import MkButton from '@/components/vune/MkButton.vune'; import { i18n } from '@/i18n.js';
type Statusbar={id:string;type:string|null;name:string|null}; type Props={statusbars:Statusbar[];userLists:Misskey.entities.UserList[]|null;onAdd?:()=>void}; function add(props:Props){props.onAdd?.()}
export struct VuneStatusbarView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { VStack(alignment: 'stretch', spacing: 0){ForEach(props.statusbars??[],key:x=>x.id){x in MkFolder(header:VStack(alignment: 'stretch', spacing: 0){Text(x.type??i18n.ts.notSet);Text(x.name??'').opacity(.7)}){Text(`ID: ${x.id}`).className('_monospace')}};MkButton(primary:true,onClick:{add(props)}){Text(i18n.ts.add)}}.className('_gaps_m') } }
export default VuneStatusbarView
