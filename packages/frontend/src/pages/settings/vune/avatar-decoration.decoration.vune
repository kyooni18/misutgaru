import { Element } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkCondensedLine from '@/components/global/MkCondensedLine.vue';
import MkAvatar from '@/components/global/MkAvatar.vue';
import { createVuneComponent, VueComponent, vuneBoolean } from '@/vune/vue.js';

type Decoration = {
	id: string;
	url: string;
	name: string;
	roleIdsThatCanBeUsedThisDecoration: string[];
};

type Props = {
	active?: boolean;
	decoration: Decoration;
	angle?: number;
	flipH?: boolean;
	offsetX?: number;
	offsetY?: number;
	locked?: boolean;
	user: Misskey.entities.User;
	rootClass: string;
	activeClass: string;
	nameClass: string;
	lockClass: string;
	onClick?: () => void;
};

export default createVuneComponent<Props>((props) =>
	Element('div', {
		className: [props.rootClass, vuneBoolean(props.active) ? props.activeClass : null],
		onClick: () => props.onClick?.(),
	},
		Element('div', { className: props.nameClass },
			VueComponent(MkCondensedLine, { minScale: 0.5 }, { default: () => props.decoration.name }),
		),
		VueComponent(MkAvatar, {
			style: { width: '60px', height: '60px' },
			user: props.user,
			decorations: [{
				url: props.decoration.url,
				angle: props.angle,
				flipH: vuneBoolean(props.flipH),
				offsetX: props.offsetX,
				offsetY: props.offsetY,
			}],
			forceShowDecoration: true,
		}),
		vuneBoolean(props.locked) ? Element('i', { className: [props.lockClass, 'ti ti-lock'] }) : null,
	)
);
