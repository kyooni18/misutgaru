import { Group, Text, VStack } from 'vune-ui';
import type { Theme } from '@@/js/theme.js';
import MkTextarea from '@/components/vune/MkTextarea.vune';
import MkSelect from '@/components/vune/MkSelect.vune';
import MkInput from '@/components/vune/MkInput.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = {
	selectedThemeId: string | null;
	selectedThemeIdDef: unknown;
	selectedTheme: Theme | null | undefined;
	selectedThemeCode: string | null;
	isBuiltin: boolean;
	onThemeId?: (value: string | null) => void;
	onCopy?: () => void;
	onUninstall?: () => void;
};
function setThemeId(props: Props, value: string | null): void { props.onThemeId?.(value); }
function copyTheme(props: Props): void { props.onCopy?.(); }
function uninstallTheme(props: Props): void { props.onUninstall?.(); }




export struct VuneThemeManageView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
			MkSelect(props.selectedThemeId,
				items: props.selectedThemeIdDef,
				onChange: value => setThemeId(props, value as string | null),
				label: Text(i18n.ts.theme),
			)
			if (props.selectedTheme != null) {
				MkInput(props.selectedTheme.author, readonly: true, label: Text(i18n.ts.author))
				if (props.selectedTheme.desc) {
					MkTextarea(props.selectedTheme.desc, readonly: true, label: Text(i18n.ts._theme.description))
				}
				MkTextarea(props.selectedThemeCode,
					readonly: true,
					tall: true,
					label: Text(i18n.ts._theme.code),
					caption: MkButton(transparent: true, small: true, className: '_textButton', onClick: { copyTheme(props) }) { Text(i18n.ts.copy) },
				)
				if (!props.isBuiltin) {
					MkButton(danger: true, onClick: { uninstallTheme(props) }) { Group() { VuneIcon('ti ti-trash'); Text(` ${i18n.ts.uninstall}`) } }
				}
			}
		}.className('_gaps_m')
	}
}

export default VuneThemeManageView
