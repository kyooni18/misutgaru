import { Group, Text, VStack } from 'vune-ui';
import MkTextarea from '@/components/vune/MkTextarea.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = {
	mutedWords: string;
	changed: boolean;
	onChange?: (value: string) => void;
	onSave?: () => void;
};



export struct VuneMuteBlockWordMuteView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
			MkTextarea(props.mutedWords,
				onChange: { value in props.onChange?.(value) },
				label: Text(i18n.ts._wordMute.muteWords),
				caption: Text(`${i18n.ts._wordMute.muteWordsDescription}\n${i18n.ts._wordMute.muteWordsDescription2}`).style({ whiteSpace: 'pre-line' }),
			)
			MkButton(
				primary: true,
				inline: true,
				disabled: !props.changed,
				onClick: { props.onSave?.() },
			) {
				Group() {
					VuneIcon('ti ti-device-floppy')
					Text(` ${i18n.ts.save}`)
				}
			}
		}.className('_gaps_m')
	}
}

export default VuneMuteBlockWordMuteView
