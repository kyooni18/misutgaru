/* @misutgaru-vune-native */
import { ForEach, Group, HStack, Text, VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkInput from '@/components/vune/MkInput.vune';
import FormSection from '@/components/vune/MkFormSection.vune';
import MkSwitch from '@/components/vune/MkSwitch.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type EventType = Misskey.entities.UserWebhook['on'][number];
type EventTestAction = (type: EventType) => void;
type EventEntry = {
	type: EventType;
	value: boolean;
	label: string;
	disabled?: boolean;
	onChange?: (value: boolean) => void;
};

type Props = {
	name: string;
	url: string;
	secret: string;
	active: boolean;
	eventFollow: boolean;
	eventFollowed: boolean;
	eventNote: boolean;
	eventReply: boolean;
	eventRenote: boolean;
	eventReaction: boolean;
	eventMention: boolean;
	switchBoxClass: string;
	testButtonClass: string;
	descriptionClass: string;
	onName?: (value: string) => void;
	onUrl?: (value: string) => void;
	onSecret?: (value: string) => void;
	onActive?: (value: boolean) => void;
	onEventFollow?: (value: boolean) => void;
	onEventFollowed?: (value: boolean) => void;
	onEventNote?: (value: boolean) => void;
	onEventReply?: (value: boolean) => void;
	onEventRenote?: (value: boolean) => void;
	onEventReaction?: (value: boolean) => void;
	onEventMention?: (value: boolean) => void;
	onTest?: (type: EventType) => void;
	onSave?: () => void;
	onDelete?: () => void;
};

function updateEvent(entry: EventEntry, value: boolean): void { entry.onChange?.(value); }
function testEvent(action: EventTestAction | undefined, type: EventType): void { action?.(type); }
function updateName(props: Props, value: unknown): void { props.onName?.(String(value ?? '')); }
function updateUrl(props: Props, value: unknown): void { props.onUrl?.(String(value ?? '')); }
function updateSecret(props: Props, value: unknown): void { props.onSecret?.(String(value ?? '')); }
function updateActive(props: Props, value: boolean): void { props.onActive?.(value); }
function saveWebhook(props: Props): void { props.onSave?.(); }
function deleteWebhook(props: Props): void { props.onDelete?.(); }

struct WebhookEventRow: View {
	let entry: EventEntry
	let active: boolean
	let switchBoxClass: string
	let testButtonClass: string
	let onTest: EventTestAction | undefined

	var body: some View {
		HStack(alignment: 'center', spacing: 4) {
			MkSwitch(entry.value,
				disabled: entry.disabled ?? false,
				onChange: value => updateEvent(entry, value),
				label: Text(entry.label),
			)
			MkButton(
				transparent: true,
				className: testButtonClass,
				disabled: !(active && entry.value),
				onClick: { testEvent(onTest, entry.type) },
			) { VuneIcon('ti ti-send') }
		}
			.className(switchBoxClass)
	}
}

export struct VuneWebhookEditView: View {
	let props: Props
	let events: EventEntry[]

	init(_ props: Props) {
		self.props = props
		self.events = [
			{ type: 'follow', value: props.eventFollow, label: i18n.ts._webhookSettings._events.follow, onChange: props.onEventFollow },
			{ type: 'followed', value: props.eventFollowed, label: i18n.ts._webhookSettings._events.followed, onChange: props.onEventFollowed },
			{ type: 'note', value: props.eventNote, label: i18n.ts._webhookSettings._events.note, onChange: props.onEventNote },
			{ type: 'reply', value: props.eventReply, label: i18n.ts._webhookSettings._events.reply, onChange: props.onEventReply },
			{ type: 'renote', value: props.eventRenote, label: i18n.ts._webhookSettings._events.renote, onChange: props.onEventRenote },
			{ type: 'reaction', value: props.eventReaction, label: i18n.ts._webhookSettings._events.reaction, disabled: true, onChange: props.onEventReaction },
			{ type: 'mention', value: props.eventMention, label: i18n.ts._webhookSettings._events.mention, onChange: props.onEventMention },
		]
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
			MkInput(props.name, onChange: value => updateName(props, value), label: Text(i18n.ts._webhookSettings.name))
			MkInput(props.url, type: 'url', onChange: value => updateUrl(props, value), label: Text('URL'))
			MkInput(props.secret,
				onChange: value => updateSecret(props, value),
				prefix: VuneIcon('ti ti-lock'),
				label: Text(i18n.ts._webhookSettings.secret),
			)
			FormSection(label: Text(i18n.ts._webhookSettings.trigger)) {
				VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
					VStack(alignment: 'stretch', spacing: 'var(--MI-marginHalf)') {
						ForEach(events, key: (entry) => entry.type) { entry in
							WebhookEventRow(entry: entry, active: props.active, switchBoxClass: props.switchBoxClass, testButtonClass: props.testButtonClass, onTest: props.onTest)
						}
					}.className('_gaps_s')
					Text(i18n.ts._webhookSettings.testRemarks).className(props.descriptionClass)
				}.className('_gaps')
			}
			MkSwitch(props.active, onChange: value => updateActive(props, value), label: Text(i18n.ts._webhookSettings.active))
			HStack(alignment: 'center', spacing: 'var(--MI-marginHalf)') {
				MkButton(primary: true, inline: true, onClick: { saveWebhook(props) }) { Group() { VuneIcon('ti ti-check'); Text(` ${i18n.ts.save}`) } }
				MkButton(danger: true, inline: true, onClick: { deleteWebhook(props) }) { Group() { VuneIcon('ti ti-trash'); Text(` ${i18n.ts.delete}`) } }
			}.className('_buttons')
		}.className('_gaps_m')
	}
}

export default VuneWebhookEditView
