import { Element, ForEach, Group, HStack, Text, VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkInput from '@/components/MkInput.vue';
import FormSection from '@/components/form/section.vue';
import MkSwitch from '@/components/MkSwitch.vue';
import MkButton from '@/components/MkButton.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type EventType = Misskey.entities.UserWebhook['on'][number];
type EventEntry = {
	type: EventType;
	value: boolean;
	label: string;
	disabled?: boolean;
	onChange?: (value: boolean) => void;
};

type Props = {
	name: string;
	url: string;
	secret: string;
	active: boolean;
	eventFollow: boolean;
	eventFollowed: boolean;
	eventNote: boolean;
	eventReply: boolean;
	eventRenote: boolean;
	eventReaction: boolean;
	eventMention: boolean;
	switchBoxClass: string;
	testButtonClass: string;
	descriptionClass: string;
	onName?: (value: string) => void;
	onUrl?: (value: string) => void;
	onSecret?: (value: string) => void;
	onActive?: (value: boolean) => void;
	onEventFollow?: (value: boolean) => void;
	onEventFollowed?: (value: boolean) => void;
	onEventNote?: (value: boolean) => void;
	onEventReply?: (value: boolean) => void;
	onEventRenote?: (value: boolean) => void;
	onEventReaction?: (value: boolean) => void;
	onEventMention?: (value: boolean) => void;
	onTest?: (type: EventType) => void;
	onSave?: () => void;
	onDelete?: () => void;
};

function eventRow(entry: EventEntry, active: boolean, switchBoxClass: string, testButtonClass: string, onTest?: (type: EventType) => void) {
	return HStack(alignment: 'center', spacing: 4) {
		VueComponent(MkSwitch, {
			modelValue: entry.value,
			disabled: entry.disabled ?? false,
			'onUpdate:modelValue': (value: boolean) => entry.onChange?.(value),
		}, { default: () => Text(entry.label) })
		VueComponent(MkButton, {
			transparent: true,
			class: testButtonClass,
			disabled: !(active && entry.value),
			onClick: () => onTest?.(entry.type),
		}, { default: () => Element('i', { className: 'ti ti-send' }) })
	}
		.className(switchBoxClass)
}

export default createVuneComponent<Props>((props) => {
	let events: EventEntry[] = [
		{ type: 'follow', value: props.eventFollow, label: i18n.ts._webhookSettings._events.follow, onChange: props.onEventFollow },
		{ type: 'followed', value: props.eventFollowed, label: i18n.ts._webhookSettings._events.followed, onChange: props.onEventFollowed },
		{ type: 'note', value: props.eventNote, label: i18n.ts._webhookSettings._events.note, onChange: props.onEventNote },
		{ type: 'reply', value: props.eventReply, label: i18n.ts._webhookSettings._events.reply, onChange: props.onEventReply },
		{ type: 'renote', value: props.eventRenote, label: i18n.ts._webhookSettings._events.renote, onChange: props.onEventRenote },
		{ type: 'reaction', value: props.eventReaction, label: i18n.ts._webhookSettings._events.reaction, disabled: true, onChange: props.onEventReaction },
		{ type: 'mention', value: props.eventMention, label: i18n.ts._webhookSettings._events.mention, onChange: props.onEventMention },
	];
	return VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
		VueComponent(MkInput, { modelValue: props.name, 'onUpdate:modelValue': (value: string) => props.onName?.(value) }, {
			label: () => Text(i18n.ts._webhookSettings.name),
		})
		VueComponent(MkInput, { modelValue: props.url, type: 'url', 'onUpdate:modelValue': (value: string) => props.onUrl?.(value) }, {
			label: () => Text('URL'),
		})
		VueComponent(MkInput, { modelValue: props.secret, 'onUpdate:modelValue': (value: string) => props.onSecret?.(value) }, {
			prefix: () => Element('i', { className: 'ti ti-lock' }),
			label: () => Text(i18n.ts._webhookSettings.secret),
		})
		VueComponent(FormSection, {}, {
			label: () => Text(i18n.ts._webhookSettings.trigger),
			default: () => VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
				VStack(alignment: 'stretch', spacing: 'var(--MI-marginHalf)') {
					ForEach(events, key: (entry) => entry.type) { entry in
						eventRow(entry, props.active, props.switchBoxClass, props.testButtonClass, props.onTest)
					}
				}.className('_gaps_s')
				Text(i18n.ts._webhookSettings.testRemarks).className(props.descriptionClass)
			}.className('_gaps'),
		})
		VueComponent(MkSwitch, { modelValue: props.active, 'onUpdate:modelValue': (value: boolean) => props.onActive?.(value) }, {
			default: () => Text(i18n.ts._webhookSettings.active),
		})
		HStack(alignment: 'center', spacing: 'var(--MI-marginHalf)') {
			VueComponent(MkButton, { primary: true, inline: true, onClick: () => props.onSave?.() }, {
				default: () => Group() { Element('i', { className: 'ti ti-check' }); Text(` ${i18n.ts.save}`) },
			})
			VueComponent(MkButton, { danger: true, inline: true, onClick: () => props.onDelete?.() }, {
				default: () => Group() { Element('i', { className: 'ti ti-trash' }); Text(` ${i18n.ts.delete}`) },
			})
		}.className('_buttons')
	}
		.className('_gaps_m')
});
