/* @misutgaru-vune-native */
import { Group, Text, VStack } from 'vune-ui';
import MkSelect from '@/components/vune/MkSelect.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
type NotificationConfigType = 'all' | 'following' | 'follower' | 'mutualFollow' | 'followingOrFollower' | 'list' | 'never';

type Props = {
	type: NotificationConfigType;
	typeDef: unknown;
	userListId: string | null;
	userListIdDef: unknown;
	onType?: (value: NotificationConfigType) => void;
	onUserListId?: (value: string | null) => void;
	onSave?: () => void;
};
function setNotificationType(props: Props, value: unknown): void { props.onType?.(value as NotificationConfigType); }
function setNotificationList(props: Props, value: unknown): void { props.onUserListId?.(value as string | null); }
function saveNotificationConfig(props: Props): void { props.onSave?.(); }




export struct VuneNotificationsNotificationConfigView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
			MkSelect(props.type,
				items: props.typeDef,
				onChange: value => setNotificationType(props, value),
			)
			if (props.type === 'list') {
				MkSelect(props.userListId,
					items: props.userListIdDef,
					onChange: value => setNotificationList(props, value),
					label: Text(i18n.ts.userList),
				)
			}
			MkButton(
				inline: true,
				primary: true,
				disabled: props.type === 'list' && props.userListId === null,
				onClick: { saveNotificationConfig(props) },
			) { Group() { VuneIcon('ti ti-check'); Text(` ${i18n.ts.save}`) } }
		}.className('_gaps_m')
	}
}

export default VuneNotificationsNotificationConfigView
