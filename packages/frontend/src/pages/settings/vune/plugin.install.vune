import { Group, Text, VStack } from 'vune-ui';
import MkCodeEditor from '@/components/vune/MkCodeEditor.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkInfo from '@/components/vune/MkInfo.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = {
	code: string | null;
	onCodeChange?: (value: string | null) => void;
	onInstall?: () => void;
};
function updatePluginCode(props: Props, value: string | null): void { props.onCodeChange?.(value); }
function installPlugin(props: Props): void { props.onInstall?.(); }

export struct VunePluginInstallView: View {
	let props: Props
	let disabled: boolean

	init(_ props: Props) {
		self.props = props
		self.disabled = props.code == null || props.code.trim() === ''
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
			MkInfo(warn: true) { Text(i18n.ts._plugin.installWarn) }
			Text(i18n.ts.code)
			MkCodeEditor(props.code ?? '', onChange: { value in updatePluginCode(props, value) })
			MkButton(
				disabled,
				primary: true,
				inline: true,
				onClick: { installPlugin(props) },
			) {
				Group() {
					VuneIcon('ti ti-check')
					Text(` ${i18n.ts.install}`)
				}
			}
		}.className('_gaps_m')
	}
}

export default VunePluginInstallView
