/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import SearchMarker from '@/components/global/vune/SearchMarker.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkUserCardMini from '@/components/vune/MkUserCardMini.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Account = { host: string; id: string; user?: Misskey.entities.UserDetailed | null };
type Props = {
	accounts: Account[];
	userClass: string;
	onAddAccount?: (ev: PointerEvent) => void;
	onShowMenu?: (host: string, id: string, ev: PointerEvent) => void;
};
function showAccountMenu(props: Props, account: Account, event: PointerEvent): void { event.preventDefault(); props.onShowMenu?.(account.host, account.id, event); }


export struct VuneAccountsView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		SearchMarker() {
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) {
					MkButton(primary: true, onClick: { event in props.onAddAccount?.(event) }) { Group() { VuneIcon('ti ti-plus'); Text(i18n.ts.addAccount) } }
				}.className('_buttons')
				ForEach(props.accounts.filter(x => x.user), key: x => `${x.host}${x.id}`) { x in
					MkUserCardMini({ user: x.user! }).className(props.userClass).withProps({ onClick: (event: PointerEvent) => showAccountMenu(props, x, event) })
				}
			}.className('_gaps')
		}
	}
}

export default VuneAccountsView
