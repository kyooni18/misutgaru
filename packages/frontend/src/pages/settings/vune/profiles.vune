import { ForEach, Group, Text } from 'vune-ui';
import SearchMarker from '@/components/global/vune/SearchMarker.vune';
import MkFolder from '@/components/vune/MkFolder.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';

type Backup = { name: string };
type Props = { backups: Backup[]; onDelete?: (backup: Backup) => void };
function removeBackup(props: Props, backup: Backup): void { props.onDelete?.(backup); }


export struct VuneProfilesView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		SearchMarker() {
			Group() {
				ForEach(props.backups ?? [], key: (backup: Backup) => backup.name) { backup in
					MkFolder(header: Text(backup.name)) {
						MkButton(danger: true, onClick: { removeBackup(props, backup) }) { Text(i18n.ts.delete) }
					}
				}
			}.className('_gaps')
		}
	}
}

export default VuneProfilesView
