import { Element, ForEach, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkButton from '@/components/MkButton.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type Permission = typeof Misskey.permissions[number];
type Props = {
	permissions: Permission[];
	name: string;
	appId: string;
	buttonsClass: string;
	onCancel?: () => void;
	onAccept?: () => void;
};
export default createVuneComponent<Props>((props) =>
	Element('section', {},
		props.permissions.length > 0 ? Element('div', {},
			Element('p', {}, i18n.tsx._auth.permission({ name: props.name })),
			Element('ul', {}, ForEach(props.permissions, key: p => p) { p in Element('li', {}, i18n.ts._permissions[p] ?? p) }),
		) : null,
		Element('div', {}, i18n.tsx._auth.shareAccess({ name: `${props.name} (${props.appId})` })),
		Element('div', { className: props.buttonsClass },
			VueComponent(MkButton, { inline: true, onClick: () => props.onCancel?.() }, { default: () => Text(i18n.ts.cancel) }),
			VueComponent(MkButton, { inline: true, primary: true, onClick: () => props.onAccept?.() }, { default: () => Text(i18n.ts.accept) }),
		),
	)
);
