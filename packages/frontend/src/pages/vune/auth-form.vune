import { Button, ForEach, HStack, Text, VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import { i18n } from '@/i18n.js';

type Permission = typeof Misskey.permissions[number];
type AuthAction = () => void;
function ignoreAuthAction(): void {}

function translated(template: string, name: string): string {
	return template.replace('{name}', name)
}

export struct AuthForm: View {
	let permissions: Permission[]
	let name: string
	let appId: string
	let buttonsClass: string
	let onCancel: AuthAction
	let onAccept: AuthAction

	init(
		_ permissions: Permission[],
		name: string,
		appId: string,
		buttonsClass: string,
		@Action onCancel: AuthAction = ignoreAuthAction,
		@Action onAccept: AuthAction = ignoreAuthAction,
	) {
		self.permissions = permissions
		self.name = name
		self.appId = appId
		self.buttonsClass = buttonsClass
		self.onCancel = onCancel
		self.onAccept = onAccept
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 16) {
			if (permissions.length > 0) {
				VStack(alignment: 'stretch', spacing: 8) {
						Text(translated(i18n.ts._auth.permission, name))
					VStack(alignment: 'stretch', spacing: 4) {
						ForEach(permissions, key: permission => permission) { permission in
							Text(i18n.ts._permissions[permission] ?? permission)
								.withProps({ role: 'listitem' })
						}
					}
						.withProps({ role: 'list' })
				}
			}
				Text(translated(i18n.ts._auth.shareAccess, `${name} (${appId})`))
			HStack(alignment: 'center', spacing: 8) {
				Button(i18n.ts.cancel) { onCancel() }.className('_button')
				Button(i18n.ts.accept) { onAccept() }.className(['_button', '_buttonPrimary'])
			}
				.className(buttonsClass)
		}
	}
}

export default AuthForm
