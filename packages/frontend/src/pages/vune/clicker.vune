import { VStack } from 'vune-ui';
import MkClickerGame from '@/components/vune/MkClickerGame.vune';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import type { PageMetadata } from '@/page.js';


export struct VuneClickerView: View {
	let pageMetadata: PageMetadata | null

	init(pageMetadata: PageMetadata | null = null) {
		self.pageMetadata = pageMetadata
	}

	var body: some View {
		PageWithHeader(pageMetadata: pageMetadata) {
			VStack(alignment: 'stretch', spacing: 0) { MkClickerGame() }.className('_spacer').style({ '--MI_SPACER-w': '800px' })
		}
	}
}

export default VuneClickerView
