/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import * as Misskey from 'misskey-js';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkA from '@/components/global/vune/MkA.vune';
import { i18n } from '@/i18n.js';
import type { PageHeaderItem } from '@/types/page-header.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = {
	antennas: Misskey.entities.Antenna[];
	headerActions?: PageHeaderItem[];
	headerTabs?: unknown[];
	addClass: string;
	antennaClass: string;
	nameClass: string;
};



export struct VuneMyAntennasIndexView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		PageWithHeader(pageMetadata: null, actions: props.headerActions ?? [], tabs: props.headerTabs ?? []) {
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) {
					if (props.antennas.length === 0) { MkResult('empty') }
					MkA('/my/antennas/create', className: props.addClass) { Group() { VuneIcon('ti ti-plus'); Text(i18n.ts.add) } }.className('_buttonPrimary')
					if (props.antennas.length > 0) { VStack(alignment: 'stretch', spacing: 0) {
						ForEach(props.antennas, key: (antenna) => antenna.id) { antenna in
							MkA(`/timeline/antenna/${antenna.id}`, className: props.antennaClass) { Text(antenna.name).className(props.nameClass) }
						}
					}.className('_gaps') }
				}
			}.className('_spacer').style({ '--MI_SPACER-w': '700px' })
		}
	}
}

export default VuneMyAntennasIndexView
