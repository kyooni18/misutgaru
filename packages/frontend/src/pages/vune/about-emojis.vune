/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import * as Misskey from 'misskey-js';
import XEmoji from '@/pages/vune/emojis.emoji.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkInput from '@/components/vune/MkInput.vune';
import MkFoldableSection from '@/components/vune/MkFoldableSection.vune';
import { i18n } from '@/i18n.js';
import MkA from '@/components/global/vune/MkA.vune';
import VuneIcon from '@/vune/Icon.vune';

type Props = { q: string; searchEmojis?: Misskey.entities.EmojiSimple[] | null; customEmojis: Misskey.entities.EmojiSimple[]; categories: Array<string | null>; canManage?: boolean; emojisClass: string; onQChange?: (value: string) => void };
const emojiClasses = { root: 'mk-vune-emoji-card', img: 'mk-vune-emoji-card__img', name: 'mk-vune-emoji-card__name', info: 'mk-vune-emoji-card__info', body: 'mk-vune-emoji-card__body' };
function updateEmojiQuery(props: Props, value: unknown): void { props.onQChange?.(String(value ?? '')); }
struct EmojiGrid: View {
	let items: Misskey.entities.EmojiSimple[]
	let className: string
	var body: some View {
		VStack(alignment: 'leading', spacing: 0) { ForEach(items, key: emoji => emoji.name) { emoji in XEmoji(emoji, classes: emojiClasses) } }.className(className)
	}
}


export struct VuneAboutEmojisView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			if (props.canManage) { MkA('/custom-emojis-manager') { Text(i18n.ts.manageCustomEmojis) }.className('_buttonPrimary') }
			VStack(alignment: 'leading', spacing: 0) {
				MkInput(props.q, placeholder: i18n.ts.search, onChange: { value in updateEmojiQuery(props, value) }, prefix: VuneIcon('ti ti-search'))
			}.className('query')
			if (props.searchEmojis) {
				MkFoldableSection(header: Text(i18n.ts.searchResult)) { EmojiGrid(items: props.searchEmojis ?? [], className: props.emojisClass) }
			}
			ForEach(props.categories, key: category => category ?? '___root___') { category in
				MkFoldableSection(showBody: false, header: Text(category || i18n.ts.other)) { EmojiGrid(items: props.customEmojis.filter(e => e.category === category), className: props.emojisClass) }
			}
		}.className('_gaps')
	}
}

export default VuneAboutEmojisView
