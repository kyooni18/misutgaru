/* @misutgaru-vune-native */
import { Button, Image, Text, VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';

type StyleClasses = Record<string, string>;
type MenuAction = () => void;
function ignoreMenu(): void {}

export struct EmojiCard: View {
	let emoji: Misskey.entities.EmojiSimple
	let classes: StyleClasses
	let onMenu: MenuAction

	init(_ emoji: Misskey.entities.EmojiSimple, classes: StyleClasses, @Action onMenu: MenuAction = ignoreMenu) {
		self.emoji = emoji
		self.classes = classes
		self.onMenu = onMenu
	}

	var body: some View {
		Button(action: onMenu, label: {
			Image(emoji.url, { alt: '' })
				.className(classes.img)
				.withProps({ loading: 'lazy' }),
			VStack(alignment: 'leading', spacing: 0) {
				Text(emoji.name).className([classes.name, '_monospace'])
				Text(emoji.aliases.join(' ')).className(classes.info)
			}
				.className(classes.body),
		})
			.className(['_button', classes.root])
	}
}

export default EmojiCard
