import { Group, Text } from 'vune-ui';
import MkInfo from '@/components/vune/MkInfo.vune';
import MkNotesTimeline from '@/components/vune/MkNotesTimeline.vune';
import type { IPaginator } from '@/utility/paginator.js';
import { i18n } from '@/i18n.js';

type Props = { paginator: IPaginator };


export struct VuneDriveFileNotesView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		Group() {
			MkInfo() { Text(i18n.ts._fileViewer.thisPageCanBeSeenFromTheAuthor) }
			MkNotesTimeline(props.paginator)
		}.className('_gaps')
	}
}

export default VuneDriveFileNotesView
