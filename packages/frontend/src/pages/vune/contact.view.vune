/* @misutgaru-vune-native */
import { Group, VStack, Link, Text, type StateRef } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkKeyValue from '@/components/vune/MkKeyValue.vune';
import MkFolder from '@/components/vune/MkFolder.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import { getUserEnvironment } from '@/utility/get-user-environment.js';
import type { UserEnvironment } from '@/utility/get-user-environment.js';
import { instance } from '@/instance.js';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';
import type { PageMetadata } from '@/page.js';

function loadUserEnvironment(userEnv: StateRef<UserEnvironment | null>) {
	return (element: HTMLElement | null) => {
		if (!element || userEnv.value != null) return;
		void getUserEnvironment().then((environment) => {
			userEnv.value = environment;
		});
	};
}

struct EmptyContactValue: View {
	var body: some View {
		Text(`(${i18n.ts.none})`).opacity(.7)
	}
}

export struct VuneContactView: View {
	let pageMetadata: PageMetadata | null
	@State var userEnv: UserEnvironment | null = null

	init(pageMetadata: PageMetadata | null = null) {
		self.pageMetadata = pageMetadata
	}

	var body: some View {
		PageWithHeader(pageMetadata: pageMetadata) {
			VStack(alignment: 'leading', spacing: 0) {
				MkKeyValue(
					copy: instance.maintainerName,
					key: Text(i18n.ts.administrator),
					value: Group() {
						if (instance.maintainerName) { Text(instance.maintainerName) }
						else { EmptyContactValue() }
					},
				)
				MkKeyValue(
					copy: instance.maintainerEmail,
					key: Text(i18n.ts.contact),
					value: Group() {
						if (instance.maintainerEmail) { Text(instance.maintainerEmail) }
						else { EmptyContactValue() }
					},
				)
				MkKeyValue(
					copy: instance.inquiryUrl,
					key: Text(i18n.ts.inquiry),
					value: Group() {
						if (instance.inquiryUrl) { Link(instance.inquiryUrl, instance.inquiryUrl).withProps({ target: '_blank' }) }
						else { EmptyContactValue() }
					},
				)
				MkFolder(header: VStack(alignment: 'leading', spacing: 0) {
					VuneIcon('ti ti-report-search')
					Text(i18n.ts.deviceInfo)
				}) {
					if (userEnv.value == null) { MkLoading() }
					else {
						Text(JSON.stringify(userEnv.value, null, 2))
							.fontDesign('monospaced')
							.className('_selectable')
							.style({ maxHeight: '300px', overflow: 'auto' })
					}
				}
			}
				.className('_spacer _gaps_m')
				.style({ '--MI_SPACER-w': '600px', '--MI_SPACER-min': '20px' })
				.elementRef(loadUserEnvironment(userEnv))
		}
	}
}

export default VuneContactView
