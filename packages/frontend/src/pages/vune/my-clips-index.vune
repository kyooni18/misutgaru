/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkTip from '@/components/global/vune/MkTip.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkClipPreview from '@/components/vune/MkClipPreview.vune';
import { i18n } from '@/i18n.js';
import type { PageHeaderItem } from '@/types/page-header.js';
import type { IPaginator } from '@/utility/paginator.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = { tab: string; paginator: IPaginator; favoritesPaginator: IPaginator; headerActions?: PageHeaderItem[]; headerTabs?: unknown[]; onCreate?: () => void; onTabChange?: (value: string) => void };
struct ClipCollection: View {
	let paginator: IPaginator
	var body: some View {
		MkPagination(paginator, withControl: true) {
			VStack(alignment: 'leading', spacing: 0) {
				ForEach(paginator.items.value as any[], key: item => item.id) { item in MkClipPreview({ clip: item, noUserInfo: true }) }
			}.className('_gaps')
		}.className('_gaps')
	}
}
function createClip(props: Props): void { props.onCreate?.(); }
function changeClipTab(props: Props, value: string): void { props.onTabChange?.(value); }


export struct VuneMyClipsIndexView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		PageWithHeader(pageMetadata: null, tab: props.tab, actions: props.headerActions ?? [], tabs: props.headerTabs ?? [], swipable: true, onTab: { value in changeClipTab(props, value) }) {
			VStack(alignment: 'leading', spacing: 0) {
				MkTip() { Text(i18n.ts._clip.tip) }
				if (props.tab === 'my') {
					VStack(alignment: 'leading', spacing: 0) {
						MkButton(primary: true, rounded: true, className: 'add', onClick: { createClip(props) }) { Group() { VuneIcon('ti ti-plus'); Text(i18n.ts.add) } }
						ClipCollection(paginator: props.paginator)
					}.className('_gaps')
				} else { ClipCollection(paginator: props.favoritesPaginator) }
			}.className('_spacer _gaps').style({ '--MI_SPACER-w': '700px' })
		}
	}
}

export default VuneMyClipsIndexView
