import { VStack, Image, Text } from 'vune-ui';
import MkSuspense from '@/components/global/vune/MkSuspense.vune';
import bytes from '@/filters/bytes.js';

type Props = { fetcher: () => Promise<any>; onResolved?: (result: any) => void };
function resolvedRef(props: Props, result: any) {
	return (element: HTMLElement | null) => { if (element) props.onResolved?.(result); };
}


export struct VuneAdminFileView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkSuspense(props.fetcher) { result in
			VStack(alignment: 'stretch', spacing: 0) {
				if (result?.file?.thumbnailUrl || result?.file?.url) { Image(result.file.thumbnailUrl ?? result.file.url, { alt: result.file.name ?? '' }).frame(maxHeight: 360) }
				if (result?.file) { Text(result.file.name ?? '').font(.title2).bold(); Text(result.file.type ?? ''); Text(bytes(result.file.size ?? 0)) }
				if (result?.info?.uploadedAt) { Text(String(result.info.uploadedAt)) }
			}.className('_gaps_m').elementRef(resolvedRef(props, result))
		}
	}
}

export default VuneAdminFileView
