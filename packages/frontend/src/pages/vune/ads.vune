/* @misutgaru-vune-native */
import { VStack, ForEach } from 'vune-ui';
import MkAd from '@/components/global/vune/MkAd.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import { instance } from '@/instance.js';
import type { PageMetadata } from '@/page.js';
export struct VuneAdsView: View {
 let pageMetadata: PageMetadata | null
 init(pageMetadata: PageMetadata | null = null) { self.pageMetadata = pageMetadata }
 var body: some View {
  PageWithHeader(pageMetadata: pageMetadata) {
   VStack(alignment: 'stretch', spacing: 0) {
    if (instance.ads.length > 0) { ForEach(instance.ads, key: (ad:any) => ad.id) { ad in MkAd(ad) } }
    else { MkResult('empty') }
   }.className('_spacer _gaps').style({ '--MI_SPACER-w':'500px' })
  }
 }
}
export default VuneAdsView
