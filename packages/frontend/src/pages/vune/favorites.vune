import { VStack, ForEach, Group } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import MkNote from '@/components/vune/MkNote.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import type { IPaginator } from '@/utility/paginator.js';
import { i18n } from '@/i18n.js';

type Props = { paginator: IPaginator };


export struct VuneFavoritesView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		PageWithHeader(pageMetadata: null) {
			VStack(alignment: 'stretch', spacing: 0) {
				MkPagination(props.paginator, empty: MkResult('empty', text: i18n.ts.noNotes)) {
					Group() {
						ForEach(props.paginator.items.value as any[], key: (item: any) => item.id) { item in
							MkNote(item.note, className: 'mk-vune-favorite-note')
						}
					}
				}
			}.className('_spacer').style({ '--MI_SPACER-w': '800px' })
		}
	}
}

export default VuneFavoritesView
