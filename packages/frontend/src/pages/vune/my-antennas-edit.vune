import type * as Misskey from 'misskey-js';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkAntennaEditor from '@/components/vune/MkAntennaEditor.vune';
import type { PageHeaderItem } from '@/types/page-header.js';
type Props = { antenna?: Misskey.entities.Antenna | null; headerActions?: PageHeaderItem[]; headerTabs?: any[]; onUpdated?: () => void };
export struct VuneMyAntennasEditView: View {
 let props: Props
 init(_ props: Props) { self.props = props }
 var body: some View { PageWithHeader(pageMetadata: null, actions: props.headerActions ?? [], tabs: props.headerTabs ?? []) { if (props.antenna) { MkAntennaEditor(antenna: props.antenna, onUpdated: props.onUpdated) } } }
}
export default VuneMyAntennasEditView
