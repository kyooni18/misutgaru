/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Image, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkFeaturedPhotos from '@/components/vune/MkFeaturedPhotos.vune';
import MkVisitorDashboard from '@/components/vune/MkVisitorDashboard.vune';
import MkA from '@/components/global/vune/MkA.vune';
import misskeysvg from '/client-assets/misskey.svg';

type Props = {
	meta: unknown;
	instances?: Misskey.entities.FederationInstance[];
	classes: Record<string, string>;
	getInstanceIcon: (instance: Misskey.entities.FederationInstance) => string;
};

export struct VuneWelcomeEntranceClassicView: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		Group() {
			if (props.meta) {
				VStack(alignment: 'stretch', spacing: 0) {
					MkFeaturedPhotos().className(props.classes.bg)
					VStack(alignment: 'stretch', spacing: 0).className(props.classes.shape1)
					VStack(alignment: 'stretch', spacing: 0).className(props.classes.shape2)
					VStack(alignment: 'stretch', spacing: 0) {
						Text('Powered by').className(props.classes.poweredBy)
						Image(misskeysvg, { alt: 'Misskey' }).className(props.classes.misskey)
					}.className(props.classes.logoWrapper)
					VStack(alignment: 'stretch', spacing: 0) { MkVisitorDashboard() }.className(props.classes.contents)
					if (props.instances && props.instances.length > 0) {
						VStack(alignment: 'stretch', spacing: 0) {
							ForEach(props.instances, key: instance => instance.id) { instance in
								MkA(`/instance-info/${instance.host}`, behavior: 'window', className: props.classes.federationInstance) {
									if (instance.iconUrl) { Image(props.getInstanceIcon(instance), { alt: '' }).className(props.classes.federationInstanceIcon) }
									Text(instance.host).className('_monospace')
								}
							}
						}.className(props.classes.federationTrack)
					}
				}.className(props.classes.root)
			}
		}
	}}
export default VuneWelcomeEntranceClassicView
