/* @misutgaru-vune-native */
import { VStack } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkUserList from '@/components/vune/MkUserList.vune';
import type { IPaginator } from '@/utility/paginator.js';

type Props = { paginator: IPaginator };


export struct VuneUserTagView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		PageWithHeader(pageMetadata: null) {
			VStack(alignment: 'stretch', spacing: 0) { VStack(alignment: 'stretch', spacing: 0) { MkUserList({ paginator: props.paginator }) }.className('_gaps_s') }
				.className('_spacer')
				.style({ '--MI_SPACER-w': '1200px' })
		}
	}
}

export default VuneUserTagView
