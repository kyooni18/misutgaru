import { VStack, ForEach, Text } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkA from '@/components/global/vune/MkA.vune';
import FormSection from '@/components/vune/MkFormSection.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import type { PageHeaderItem } from '@/types/page-header.js';

type Domain = { domain?: string | null; scopes: string[][] };
type Props = { scopes?: Domain[] | null; headerActions?: PageHeaderItem[]; headerTabs?: unknown[]; onCreateKey?: () => void };
function createKey(props: Props): void { props.onCreateKey?.(); }


export struct VuneRegistryView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		PageWithHeader(pageMetadata: null, actions: props.headerActions ?? [], tabs: props.headerTabs ?? []) {
			VStack(alignment: 'stretch', spacing: 0) {
				MkButton(primary: true, onClick: { createKey(props) }) { Text(i18n.ts._registry.createKey) }
				if (props.scopes) {
					VStack(alignment: 'stretch', spacing: 0) {
						ForEach(props.scopes, key: domain => domain.domain ?? 'system') { domain in
							FormSection(label: Text(domain.domain ? domain.domain.toUpperCase() : i18n.ts.system)) {
								VStack(alignment: 'stretch', spacing: 0) {
									ForEach(domain.scopes, key: scope => scope.join('/')) { scope in
										MkA(`/registry/keys/${domain.domain ?? '@'}/${scope.join('/')}`, className: '_monospace') { Text(scope.length === 0 ? '(root)' : scope.join('/')) }
									}
								}.className('_gaps_s')
							}
						}
					}.className('_gaps_m')
				}
			}.className('_spacer').style({ '--MI_SPACER-w': '600px', '--MI_SPACER-min': '16px' })
		}
	}
}

export default VuneRegistryView
