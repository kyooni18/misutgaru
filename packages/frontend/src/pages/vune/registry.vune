import { Element, ForEach, Text } from 'vune-ui';
import PageWithHeader from '@/components/global/PageWithHeader.vue';
import FormLink from '@/components/form/link.vue';
import FormSection from '@/components/form/section.vue';
import MkButton from '@/components/MkButton.vue';
import { i18n } from '@/i18n.js';
import type { PageHeaderItem } from '@/types/page-header.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type Domain = { domain?: string | null; scopes: string[][] };
type Props = { scopes?: Domain[] | null; headerActions?: PageHeaderItem[]; headerTabs?: unknown[]; onCreateKey?: () => void };
export default createVuneComponent<Props>((props) =>
	VueComponent(PageWithHeader, { actions: props.headerActions ?? [], tabs: props.headerTabs ?? [] }, {
		default: () => Element('div', { className: '_spacer', style: { '--MI_SPACER-w': '600px', '--MI_SPACER-min': '16px' } },
			VueComponent(MkButton, { primary: true, onClick: () => props.onCreateKey?.() }, { default: () => Text(i18n.ts._registry.createKey) }),
			props.scopes ? Element('div', { className: '_gaps_m' },
				ForEach(props.scopes, key: domain => domain.domain ?? 'system') { domain in
					VueComponent(FormSection, {}, {
						label: () => Text(domain.domain ? domain.domain.toUpperCase() : i18n.ts.system),
						default: () => Element('div', { className: '_gaps_s' },
							ForEach(domain.scopes, key: scope => scope.join('/')) { scope in
								VueComponent(FormLink, { to: `/registry/keys/${domain.domain ?? '@'}/${scope.join('/')}`, class: '_monospace' }, { default: () => Text(scope.length === 0 ? '(root)' : scope.join('/')) })
							},
						),
					})
				},
			) : null,
		),
	})
);
