/* @misutgaru-vune-native */
import { VStack } from 'vune-ui';
import MkTab from '@/components/vune/MkTab.vune';
import MkNotesTimeline from '@/components/vune/MkNotesTimeline.vune';
import { i18n } from '@/i18n.js';
import type { IPaginator } from '@/utility/paginator.js';

type FeaturedTab = 'notes' | 'polls';
type Props = { tab: FeaturedTab; notesPaginator: IPaginator<any, any>; pollsPaginator: IPaginator<any, any>; onTabChange?: (tab: FeaturedTab) => void };


export struct VuneExploreFeaturedView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			MkTab([
				{ key: 'notes', label: i18n.ts.notes },
				{ key: 'polls', label: i18n.ts.poll },
			], selection: props.tab, onSelect: { value in props.onTabChange?.(value as FeaturedTab) })
				.style({ marginBottom: 'var(--MI-margin)' })
			MkNotesTimeline(props.tab === 'notes' ? props.notesPaginator : props.pollsPaginator)
		}.className('_spacer').style({ '--MI_SPACER-w': '800px' })
	}
}

export default VuneExploreFeaturedView
