/* @misutgaru-vune-native */
import { VStack, Text } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import type { PageHeaderItem } from '@/types/page-header.js';

type Props = { tab: string; headerActions?: PageHeaderItem[]; headerTabs?: unknown[]; onTabChange?: (value: string) => void };


export struct VuneExploreView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		PageWithHeader(pageMetadata: null, tab: props.tab, actions: props.headerActions ?? [], tabs: props.headerTabs ?? [], swipable: true) {
			VStack(alignment: 'stretch', spacing: 0) { Text(props.tab === 'featured' ? 'Featured' : props.tab === 'users' ? 'Users' : 'Roles').fontSize('1.3em').bold() }
				.className('_spacer').style({ '--MI_SPACER-w': '800px' })
		}
	}
}

export default VuneExploreView
