import { VStack, Text } from 'vune-ui';
import MkSuspense from '@/components/global/vune/MkSuspense.vune';
import MkInput from '@/components/vune/MkInput.vune';

type Props = { fetcher: () => Promise<unknown> };


export struct VuneGalleryEditView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkSuspense(props.fetcher) { result in
			VStack(alignment: 'stretch', spacing: 0) {
				Text('Gallery post').font(.title2).bold()
				MkInput(result?.title ?? '', readonly: true, label: Text('Title'))
				if (result?.description) { Text(result.description) }
			}.className('_gaps_m')
		}
	}
}

export default VuneGalleryEditView
