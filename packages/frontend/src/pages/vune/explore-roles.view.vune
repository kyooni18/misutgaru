/* @misutgaru-vune-native */
import { VStack, ForEach, Group } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkRolePreview from '@/components/vune/MkRolePreview.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import { i18n } from '@/i18n.js';

type Props = { roles?: Misskey.entities.Role[] | null; loading?: boolean };



export struct VuneExploreRolesView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			if (props.roles != null && props.roles.length > 0) {
				Group() {
					ForEach(props.roles, key: (role: Misskey.entities.Role) => role.id) { role in
						MkRolePreview(role, forModeration: false)
					}
				}.className('_gaps_s')
			} else if (Boolean(props.loading)) {
				MkLoading()
			} else {
				MkResult('empty', text: i18n.ts.noRole)
			}
		}
			.className('_spacer')
			.style({ '--MI_SPACER-w': '700px' })
	}
}

export default VuneExploreRolesView
