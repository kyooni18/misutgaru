import { State, VStack, type StateRef } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkStreamingNotificationsTimeline from '@/components/vune/MkStreamingNotificationsTimeline.vune';
import MkNotesTimeline from '@/components/vune/MkNotesTimeline.vune';
import type { NativeTab } from '@/components/vune/MkTabs.vune';
import type { PageHeaderItem } from '@/types/page-header.js';
import type { IPaginator } from '@/utility/paginator.js';
import { i18n } from '@/i18n.js';

type TabAction = (value: string) => void;
function ignoreTabChange(_value: string): void {}
function selectTab(tab: StateRef<string>, onTabChange: TabAction, value: string): void {
	if (value !== 'all' && value !== 'mentions' && value !== 'directNotes') return;
	if (tab.value === value) return;
	tab.value = value;
	onTabChange(value);
}

export struct VuneNotificationsView: View {
	let selectedTab: StateRef<string>
	let mentionsPaginator: IPaginator
	let directNotesPaginator: IPaginator
	let notificationsClass: string
	let headerActions: PageHeaderItem[]
	let headerTabs: NativeTab[]
	let excludeTypes: string[] | null
	let onTabChange: TabAction

	init(
		tab: string,
		mentionsPaginator: IPaginator,
		directNotesPaginator: IPaginator,
		notificationsClass: string,
		headerActions: PageHeaderItem[] = [],
		headerTabs: NativeTab[] = [],
		excludeTypes: string[] | null = null,
		@Action onTabChange: TabAction = ignoreTabChange,
	) {
		self.selectedTab = State(tab)
		self.mentionsPaginator = mentionsPaginator
		self.directNotesPaginator = directNotesPaginator
		self.notificationsClass = notificationsClass
		self.headerActions = headerActions
		self.headerTabs = headerTabs
		self.excludeTypes = excludeTypes
		self.onTabChange = onTabChange
	}

	var body: some View {
		PageWithHeader(
			pageMetadata: { title: i18n.ts.notifications, icon: 'ti ti-bell' },
			tab: selectedTab.value,
			actions: headerActions,
			tabs: headerTabs,
			swipable: true,
			onTab: { value in selectTab(selectedTab, onTabChange, value) },
		) {
			VStack(alignment: 'stretch', spacing: 0) {
				if (selectedTab.value === 'all') { MkStreamingNotificationsTimeline(excludeTypes: excludeTypes, className: notificationsClass) }
				else if (selectedTab.value === 'mentions') { MkNotesTimeline(mentionsPaginator) }
				else { MkNotesTimeline(directNotesPaginator) }
			}.keyed(selectedTab.value).className('_spacer').style({ '--MI_SPACER-w': '800px' })
		}
	}
}

export default VuneNotificationsView
