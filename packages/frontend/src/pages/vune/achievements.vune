import { VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkAchievements from '@/components/vune/MkAchievements.vune';

type Props = { user: Misskey.entities.User };


export struct VuneAchievementsView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		PageWithHeader(pageMetadata: null) {
			VStack(alignment: 'stretch', spacing: 0) { MkAchievements(props.user) }
				.className('_spacer')
				.style({ '--MI_SPACER-w': '1200px' })
		}
	}
}

export default VuneAchievementsView
