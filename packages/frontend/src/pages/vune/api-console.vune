import { Element, Group, Text, VStack } from 'vune-ui';
import PageWithHeader from '@/components/global/PageWithHeader.vue';
import MkButton from '@/components/MkButton.vue';
import MkInput from '@/components/MkInput.vue';
import MkTextarea from '@/components/MkTextarea.vue';
import MkSwitch from '@/components/MkSwitch.vue';
import MkEllipsis from '@/components/vune/MkEllipsis.vune';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type Props = {
	body: string;
	endpoint: string;
	endpoints: string[];
	sending: boolean;
	response: string;
	withCredential: boolean;
	headerActions?: unknown[];
	headerTabs?: unknown[];
	onBody?: (value: string) => void;
	onEndpoint?: (value: string) => void;
	onCredential?: (value: boolean) => void;
	onSend?: () => void;
};

export default createVuneComponent<Props>((props) =>
	VueComponent(PageWithHeader, { actions: props.headerActions ?? [], tabs: props.headerTabs ?? [] }, {
		default: () => VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
				VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
				VueComponent(MkInput, {
					modelValue: props.endpoint,
					datalist: props.endpoints,
					'onUpdate:modelValue': (value: string) => props.onEndpoint?.(value),
				}, { label: () => Text('Endpoint') })
				VueComponent(MkTextarea, {
					modelValue: props.body,
					code: true,
					'onUpdate:modelValue': (value: string) => props.onBody?.(value),
				}, { label: () => Text('Params (JSON or JSON5)') })
				VueComponent(MkSwitch, {
					modelValue: props.withCredential,
					'onUpdate:modelValue': (value: boolean) => props.onCredential?.(value),
				}, { default: () => Text('With credential') })
				VueComponent(MkButton, { primary: true, disabled: props.sending, onClick: () => props.onSend?.() }, {
					default: () => props.sending
						? MkEllipsis()
						: Group() { Element('i', { className: 'ti ti-send' }); Text(' Send') },
				})
				}
					.className('_gaps_m')
				if (props.response) {
					VueComponent(MkTextarea, { modelValue: props.response, code: true, readonly: true, tall: true }, {
						label: () => Text('Response'),
					})
				}
			}
				.className('_gaps_m')
		}
			.className('_spacer')
			.style({ '--MI_SPACER-w': '700px' })
	})
);
