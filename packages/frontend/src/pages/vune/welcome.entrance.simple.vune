/* @misutgaru-vune-native */
import { VStack, Group, Image, Text } from 'vune-ui';
import MkFeaturedPhotos from '@/components/vune/MkFeaturedPhotos.vune';
import MkVisitorDashboard from '@/components/vune/MkVisitorDashboard.vune';
import misskeysvg from '/client-assets/misskey.svg';
import { instance as meta } from '@/instance.js';
import '@/vune/phase5-migration.scss';

export struct VuneWelcomeEntranceSimpleView: View {
	init() {}

	var body: some View {
		Group() {
			if (meta) {
				VStack(alignment: 'stretch', spacing: 0) {
					MkFeaturedPhotos().className('mk-vune-welcome-simple__bg')
					VStack(alignment: 'stretch', spacing: 0) {
						Text('Powered by').className('mk-vune-welcome-simple__powered')
						Image(misskeysvg, { alt: 'Misskey' }).className('mk-vune-welcome-simple__misskey')
					}.className('mk-vune-welcome-simple__logo')
					VStack(alignment: 'stretch', spacing: 0) { MkVisitorDashboard() }.className('mk-vune-welcome-simple__contents')
				}.className('mk-vune-welcome-simple')
			}
		}
	}
}

export default VuneWelcomeEntranceSimpleView
