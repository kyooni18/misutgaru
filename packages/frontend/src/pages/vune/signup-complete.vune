/* @misutgaru-vune-native */
import { VStack, Group, Text } from 'vune-ui';
import MkButton from '@/components/vune/MkButton.vune';
import MkEllipsis from '@/components/vune/MkEllipsis.vune';
import PageWithAnimBg from '@/components/global/vune/PageWithAnimBg.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';

type Props = { submitting?: boolean; onSubmit?: () => void };
function submit(props: Props): void { props.onSubmit?.(); }

export struct VuneSignupCompleteView: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		PageWithAnimBg() {
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) { VuneIcon('ti ti-user-check') }
					.className('mk-vune-signup-complete__banner')
				VStack(alignment: 'stretch', spacing: 0) {
					Text(i18n.tsx.clickToFinishEmailVerification({ ok: i18n.ts.gotIt }))
					MkButton(
						gradate: true,
						large: true,
						rounded: true,
						disabled: props.submitting === true,
						testId: 'admin-ok',
						style: { margin: '0 auto' },
						onClick: { submit(props) },
					) {
						Group() {
							Text(props.submitting ? i18n.ts.processing : i18n.ts.gotIt)
							if (props.submitting) { MkEllipsis() }
						}
					}
				}.className('_gaps_m').padding(32)
			}.className('_panel mk-vune-signup-complete__form')
		}.className('mk-vune-signup-complete')
	}
}
export default VuneSignupCompleteView
