import { ForEach, Group, Text } from 'vune-ui';
import XMessage from '@/pages/chat/vune/XMessage.vune';
import MkInfo from '@/components/vune/MkInfo.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import type { IPaginator } from '@/utility/paginator.js';
import { i18n } from '@/i18n.js';

type Props = { paginator: IPaginator };


export struct VuneAdminFileChatView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		Group() {
			MkInfo() { Text(i18n.ts._fileViewer.thisPageCanBeSeenFromTheAuthor) }
			MkPagination(props.paginator) { Group() { ForEach(props.paginator.items.value as any[], key: (item: any) => item.id) { item in XMessage(item, isSearchResult: true) } } }
		}.className('_gaps')
	}
}

export default VuneAdminFileChatView
