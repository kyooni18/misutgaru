/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import MkInviteCode from '@/components/vune/MkInviteCode.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';
import type { IPaginator } from '@/utility/paginator.js';
type Props={showInvites?:boolean;resetCycle?:string|null;inviteLimit:number;currentInviteLimit?:number|null;paginator:IPaginator;onCreate?:()=>void;onDeleted?:(id:string)=>void};
const classes={root:'mk-vune-invite-code',items:'mk-vune-invite-code__items',label:'mk-vune-invite-code__label',avatar:'mk-vune-invite-code__avatar',user:'mk-vune-invite-code__user'};
function createInvite(props:Props){props.onCreate?.()}
export struct VuneInviteView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { PageWithHeader(pageMetadata:null){if(!props.showInvites){VStack(alignment: 'stretch', spacing: 0){MkResult('empty')}.className('_spacer').style({'--MI_SPACER-w':'1200px'})}else{VStack(alignment: 'stretch', spacing: 0){if(props.resetCycle&&props.inviteLimit){Text(i18n.tsx.inviteLimitResetCycle({time:props.resetCycle,limit:props.inviteLimit}))};MkButton(inline:true,primary:true,rounded:true,disabled:props.currentInviteLimit!=null&&props.currentInviteLimit<=0,onClick:{createInvite(props)}){Group(){VuneIcon('ti ti-user-plus');Text(` ${i18n.ts.createInviteCode}`)}};if(props.currentInviteLimit!=null){Text(i18n.tsx.createLimitRemaining({limit:props.currentInviteLimit}))};MkPagination(props.paginator){VStack(alignment: 'stretch', spacing: 0){ForEach(props.paginator.items.value as any[],key:item=>item.id){item in MkInviteCode({invite:item,classes})}}.className('_gaps_s')}}.className('_spacer _gaps_m').style({'--MI_SPACER-w':'800px',textAlign:'center'})}} } }
export default VuneInviteView
