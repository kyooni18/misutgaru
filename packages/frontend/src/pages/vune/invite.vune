import { Element, ForEach, Group } from 'vune-ui';
import PageWithHeader from '@/components/global/PageWithHeader.vue';
import MkResult from '@/components/global/MkResult.vue';
import MkButton from '@/components/MkButton.vue';
import MkPagination from '@/components/MkPagination.vue';
import MkInviteCode from '@/components/MkInviteCode.vue';
import { i18n } from '@/i18n.js';
import type { IPaginator } from '@/utility/paginator.js';
import { createVuneComponent, VueComponent, vuneBoolean } from '@/vune/vue.js';

type Props = {
	showInvites?: boolean;
	resetCycle?: string | null;
	inviteLimit: number;
	currentInviteLimit?: number | null;
	paginator: IPaginator;
	onCreate?: () => void;
	onDeleted?: (id: string) => void;
};

export default createVuneComponent<Props>((props) =>
	VueComponent(PageWithHeader, {}, {
		default: () => !vuneBoolean(props.showInvites) ? Element('div', {
			className: '_spacer',
			style: { '--MI_SPACER-w': '1200px' },
		}, VueComponent(MkResult, { type: 'empty' })) : Element('div', {
			className: '_spacer',
			style: { '--MI_SPACER-w': '800px' },
		},
			Element('div', { className: '_gaps_m', style: { textAlign: 'center' } },
				props.resetCycle && props.inviteLimit
					? Element('div', {}, i18n.tsx.inviteLimitResetCycle({ time: props.resetCycle, limit: props.inviteLimit }))
					: null,
				VueComponent(MkButton, {
					inline: true,
					primary: true,
					rounded: true,
					disabled: props.currentInviteLimit !== null && props.currentInviteLimit !== undefined && props.currentInviteLimit <= 0,
					onClick: () => props.onCreate?.(),
				}, {
					default: () => Group() {
						Element('i', { className: 'ti ti-user-plus' })
						` ${i18n.ts.createInviteCode}`
					},
				}),
				props.currentInviteLimit !== null && props.currentInviteLimit !== undefined
					? Element('div', {}, i18n.tsx.createLimitRemaining({ limit: props.currentInviteLimit }))
					: null,
				VueComponent(MkPagination, { paginator: props.paginator }, {
					default: (slotProps: any) => Element('div', { className: '_gaps_s' },
						ForEach(slotProps.items ?? [], key: (item: any) => item.id) { item in
							VueComponent(MkInviteCode, {
								invite: item,
								onDeleted: (id: string) => props.onDeleted?.(id),
							})
						},
					),
				}),
			),
		),
	})
);
