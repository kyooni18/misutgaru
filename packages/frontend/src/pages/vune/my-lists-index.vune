import { Element, ForEach, Group, Text } from 'vune-ui';
import * as Misskey from 'misskey-js';
import PageWithHeader from '@/components/global/PageWithHeader.vue';
import MkTip from '@/components/global/MkTip.vue';
import MkResult from '@/components/global/MkResult.vue';
import MkButton from '@/components/MkButton.vue';
import MkA from '@/components/global/MkA.vue';
import MkAvatars from '@/components/MkAvatars.vue';
import { i18n } from '@/i18n.js';
import type { PageHeaderItem } from '@/types/page-header.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type Props = {
	items: Misskey.entities.UserList[];
	userListLimit: number;
	headerActions?: PageHeaderItem[];
	headerTabs?: unknown[];
	listClass: string;
	nUsersClass: string;
	onCreate?: () => void;
};
export default createVuneComponent<Props>((props) =>
	VueComponent(PageWithHeader, { actions: props.headerActions ?? [], tabs: props.headerTabs ?? [] }, {
		default: () => Element('div', { className: '_spacer', style: { '--MI_SPACER-w': '700px' } },
			Element('div', { className: '_gaps' },
				VueComponent(MkTip, { k: 'userLists' }, { default: () => Text(i18n.ts._userLists.tip) }),
				props.items.length === 0 ? VueComponent(MkResult, { type: 'empty' }) : null,
				VueComponent(MkButton, { primary: true, rounded: true, style: { margin: '0 auto' }, onClick: () => props.onCreate?.() }, {
					default: () => Group() { Element('i', { className: 'ti ti-plus' }); Text(i18n.ts.createList) },
				}),
				props.items.length > 0 ? Element('div', { className: '_gaps' },
					ForEach(props.items, key: list => list.id) { list in
						VueComponent(MkA, { class: ['_panel', props.listClass], to: `/timeline/list/${list.id}` }, {
							default: () => Group() {
								Element('div', { style: { marginBottom: '4px' } }, list.name, ' ', Element('span', { className: props.nUsersClass }, `(${i18n.tsx.nUsers({ n: `${list.userIds!.length}/${props.userListLimit}` })})`))
								VueComponent(MkAvatars, { userIds: list.userIds!, limit: 10 })
							},
						})
					},
				) : null,
			),
		),
	})
);
