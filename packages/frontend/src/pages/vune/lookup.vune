/* @misutgaru-vune-native */
import { VStack, Text } from 'vune-ui';
import type { PageMetadata } from '@/page.js';
import type { PageHeaderItem } from '@/types/page-header.js';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import { i18n } from '@/i18n.js';
import type { NativeTab } from '@/components/vune/MkTabs.vune';

type Props = { state: 'fetching' | 'done'; headerActions?: PageHeaderItem[]; headerTabs?: NativeTab[]; pageMetadata?: PageMetadata | null; onClose?: () => void; onGoToMisskey?: () => void };
function closeLookup(props: Props): void { props.onClose?.(); }
function goToMisskey(props: Props): void { props.onGoToMisskey?.(); }

export struct Lookup: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		PageWithHeader(pageMetadata: props.pageMetadata ?? null, actions: props.headerActions ?? [], tabs: props.headerTabs ?? []) {
			VStack(alignment: 'leading', spacing: 0) {
				if (props.state === 'done') {
					VStack(alignment: 'leading', spacing: 0) {
						MkButton(onClick: { closeLookup(props) }) { Text(i18n.ts.close) }
						MkButton(onClick: { goToMisskey(props) }) { Text(i18n.ts.goToMisskey) }
					}.className('_buttonsCenter')
				} else {
					VStack(alignment: 'leading', spacing: 0) { MkLoading() }.className('_fullInfo')
				}
			}
				.className('_spacer')
				.style({ '--MI_SPACER-w': '800px' })
		}
	}
}
export default Lookup
