import { Element, Group, Text, VStack } from 'vune-ui';
import PageWithHeader from '@/components/global/PageWithHeader.vue';
import MkSwitch from '@/components/MkSwitch.vue';
import MkInput from '@/components/MkInput.vue';
import MkInfo from '@/components/MkInfo.vue';
import FormSplit from '@/components/form/split.vue';
import FormSection from '@/components/form/section.vue';
import MkButton from '@/components/MkButton.vue';
import SearchMarker from '@/components/global/SearchMarker.vue';
import SearchLabel from '@/components/global/SearchLabel.vue';
import SearchText from '@/components/global/SearchText.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type Props = {
	enableEmail: boolean;
	email: string;
	smtpSecure: boolean;
	smtpHost: string;
	smtpPort: number;
	smtpUser: string;
	smtpPass: string;
	footerClass: string;
	headerTabs?: unknown[];
	onEnableEmail?: (value: boolean) => void;
	onEmail?: (value: string) => void;
	onSmtpSecure?: (value: boolean) => void;
	onSmtpHost?: (value: string) => void;
	onSmtpPort?: (value: number) => void;
	onSmtpUser?: (value: string) => void;
	onSmtpPass?: (value: string) => void;
	onSave?: () => void;
	onTest?: () => void;
};

function label(text: string) {
	return VueComponent(SearchLabel, {}, { default: () => Text(text) });
}

export default createVuneComponent<Props>((props) =>
	VueComponent(PageWithHeader, { tabs: props.headerTabs ?? [] }, {
		default: () => VueComponent(SearchMarker, { path: '/admin/email-settings', label: i18n.ts.emailServer, keywords: ['email'], icon: 'ti ti-mail' }, {
			default: () => VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
				VueComponent(SearchMarker, {}, {
					default: () => VueComponent(MkSwitch, { modelValue: props.enableEmail, 'onUpdate:modelValue': (value: boolean) => props.onEnableEmail?.(value) }, {
						label: () => Group() { label(i18n.ts.enableEmail); Text(` (${i18n.ts.recommended})`) },
						caption: () => VueComponent(SearchText, {}, { default: () => Text(i18n.ts.emailConfigInfo) }),
					}),
				})
				if (props.enableEmail) {
					VueComponent(SearchMarker, {}, {
						default: () => VueComponent(MkInput, { modelValue: props.email, type: 'email', 'onUpdate:modelValue': (value: string) => props.onEmail?.(value) }, { label: () => label(i18n.ts.emailAddress) }),
					})
					VueComponent(SearchMarker, {}, {
						default: () => VueComponent(FormSection, {}, {
							label: () => label(i18n.ts.smtpConfig),
							default: () => VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
								VueComponent(FormSplit, { minWidth: 280 }, {
									default: () => Group() {
										VueComponent(MkInput, { modelValue: props.smtpHost, 'onUpdate:modelValue': (value: string) => props.onSmtpHost?.(value) }, { label: () => label(i18n.ts.smtpHost) })
										VueComponent(MkInput, { modelValue: props.smtpPort, type: 'number', 'onUpdate:modelValue': (value: number) => props.onSmtpPort?.(value) }, { label: () => label(i18n.ts.smtpPort) })
									},
								})
								VueComponent(FormSplit, { minWidth: 280 }, {
									default: () => Group() {
										VueComponent(MkInput, { modelValue: props.smtpUser, 'onUpdate:modelValue': (value: string) => props.onSmtpUser?.(value) }, { label: () => label(i18n.ts.smtpUser) })
										VueComponent(MkInput, { modelValue: props.smtpPass, type: 'password', autocomplete: 'new-password', 'onUpdate:modelValue': (value: string) => props.onSmtpPass?.(value) }, { label: () => label(i18n.ts.smtpPass) })
									},
								})
								VueComponent(MkInfo, {}, { default: () => Text(i18n.ts.emptyToDisableSmtpAuth) })
								VueComponent(MkSwitch, { modelValue: props.smtpSecure, 'onUpdate:modelValue': (value: boolean) => props.onSmtpSecure?.(value) }, {
									label: () => label(i18n.ts.smtpSecure),
									caption: () => VueComponent(SearchText, {}, { default: () => Text(i18n.ts.smtpSecureInfo) }),
								})
							}.className('_gaps_m'),
						}),
					})
				}
			}.className(['_spacer', '_gaps_m']).style({ '--MI_SPACER-w': '700px', '--MI_SPACER-min': '16px', '--MI_SPACER-max': '32px' }),
		}),
		footer: () => VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 0) {
				Group() {
					VueComponent(MkButton, { primary: true, rounded: true, onClick: () => props.onSave?.() }, { default: () => Group() { Element('i', { className: 'ti ti-check' }); Text(` ${i18n.ts.save}`) } })
					VueComponent(MkButton, { rounded: true, onClick: () => props.onTest?.() }, { default: () => Group() { Element('i', { className: 'ti ti-send' }); Text(` ${i18n.ts.testEmail}`) } })
				}.className('_buttons')
			}.className('_spacer').style({ '--MI_SPACER-w': '700px', '--MI_SPACER-min': '16px', '--MI_SPACER-max': '16px' })
		}.className(props.footerClass),
	})
);
