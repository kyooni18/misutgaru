/* @misutgaru-vune-native */
import { VStack, Group, Text } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkSwitch from '@/components/vune/MkSwitch.vune';
import MkInput from '@/components/vune/MkInput.vune';
import MkInfo from '@/components/vune/MkInfo.vune';
import MkButton from '@/components/vune/MkButton.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';
type Props = { enableEmail:boolean; email:string; smtpSecure:boolean; smtpHost:string; smtpPort:number; smtpUser:string; smtpPass:string; footerClass:string; headerTabs?:any[]; onEnableEmail?:(v:boolean)=>void; onEmail?:(v:string)=>void; onSmtpSecure?:(v:boolean)=>void; onSmtpHost?:(v:string)=>void; onSmtpPort?:(v:number)=>void; onSmtpUser?:(v:string)=>void; onSmtpPass?:(v:string)=>void; onSave?:()=>void; onTest?:()=>void };
function enable(props:Props,v:boolean){props.onEnableEmail?.(v)} function email(props:Props,v:unknown){props.onEmail?.(String(v??''))} function secure(props:Props,v:boolean){props.onSmtpSecure?.(v)} function host(props:Props,v:unknown){props.onSmtpHost?.(String(v??''))} function port(props:Props,v:unknown){props.onSmtpPort?.(Number(v??0))} function user(props:Props,v:unknown){props.onSmtpUser?.(String(v??''))} function pass(props:Props,v:unknown){props.onSmtpPass?.(String(v??''))} function save(props:Props){props.onSave?.()} function test(props:Props){props.onTest?.()}
export struct VuneEmailSettingsView: View {
 let props: Props
 init(_ props: Props){self.props=props}
 var body: some View {
  PageWithHeader(pageMetadata:null, tabs:props.headerTabs??[]) {
   VStack(alignment: 'stretch', spacing: 0) {
    MkSwitch(props.enableEmail, onChange: v => enable(props,v), label:Text(`${i18n.ts.enableEmail} (${i18n.ts.recommended})`), caption:Text(i18n.ts.emailConfigInfo))
    if (props.enableEmail) {
     MkInput(props.email, type:'email', onChange: v => email(props,v), label:Text(i18n.ts.emailAddress))
     MkInput(props.smtpHost, onChange: v => host(props,v), label:Text(i18n.ts.smtpHost))
     MkInput(props.smtpPort, type:'number', onChange: v => port(props,v), label:Text(i18n.ts.smtpPort))
     MkInput(props.smtpUser, onChange: v => user(props,v), label:Text(i18n.ts.smtpUser))
     MkInput(props.smtpPass, type:'password', autocomplete:'new-password', onChange: v => pass(props,v), label:Text(i18n.ts.smtpPass))
     MkInfo() { Text(i18n.ts.emptyToDisableSmtpAuth) }
     MkSwitch(props.smtpSecure, onChange: v => secure(props,v), label:Text(i18n.ts.smtpSecure), caption:Text(i18n.ts.smtpSecureInfo))
    }
    VStack(alignment: 'stretch', spacing: 0) {
     MkButton(primary:true, rounded:true, onClick:{save(props)}) {
      Group() {
       VuneIcon('ti ti-check')
       Text(` ${i18n.ts.save}`)
      }
     }
     MkButton(rounded:true, onClick:{test(props)}) {
      Group() {
       VuneIcon('ti ti-send')
       Text(` ${i18n.ts.testEmail}`)
      }
     }
    }.className('_buttons')
   }.className('_spacer _gaps_m').style({ '--MI_SPACER-w':'700px','--MI_SPACER-min':'16px','--MI_SPACER-max':'32px' })
  }
 }
}
export default VuneEmailSettingsView
