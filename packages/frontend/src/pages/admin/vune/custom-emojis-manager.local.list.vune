import { VStack, ForEach, Text } from 'vune-ui'; import MkStickyContainer from '@/components/global/vune/MkStickyContainer.vune'; import MkButton from '@/components/vune/MkButton.vune'; import MkPagingButtons from '@/components/vune/MkPagingButtons.vune'; import { i18n } from '@/i18n.js';
type Props={headerPageMetadata:unknown;headerActions:unknown[];loadingShowing?:boolean;gridItems:any[];gridSettings:unknown;classes:Record<string,string>;deleteItemsCount:number;updatedItemsCount:number;updateButtonDisabled?:boolean;currentPage:number;allPages:number;onGridEvent?:(...args:any[])=>void;onDelete?:()=>void;onPageChanged?:(page:number)=>void;onUpdate?:()=>void;onReset?:()=>void}; function del(props:Props){props.onDelete?.()} function upd(props:Props){props.onUpdate?.()} function reset(props:Props){props.onReset?.()} function page(props:Props,v:number){props.onPageChanged?.(v)}
function range(current:number,total:number){let start=Math.max(1,Math.min(total-4,current-2));return Array.from({length:Math.min(5,total)},(_,i)=>start+i)}
export struct VuneCustomEmojisManagerLocalListView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { MkStickyContainer(){VStack(alignment: 'stretch', spacing: 0){if(props.loadingShowing){Text(i18n.ts.loading)}else if(props.gridItems.length===0){Text(i18n.ts._customEmojisManager._local._list.emojisNothing).multilineTextAlignment('center')}else{VStack(alignment: 'stretch', spacing: 0){ForEach(props.gridItems,key:(item:any)=>item.id??item.name){item in VStack(alignment: 'stretch', spacing: 0){Text(item.name??item.id??'emoji');if(item.url){Text(item.url).fontSize('0.8em').opacity(.7)}}.className('_panel').padding(8)}}.className([props.classes.grid,'_gaps_s'])}}.className(['_gaps',props.classes.main]);if(props.gridItems.length>0){VStack(alignment: 'stretch', spacing: 0){MkButton(danger:true,onClick:{del(props)}){Text(`${i18n.ts.delete} (${props.deleteItemsCount})`)};MkPagingButtons(1,props.currentPage,props.allPages,range(props.currentPage,props.allPages),'','','',props.currentPage>3,props.currentPage<props.allPages-2,onPage:{v in page(props,v)});MkButton(primary:true,disabled:props.updateButtonDisabled===true,onClick:{upd(props)}){Text(`${i18n.ts.update} (${props.updatedItemsCount})`)};MkButton(onClick:{reset(props)}){Text(i18n.ts.reset)}}.className(props.classes.footer)}} } }
export default VuneCustomEmojisManagerLocalListView
