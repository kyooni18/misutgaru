/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import SearchMarker from '@/components/global/vune/SearchMarker.vune';
import MkButton from '@/components/vune/MkButton.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';
import type { PageHeaderItem } from '@/types/page-header.js';
type Relay = Misskey.entities.AdminRelaysListResponse[number];
type Props = { relays: Relay[]; headerActions?: PageHeaderItem[]; headerTabs?: any[]; iconClass:string; onRemove?:(inbox:string)=>void };
function removeRelay(props: Props, inbox: string): void { props.onRemove?.(inbox); }
struct RelayStatusIcon: View {
 let relay: Relay
 let className: string
 var body: some View {
  Group() {
   if (relay.status === 'accepted') { VuneIcon(`ti ti-check ${className}`).foregroundStyle('var(--MI_THEME-success)') }
   else if (relay.status === 'rejected') { VuneIcon(`ti ti-ban ${className}`).foregroundStyle('var(--MI_THEME-error)') }
   else { VuneIcon(`ti ti-clock ${className}`) }
  }
 }
}
export struct VuneRelaysView: View {
 let props: Props
 init(_ props: Props) { self.props = props }
 var body: some View {
  PageWithHeader(pageMetadata: null, actions: props.headerActions ?? [], tabs: props.headerTabs ?? []) {
   VStack(alignment: 'leading', spacing: 0) {
    SearchMarker() {
     VStack(alignment: 'leading', spacing: 0) {
      ForEach(props.relays, key: relay => relay.inbox) { relay in
       VStack(alignment: 'leading', spacing: 0) {
        Text(relay.inbox)
        VStack(alignment: 'leading', spacing: 0) { RelayStatusIcon(relay: relay, className: props.iconClass); Text(i18n.ts._relayStatus[relay.status]) }
        MkButton(inline: true, danger: true, onClick: { removeRelay(props, relay.inbox) }) { Group() { VuneIcon('ti ti-trash'); Text(i18n.ts.remove) } }
       }.className('_panel').padding(16)
      }
     }.className('_gaps')
    }
   }.className('_spacer').style({ '--MI_SPACER-w': '800px' })
  }
 }
}
export default VuneRelaysView
