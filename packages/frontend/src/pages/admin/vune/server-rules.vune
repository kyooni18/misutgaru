import { VStack, ForEach, Group, Text } from 'vune-ui'; import SearchMarker from '@/components/global/vune/SearchMarker.vune'; import SearchIcon from '@/components/vune/SearchIcon.vune'; import SearchLabel from '@/components/vune/SearchLabel.vune'; import SearchText from '@/components/vune/SearchText.vune'; import MkButton from '@/components/vune/MkButton.vune'; import MkInput from '@/components/vune/MkInput.vune'; import MkFolder from '@/components/vune/MkFolder.vune'; import VuneIcon from '@/vune/Icon.vune'; import { i18n } from '@/i18n.js';
type Rule={text:string;id:string}; type Props={serverRules:Rule[];classes:Record<string,string>;onUpdateRules?:(rules:Rule[])=>void;onUpdateText?:(index:number,value:string)=>void;onRemove?:(id:string)=>void;onAdd?:()=>void;onSave?:()=>void}; function text(p:Props,i:number,v:unknown){p.onUpdateText?.(i,String(v??''))} function remove(p:Props,id:string){p.onRemove?.(id)} function add(p:Props){p.onAdd?.()} function save(p:Props){p.onSave?.()}
export struct VuneServerRulesView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { SearchMarker(){MkFolder(header:SearchLabel(){Text(i18n.ts.serverRules)}){VStack(alignment: 'stretch', spacing: 0){SearchText(){Text(i18n.ts._serverRules.description)};ForEach(props.serverRules,key:r=>r.id){rule,index in VStack(alignment: 'stretch', spacing: 0){VStack(alignment: 'stretch', spacing: 0){Text(String(index+1)).className(props.classes.itemNumber);VuneIcon('ti ti-menu',className:props.classes.itemHandle);MkButton(transparent:true,iconOnly:true,onClick:{remove(props,rule.id)}){VuneIcon('ti ti-x')}}.className(props.classes.itemHeader);MkInput(rule.text,onChange:{v in text(props,index,v)})}.className(props.classes.item)};VStack(alignment: 'stretch', spacing: 0){MkButton(rounded:true,onClick:{add(props)}){Group(){VuneIcon('ti ti-plus');Text(` ${i18n.ts.add}`)}};MkButton(primary:true,rounded:true,onClick:{save(props)}){Group(){VuneIcon('ti ti-check');Text(` ${i18n.ts.save}`)}}}.className(props.classes.commands)}.className('_gaps_m')}} } }
export default VuneServerRulesView
