import { Element, Group, Text } from 'vune-ui';
import SearchMarker from '@/components/global/SearchMarker.vue';
import SearchIcon from '@/components/global/SearchIcon.vue';
import SearchLabel from '@/components/global/SearchLabel.vue';
import SearchText from '@/components/global/SearchText.vue';
import MkButton from '@/components/MkButton.vue';
import MkInput from '@/components/MkInput.vue';
import MkFolder from '@/components/MkFolder.vue';
import MkDraggable from '@/components/MkDraggable.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type Rule = { text: string; id: string };
type Props = {
	serverRules: Rule[];
	classes: Record<string, string>;
	onUpdateRules?: (rules: Rule[]) => void;
	onUpdateText?: (index: number, value: string) => void;
	onRemove?: (id: string) => void;
	onAdd?: () => void;
	onSave?: () => void;
};

export default createVuneComponent<Props>((props) =>
	VueComponent(SearchMarker, { markerId: 'serverRules', keywords: ['rules'] }, {
		default: () => VueComponent(MkFolder, {}, {
			icon: () => VueComponent(SearchIcon, {}, { default: () => Element('i', { className: 'ti ti-checkbox' }) }),
			label: () => VueComponent(SearchLabel, {}, { default: () => Text(i18n.ts.serverRules) }),
			default: () => Element('div', { className: '_gaps_m' },
				Element('div', {}, VueComponent(SearchText, {}, { default: () => Text(i18n.ts._serverRules.description) })),
				VueComponent(MkDraggable, {
					modelValue: props.serverRules,
					direction: 'vertical',
					withGaps: true,
					manualDragStart: true,
					'onUpdate:modelValue': (rules: Rule[]) => props.onUpdateRules?.(rules),
				}, {
					default: (slotProps: any) => {
						const item = slotProps.item as Rule;
						const index = slotProps.index as number;
						return Element('div', { className: props.classes.item },
							Element('div', { className: props.classes.itemHeader },
								Element('div', { className: props.classes.itemNumber }, String(index + 1)),
								Element('span', {
									className: props.classes.itemHandle,
									draggable: true,
									onDragStart: (ev: DragEvent) => { ev.stopPropagation(); slotProps.dragStart?.(ev) },
								}, Element('i', { className: 'ti ti-menu' })),
								Element('button', {
									className: ['_button', props.classes.itemRemove],
									onClick: () => props.onRemove?.(item.id),
								}, Element('i', { className: 'ti ti-x' })),
							),
							VueComponent(MkInput, {
								modelValue: item.text,
								'onUpdate:modelValue': (value: string) => props.onUpdateText?.(index, value),
							}),
						);
					},
				}),
				Element('div', { className: props.classes.commands },
					VueComponent(MkButton, { rounded: true, onClick: () => props.onAdd?.() }, {
						default: () => Group() { Element('i', { className: 'ti ti-plus' }); ` ${i18n.ts.add}` },
					}),
					VueComponent(MkButton, { primary: true, rounded: true, onClick: () => props.onSave?.() }, {
						default: () => Group() { Element('i', { className: 'ti ti-check' }); ` ${i18n.ts.save}` },
					}),
				),
			),
		}),
	})
);
