/* @misutgaru-vune-native */
import { VStack, ForEach } from 'vune-ui';
import * as Misskey from 'misskey-js';
import MkA from '@/components/global/vune/MkA.vune';
import MkUserCardMini from '@/components/vune/MkUserCardMini.vune';

export struct OverviewUsers: View {
	let users: Misskey.entities.UserDetailed[]

	init(_ props: { users: Misskey.entities.UserDetailed[] }) {
		self.users = props.users
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			ForEach(users, key: user => user.id) { user in
				MkA(`/admin/user/${user.id}`, className: 'user') {
					VStack(alignment: 'stretch', spacing: 0) {
						MkUserCardMini({ user })
					}
						.className('_panel')
						.style({ display: 'flex', alignItems: 'center', padding: '16px', borderRadius: '8px' })
				}
			}
		}.className('users')
	}
}

export default OverviewUsers
