/* @misutgaru-vune-native */
import { VStack, ForEach, Text } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkSuspense from '@/components/global/vune/MkSuspense.vune';
import MkKeyValue from '@/components/vune/MkKeyValue.vune';
import bytes from '@/filters/bytes.js';
import number from '@/filters/number.js';
import { misskeyApi } from '@/utility/misskey-api.js';
import type { PageMetadata } from '@/page.js';
type TableEntry = [string, { size:number; count:number }];

function databasePromiseFactory(): Promise<TableEntry[]> {
 return misskeyApi('admin/get-table-stats').then(res => Object.entries(res).sort((a, b) => b[1].size - a[1].size));
}

export struct VuneDatabaseView: View {
 let pageMetadata: PageMetadata | null
 init(pageMetadata: PageMetadata | null = null) { self.pageMetadata = pageMetadata }
 var body: some View {
  PageWithHeader(pageMetadata: pageMetadata) {
   VStack(alignment: 'stretch', spacing: 0) {
    MkSuspense(databasePromiseFactory) { result in
     ForEach(result as TableEntry[], key: table => table[0]) { table in MkKeyValue(oneline: true, key: Text(table[0]), value: Text(`${bytes(table[1].size)} (${number(table[1].count)} recs)`)).style({ margin: '1em 0' }) }
    }
   }.className('_spacer').style({ '--MI_SPACER-w':'800px', '--MI_SPACER-min':'16px', '--MI_SPACER-max':'32px' })
  }
 }
}
export default VuneDatabaseView
