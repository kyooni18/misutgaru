import { ForEach, HStack, Text, VStack } from 'vune-ui'; import PageWithHeader from '@/components/global/vune/PageWithHeader.vune'; import MkInput from '@/components/vune/MkInput.vune'; import MkSelect from '@/components/vune/MkSelect.vune'; import MkPagination from '@/components/vune/MkPagination.vune'; import MkDriveFileThumbnail from '@/components/vune/MkDriveFileThumbnail.vune'; import { i18n } from '@/i18n.js'; import type { IPaginator } from '@/utility/paginator.js';
type Props={origin:string;originDef:unknown;searchHost:string;userId:string;mimeType:string|null;viewMode:'grid'|'list';paginator:IPaginator<any,any>;hostDisabled:boolean;headerActions?:any[];headerTabs?:any[];onOrigin?:(v:string)=>void;onHost?:(v:string)=>void;onUserId?:(v:string)=>void;onMimeType?:(v:string|null)=>void}; function origin(p:Props,v:unknown){p.onOrigin?.(String(v))} function host(p:Props,v:unknown){p.onHost?.(String(v??''))} function user(p:Props,v:unknown){p.onUserId?.(String(v??''))} function mime(p:Props,v:unknown){p.onMimeType?.(v==null?null:String(v))}
export struct VuneFilesView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { PageWithHeader(pageMetadata:null,actions:props.headerActions??[],tabs:props.headerTabs??[]){VStack(alignment:'stretch',spacing:0){VStack(alignment:'stretch',spacing:'var(--MI-margin)'){HStack(spacing:'var(--MI-margin)'){MkSelect(props.origin,items:props.originDef,onChange:{v in origin(props,v)},label:Text(i18n.ts.instance));MkInput(props.searchHost,debounce:true,type:'search',disabled:props.hostDisabled,onChange:{v in host(props,v)},label:Text(i18n.ts.host))}.style({flexWrap:'wrap'});HStack(spacing:'var(--MI-margin)'){MkInput(props.userId,debounce:true,type:'search',onChange:{v in user(props,v)},label:Text('User ID'));MkInput(props.mimeType,debounce:true,type:'search',onChange:{v in mime(props,v)},label:Text('MIME type'))}.style({flexWrap:'wrap'});MkPagination(props.paginator){VStack(alignment: 'stretch', spacing: 0){ForEach(props.paginator.items.value as any[],key:f=>f.id){f in VStack(alignment: 'stretch', spacing: 0){MkDriveFileThumbnail(f,fit:'cover',large:true);Text(f.name??f.id)}.className('_panel')}}.className(props.viewMode==='grid'?'mk-vune-admin-files-grid':'_gaps_s')}}.className('_gaps')}.className('_spacer').style({'--MI_SPACER-w':'900px'})} } }
export default VuneFilesView
