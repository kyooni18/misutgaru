/* @misutgaru-vune-native */
import { VStack, Group, Text } from 'vune-ui';
import PageWithHeader from '@/components/global/vune/PageWithHeader.vune';
import MkButton from '@/components/vune/MkButton.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';
import type { PageHeaderItem } from '@/types/page-header.js';

type Props = { tab: 'deliver' | 'inbox'; headerActions?: PageHeaderItem[]; headerTabs?: unknown[]; onTabChange?: (value: 'deliver' | 'inbox') => void; onPromote?: () => void; onClear?: () => void };


export struct VuneFederationJobQueueView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		PageWithHeader(pageMetadata: null, tab: props.tab, actions: props.headerActions ?? [], tabs: props.headerTabs ?? []) {
			VStack(alignment: 'stretch', spacing: 0) {
				Text(props.tab === 'deliver' ? 'Deliver queue' : 'Inbox queue').fontSize('1.3em').bold()
				VStack(alignment: 'stretch', spacing: 0) {
					MkButton(onClick: { props.onPromote?.() }) { Group() { VuneIcon('ti ti-reload'); Text(i18n.ts.retryAllQueuesNow) } }
					MkButton(danger: true, onClick: { props.onClear?.() }) { Group() { VuneIcon('ti ti-trash'); Text(i18n.ts.clearQueue) } }
				}.className('_buttons')
			}.className('_spacer').style({ '--MI_SPACER-w': '800px' })
		}
	}
}

export default VuneFederationJobQueueView
