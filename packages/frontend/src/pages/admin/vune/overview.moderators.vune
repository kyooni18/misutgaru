/* @misutgaru-vune-native */
import { VStack, ForEach } from 'vune-ui';
import * as Misskey from 'misskey-js';
import MkA from '@/components/global/vune/MkA.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';

export struct OverviewModerators: View {
	let users: Misskey.entities.UserDetailed[]
	let rootClass: string

	init(_ users: Misskey.entities.UserDetailed[], rootClass: string) {
		self.users = users
		self.rootClass = rootClass
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			ForEach(users, key: user => user.id) { user in
				MkA(`/admin/user/${user.id}`, className: 'user') {
					MkAvatar(user, indicator: true, className: 'avatar')
				}
			}
		}.className([rootClass, '_panel'])
	}
}

export default OverviewModerators
