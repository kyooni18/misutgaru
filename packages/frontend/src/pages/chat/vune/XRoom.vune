/* @misutgaru-vune-native */
import { Divider, HStack, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkA from '@/components/global/vune/MkA.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import '@/vune/phase5-migration.scss';

function roomDescription(room: Misskey.entities.ChatRoom): string {
	return room.description == null ? '' : String(room.description);
}

export struct XRoom: View {
	let room: Misskey.entities.ChatRoom

	init(_ room: Misskey.entities.ChatRoom) {
		self.room = room
	}

	var body: some View {
		MkA(`/chat/room/${room.id}`, className: '_panel _gaps_s mk-vune-room') {
			HStack(alignment: 'center', spacing: 0) {
				Text(room.name).bold()
				MkAvatar(room.owner, className: 'mk-vune-room__avatar')
			}
				.className('mk-vune-room__header')
			Divider()
			Text(roomDescription(room))
		}
	}
}

export default XRoom
