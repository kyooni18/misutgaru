/* @misutgaru-vune-native */
import { ForEach, Group } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import XRoom from '@/pages/chat/vune/XRoom.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import { i18n } from '@/i18n.js';

type Props = { fetching: boolean; rooms: Misskey.entities.ChatRoom[] };

export struct HomeOwnedRooms: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		Group() {
			if (props.rooms.length > 0) {
				Group() {
					ForEach(props.rooms, key: room => room.id) { room in XRoom(room) }
				}.className('_gaps_s')
			}
			if (!props.fetching && props.rooms.length === 0) { MkResult('empty', text: i18n.ts._chat.noRooms) }
			if (props.fetching) { MkLoading() }
		}.className('_gaps')
	}
}

export default HomeOwnedRooms
