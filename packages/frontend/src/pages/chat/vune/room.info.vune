import { Divider, Text, VStack } from 'vune-ui';
import MkButton from '@/components/vune/MkButton.vune';
import MkInput from '@/components/vune/MkInput.vune';
import MkTextarea from '@/components/vune/MkTextarea.vune';
import MkSwitch from '@/components/vune/MkSwitch.vune';
import { i18n } from '@/i18n.js';

type Props = {
	name: string;
	description: string;
	isOwner: boolean;
	canDelete: boolean;
	isMuted: boolean;
	onName?: (value: string) => void;
	onDescription?: (value: string) => void;
	onMuted?: (value: boolean) => void;
	onSave?: () => void;
	onDelete?: () => void;
};
function updateRoomName(props: Props, value: unknown): void { props.onName?.(String(value ?? '')); }
function updateRoomDescription(props: Props, value: string): void { props.onDescription?.(value); }
function updateRoomMuted(props: Props, value: boolean): void { props.onMuted?.(value); }
function saveRoom(props: Props): void { props.onSave?.(); }
function deleteRoom(props: Props): void { props.onDelete?.(); }
function editRoom(props: Props): void { props.onEdit?.(); }
function inviteRoom(props: Props): void { props.onInvite?.(); }
function leaveRoom(props: Props): void { props.onLeave?.(); }




export struct VuneRoomInfoView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
			MkInput(props.name,
				disabled: !props.isOwner,
					onChange: value => updateRoomName(props, value),
				label: Text(i18n.ts.name),
			)
			MkTextarea(props.description,
				disabled: !props.isOwner,
				onChange: value => updateRoomDescription(props, value),
				label: Text(i18n.ts.description),
			)
			if (props.isOwner) {
				MkButton(primary: true, onClick: { saveRoom(props) }) { Text(i18n.ts.save) }
			}
			Divider()
			if (props.canDelete) {
				MkButton(danger: true, onClick: { deleteRoom(props) }) { Text(i18n.ts._chat.deleteRoom) }
			}
			if (!props.isOwner) {
				MkSwitch(props.isMuted,
					onChange: value => updateRoomMuted(props, value),
					label: Text(i18n.ts._chat.muteThisRoom),
				)
			}
		}.className('_gaps')
	}
}

export default VuneRoomInfoView
