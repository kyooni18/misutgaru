/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkFolder from '@/components/vune/MkFolder.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import MkTimeValue from '@/components/global/vune/MkTimeValue.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';
type Invitation=Misskey.entities.ChatRoomInvitation; type Props={fetching:boolean;invitations:Invitation[];bodyClass?:string;avatarClass?:string;onJoin?:(v:Invitation)=>void;onIgnore?:(v:Invitation)=>void};
function join(props:Props,v:Invitation){props.onJoin?.(v)} function ignore(props:Props,v:Invitation){props.onIgnore?.(v)}
export struct VuneHomeInvitationsView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { VStack(alignment: 'stretch', spacing: 0){if(props.invitations.length>0){ForEach(props.invitations,key:v=>v.id){v in MkFolder(header:Group(){VuneIcon('ti ti-users-group');Text(v.room.name??'');MkTimeValue(v.createdAt)}){VStack(alignment: 'stretch', spacing: 0){MkAvatar(v.room.owner,link:true,className:props.avatarClass??'');VStack(alignment: 'stretch', spacing: 0){MkUserName({user:v.room.owner});Text(v.room.description===''?i18n.ts.noDescription:v.room.description??'')}.className('_gaps_s')}.className(props.bodyClass);VStack(alignment: 'stretch', spacing: 0){MkButton(primary:true,onClick:{join(props,v)}){Group(){VuneIcon('ti ti-plus');Text(` ${i18n.ts._chat.join}`)}};MkButton(danger:true,onClick:{ignore(props,v)}){Group(){VuneIcon('ti ti-x');Text(` ${i18n.ts._chat.ignore}`)}}}.className('_buttons')}}}else if(!props.fetching){MkResult('empty',text:i18n.ts._chat.noInvitations)};if(props.fetching){MkLoading()}}.className('_gaps') } }
export default VuneHomeInvitationsView
