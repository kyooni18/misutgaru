import { ForEach, Text, VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkButton from '@/components/vune/MkButton.vune';
import MkInput from '@/components/vune/MkInput.vune';
import MkFoldableSection from '@/components/vune/MkFoldableSection.vune';
import MkResult from '@/components/global/vune/MkResult.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import MkTimeValue from '@/components/global/vune/MkTimeValue.vune';
import VuneIcon from '@/vune/Icon.vune'; import { i18n } from '@/i18n.js';
type Props={searchQuery:string;searched:boolean;searchResults:Misskey.entities.ChatMessage[];searchResultItemClass:string;onQueryChange?:(v:string)=>void;onSearch?:()=>void}; function query(props:Props,v:unknown){props.onQueryChange?.(String(v??''))} function search(props:Props){props.onSearch?.()}
export struct VuneRoomSearchView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { VStack(alignment:'stretch',spacing:'var(--MI-margin)'){MkInput(props.searchQuery,type:'search',placeholder:i18n.ts._chat.searchMessages,onChange:v => query(props,v),prefix:VuneIcon('ti ti-search'));MkButton(primary:true,rounded:true,onClick:{search(props)}){Text(i18n.ts.search)};if(props.searched){MkFoldableSection(header:Text(i18n.ts.searchResult)){if(props.searchResults.length>0){VStack(alignment:'stretch',spacing:'var(--MI-marginHalf)'){ForEach(props.searchResults,key:m=>m.id){m in VStack(alignment: 'stretch', spacing: 0){if(m.fromUser){MkAvatar(m.fromUser,className:'mk-vune-chat-search__avatar')};VStack(alignment: 'stretch', spacing: 0){if(m.fromUser){MkUserName({user:m.fromUser,nowrap:true})};if(m.createdAt){MkTimeValue(m.createdAt)};Text(m.text??'')}.className('mk-vune-chat-search__body')}.className(props.searchResultItemClass)}}.className('_gaps_s')}else{MkResult('notFound')}}}}.className('_gaps') } }
export default VuneRoomSearchView
