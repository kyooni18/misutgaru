import { Element, ForEach, Group, Text, VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import XMessage from '@/pages/chat/XMessage.vue';
import MkButton from '@/components/MkButton.vue';
import MkInput from '@/components/MkInput.vue';
import MkFoldableSection from '@/components/MkFoldableSection.vue';
import MkResult from '@/components/global/vune/MkResult.vune';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type Props = {
	searchQuery: string;
	searched: boolean;
	searchResults: Misskey.entities.ChatMessage[];
	searchResultItemClass: string;
	onQueryChange?: (value: string) => void;
	onSearch?: () => void;
};

export default createVuneComponent<Props>((props) =>
	VStack(alignment: 'stretch', spacing: 'var(--MI-margin)') {
		VueComponent(MkInput, {
			modelValue: props.searchQuery,
			placeholder: i18n.ts._chat.searchMessages,
			type: 'search',
			'onUpdate:modelValue': (value: string) => props.onQueryChange?.(value),
			onEnter: () => props.onSearch?.(),
		}, {
			prefix: () => Element('i', { className: 'ti ti-search' }),
		})
		VueComponent(MkButton, { primary: true, rounded: true, onClick: () => props.onSearch?.() }, {
			default: () => Text(i18n.ts.search),
		})
		if (props.searched) {
			VueComponent(MkFoldableSection, {}, {
				header: () => Text(i18n.ts.searchResult),
				default: () => props.searchResults.length > 0
					? VStack(alignment: 'stretch', spacing: 'var(--MI-marginHalf)') {
						ForEach(props.searchResults, key: (message) => message.id) { message in
							Element('div', { className: props.searchResultItemClass },
								VueComponent(XMessage, { message, user: message.fromUser, isSearchResult: true }),
							)
						}
					}.className('_gaps_s')
					: MkResult('notFound'),
			})
		}
	}
		.className('_gaps')
);
