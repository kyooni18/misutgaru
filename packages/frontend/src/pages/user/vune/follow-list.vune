/* @misutgaru-vune-native */
import { VStack, ForEach } from 'vune-ui';
import MkUserInfo from '@/components/vune/MkUserInfo.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import type { IPaginator } from '@/utility/paginator.js';

type Props = { type: 'following' | 'followers'; followingPaginator: IPaginator; followersPaginator: IPaginator };
type Row = { key: string; user: any };
function rows(props: Props, paginator: IPaginator): Row[] {
	return (paginator.items.value as any[]).map((item, index) => {
		const user = props.type === 'following' ? item.followee : item.follower;
		return { key: user?.id ?? item.id ?? String(index), user };
	}).filter(row => row.user != null);
}
export struct FollowList: View {
	let props: Props
	let paginator: IPaginator
	init(_ props: Props) { self.props = props; self.paginator = props.type === 'following' ? props.followingPaginator : props.followersPaginator }
	var body: some View {
		MkPagination(paginator, withControl: true) {
			VStack(alignment: 'leading', spacing: 0) {
				ForEach(rows(props, paginator), key: row => row.key) { row in MkUserInfo({ user: row.user }) }
			}.className('mk-vune-follow-users')
		}
	}
}
export default FollowList
