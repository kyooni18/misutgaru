/* @misutgaru-vune-native */
import { VStack, ForEach, type StateRef } from 'vune-ui';
import * as Misskey from 'misskey-js';
import MkUserInfo from '@/components/vune/MkUserInfo.vune';
import MkError from '@/components/vune/MkError.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import { misskeyApi } from '@/utility/misskey-api.js';

type Props = { user?: Misskey.entities.UserDetailed | null; error?: unknown; type: 'followers' | 'following'; onRetry?: () => void };
function retryFollowState(props: Props): void { props.onRetry?.(); }
function retryAction(props: Props): () => void { return () => retryFollowState(props); }
function loadFollowState(props: Props, users: StateRef<Misskey.entities.UserDetailed[] | null>) {
	return (element: HTMLElement | null) => {
		if (!element || !props.user || users.value != null) return;
		const endpoint = props.type === 'following' ? 'users/following' : 'users/followers';
		void misskeyApi(endpoint as any, { userId: props.user.id, limit: 100 } as any).then((rows: any) => {
			users.value = rows.map((row: any) => props.type === 'following' ? row.followee : row.follower).filter(Boolean);
		});
	};
}

export struct VuneFollowStateView: View {
	let props: Props
	@State var users: Misskey.entities.UserDetailed[] | null = null

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			if (props.error) { MkError(onRetry: retryAction(props)) }
			else if (!props.user || users.value == null) { MkLoading() }
			else { ForEach(users.value, key: user => user.id) { user in MkUserInfo({ user }) } }
		}.className('_gaps_s').elementRef(loadFollowState(props, users))
	}
}

export default VuneFollowStateView
