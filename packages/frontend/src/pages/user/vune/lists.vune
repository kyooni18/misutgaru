/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import MkPagination from '@/components/vune/MkPagination.vune';
import MkStickyContainer from '@/components/global/vune/MkStickyContainer.vune';
import { MkAvatarsByIds } from '@/components/vune/MkAvatars.vune';
import MkA from '@/components/global/vune/MkA.vune';
import type { IPaginator } from '@/utility/paginator.js';

type Props = { paginator: IPaginator };
function listItems(paginator: IPaginator): any[] { return paginator.items.value as any[]; }
export struct UserLists: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		return MkStickyContainer() {
			VStack(alignment: 'stretch', spacing: 0) {
				MkPagination(props.paginator, withControl: true) {
					Group() {
						ForEach(listItems(props.paginator), key: list => list.id) { list in
							MkA(`/list/${list.id}`, className: '_panel mk-vune-user-list-card') {
								Group() {
									Text(list.name)
									if (list.userIds != null) { MkAvatarsByIds(list.userIds) }
								}
							}
						}
					}
				}
			}
				.className('_spacer')
				.style({ '--MI_SPACER-w': '700px' })
		}
	}
}
export default UserLists
