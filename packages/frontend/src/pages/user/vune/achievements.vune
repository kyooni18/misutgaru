/* @misutgaru-vune-native */
import { VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkAchievements from '@/components/vune/MkAchievements.vune';

type Props = { user: Misskey.entities.User; withDescription: boolean };
export struct UserAchievements: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			MkAchievements(props.user, withLocked: false, withDescription: props.withDescription)
		}
			.className('_spacer')
			.style({ '--MI_SPACER-w': '1200px' })
	}
}
export default UserAchievements
