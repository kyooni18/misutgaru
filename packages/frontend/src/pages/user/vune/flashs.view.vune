/* @misutgaru-vune-native */
import { VStack, ForEach, Group } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkFlashPreview from '@/components/vune/MkFlashPreview.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import type { IPaginator } from '@/utility/paginator.js';

type Props = { paginator: IPaginator };
function items(paginator: IPaginator): Misskey.entities.Flash[] { return paginator.items.value as Misskey.entities.Flash[]; }

export struct FlashsView: View {
	let props: Props
	init(_ props: Props) { self.props = props }

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			MkPagination(props.paginator, withControl: true) {
				Group() {
					ForEach(items(props.paginator), key: flash => flash.id) { flash in
						MkFlashPreview({ flash }).className('_margin')
					}
				}
			}
		}
			.className('_spacer')
			.style({ '--MI_SPACER-w': '700px' })
	}
}

export default FlashsView
