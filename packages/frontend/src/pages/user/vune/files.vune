/* @misutgaru-vune-native */
import { VStack, ForEach } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkNoteMediaGrid from '@/components/vune/MkNoteMediaGrid.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import type { IPaginator } from '@/utility/paginator.js';

type Props = { paginator: IPaginator };
function notes(paginator: IPaginator): Misskey.entities.Note[] { return paginator.items.value as Misskey.entities.Note[]; }
export struct UserFiles: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		return VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 0) {
				MkPagination(props.paginator, withControl: true) {
					VStack(alignment: 'stretch', spacing: 0) {
						ForEach(notes(props.paginator), key: note => note.id) { note in MkNoteMediaGrid({ note: note, square: true }) }
					}.className('mk-vune-user-files-stream')
				}
			}.className('mk-vune-user-files-root')
		}
			.className('_spacer')
			.style({ '--MI_SPACER-w': '1100px' })
	}
}
export default UserFiles
