/* @misutgaru-vune-native */
import { VStack, ForEach, Group } from 'vune-ui';
import MkPagePreview from '@/components/vune/MkPagePreview.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import type { IPaginator } from '@/utility/paginator.js';

type Props = { paginator: IPaginator };


export struct VunePagesView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			MkPagination(props.paginator, withControl: true) {
				Group() {
					ForEach(props.paginator.items.value as any[], key: (page: any) => page.id) { page in
						MkPagePreview({ page }).className('_margin')
					}
				}
			}
		}.className('_spacer').style({ '--MI_SPACER-w': '700px' })
	}
}

export default VunePagesView
