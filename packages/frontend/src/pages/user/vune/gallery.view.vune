/* @misutgaru-vune-native */
import { VStack, ForEach, Group } from 'vune-ui';
import MkGalleryPostPreview from '@/components/vune/MkGalleryPostPreview.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import type { IPaginator } from '@/utility/paginator.js';
import '@/vune/phase5-migration.scss';

type Props = { paginator: IPaginator };


export struct VuneGalleryView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			MkPagination(props.paginator, withControl: true) {
				Group() { ForEach(props.paginator.items.value as any[], key: (post: any) => post.id) { post in MkGalleryPostPreview(post, className: 'post') } }
					.className('mk-vune-gallery-grid')
			}
		}.className('_spacer').style({ '--MI_SPACER-w': '700px' })
	}
}

export default VuneGalleryView
