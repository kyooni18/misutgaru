/* @misutgaru-vune-native */
import { VStack, ForEach, Group, Text } from 'vune-ui';
import MkA from '@/components/global/vune/MkA.vune';
import MkPagination from '@/components/vune/MkPagination.vune';
import type { IPaginator } from '@/utility/paginator.js';
import '@/vune/phase5-migration.scss';

type Props = { paginator: IPaginator };
function items(paginator: IPaginator): any[] { return paginator.items.value as any[]; }

export struct ClipsView: View {
	let props: Props
	init(_ props: Props) { self.props = props }

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			MkPagination(props.paginator, withControl: true) {
				Group() {
					ForEach(items(props.paginator), key: item => item.id) { item in
						MkA(`/clips/${item.id}`, className: '_panel _margin mk-vune-clip') {
							Group() {
								Text(item.name).bold()
								if (item.description) { Text(item.description).className('mk-vune-clip__description') }
							}
						}
					}
				}
			}
		}
			.className('_spacer')
			.style({ '--MI_SPACER-w': '700px' })
	}
}

export default ClipsView
