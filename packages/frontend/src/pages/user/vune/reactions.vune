import { VStack, ForEach } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkPagination from '@/components/vune/MkPagination.vune';
import MkNote from '@/components/vune/MkNote.vune';
import MkReactionIcon from '@/components/vune/MkReactionIcon.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkTimeValue from '@/components/global/vune/MkTimeValue.vune';
import type { IPaginator } from '@/utility/paginator.js';
type Props={paginator:IPaginator;user:Misskey.entities.User};
export struct VuneReactionsView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { VStack(alignment: 'stretch', spacing: 0){MkPagination(props.paginator){ForEach(props.paginator.items.value as any[],key:item=>item.id){item in VStack(alignment: 'stretch', spacing: 0){VStack(alignment: 'stretch', spacing: 0){MkAvatar(props.user,className:'mk-vune-reaction-avatar');MkReactionIcon(item.type,noStyle:true,className:'mk-vune-reaction-icon');MkTimeValue(item.createdAt)}.className('mk-vune-reaction-header');MkNote(item.note)}.className('_panel _margin')}}}.className('_spacer').style({'--MI_SPACER-w':'700px'}) } }
export default VuneReactionsView
