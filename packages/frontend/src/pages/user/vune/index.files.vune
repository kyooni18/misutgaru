/* @misutgaru-vune-native */
import { ForEach, Group, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkContainer from '@/components/vune/MkContainer.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import MkNoteMediaGrid from '@/components/vune/MkNoteMediaGrid.vune';
import MkButton from '@/components/vune/MkButton.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = { fetching: boolean; notes: Misskey.entities.Note[]; rootClass?: string; streamClass?: string; onShowMore?: () => void };
export struct UserIndexFiles: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		return MkContainer(icon: VuneIcon('ti ti-photo'), header: Text(i18n.ts.files)) {
			Group() {
				if (props.fetching) { MkLoading() }
				if (!props.fetching && props.notes.length > 0) {
					Group() {
						Group() {
							ForEach(props.notes, key: note => note.id) { note in MkNoteMediaGrid({ note: note }) }
						}.className(props.streamClass)
						MkButton(rounded: true, full: true, onClick: { props.onShowMore?.() }) {
							Group() { Text(`${i18n.ts.showMore} `); VuneIcon('ti ti-arrow-right') }
						}
					}.className('_gaps_s')
				}
				if (!props.fetching && props.notes.length === 0) { Text(i18n.ts.nothing) }
			}.className(props.rootClass)
		}
	}
}
export default UserIndexFiles
