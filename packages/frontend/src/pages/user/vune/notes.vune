import { VStack } from 'vune-ui';
import MkStickyContainer from '@/components/global/vune/MkStickyContainer.vune';
import MkTab from '@/components/vune/MkTab.vune';
import MkNotesTimeline from '@/components/vune/MkNotesTimeline.vune';
import { i18n } from '@/i18n.js';
import type { IPaginator } from '@/utility/paginator.js';

type UserTab = 'featured' | 'notes' | 'all' | 'files';
type Props = { tab: UserTab; featuredPaginator: IPaginator<any, any>; notesPaginator: IPaginator<any, any>; tabClass: string; timelineClass: string; onTabChange?: (tab: UserTab) => void };
const tabs = [
	{ key: 'featured', label: i18n.ts.featured }, { key: 'notes', label: i18n.ts.notes }, { key: 'all', label: i18n.ts.all }, { key: 'files', label: i18n.ts.withFiles },
];
function updateTab(props: Props, value: string): void { props.onTabChange?.(value as UserTab); }
struct UserNotesTabHeader: View {
	let props: Props
	var body: some View {
		MkTab(tabs, selection: props.tab, onSelect: { value in updateTab(props, value) }).className(props.tabClass)
	}
}


export struct VuneNotesView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
			MkStickyContainer(header: UserNotesTabHeader(props: props)) {
				MkNotesTimeline(props.tab === 'featured' ? props.featuredPaginator : props.notesPaginator, noGap: true).className(props.timelineClass)
			}
		}.className('_spacer').style({ '--MI_SPACER-w': '800px' })
	}
}

export default VuneNotesView
