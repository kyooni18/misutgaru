/* @misutgaru-vune-native */
import { VStack, Animation, ForEach, Image, Text } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkContainer from '@/components/vune/MkContainer.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import MkA from '@/components/global/vune/MkA.vune';
import ComputedMiniChart from '@/vune/ComputedMiniChart.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = {
	showHeader?: boolean;
	fetching?: boolean;
	instances: Misskey.entities.FederationInstance[];
	charts: Misskey.entities.ChartsInstanceResponse[];
	getInstanceIcon: (instance: Misskey.entities.FederationInstance) => string;
};

struct FederationRows: View {
	let props: Props
	let rows: Array<{ instance: Misskey.entities.FederationInstance; index: number }>
	init(_ props: Props) { self.props = props; self.rows = props.instances.map((instance, index) => ({ instance, index })) }
	var body: some View {
	VStack(alignment: 'leading', spacing: 0) {
		ForEach(rows, key: row => row.instance.id) { row in
			VStack(alignment: 'leading', spacing: 0) {
				Image(props.getInstanceIcon(row.instance), { alt: '' }).withProps({ loading: 'lazy' })
				VStack(alignment: 'leading', spacing: 0) {
					MkA(`/instance-info/${row.instance.host}`, behavior: 'window', className: 'a') {
						Text(row.instance.host)
					}
						.withProps({ title: row.instance.host })
					Text(`${row.instance.softwareName || '?'} ${row.instance.softwareVersion ?? ''}`)
				}.className('body')
				ComputedMiniChart(props.charts[row.index]?.requests.received ?? [], gradientId: `mk-vune-federation-chart-${row.index}-${row.instance.id}`, className: 'chart')
			}.className('instance')
		}
	}.className('instances')
		.animation(Animation.easeInOut(1), value: props.instances.map(instance => instance.id).join(':'))
	}
}

export struct WidgetFederation: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkContainer(
			showHeader: props.showHeader ?? true,
			className: 'mkw-federation',
			testId: 'mkw-federation',
			icon: VuneIcon('ti ti-whirl'),
			header: Text(i18n.ts._widgets.federation),
		) {
			VStack(alignment: 'leading', spacing: 0) {
				if (props.fetching) { MkLoading() }
				else { FederationRows(props) }
			}.className('wbrkwalb')
		}
	}
}

export default WidgetFederation
