import { Element, ForEach, Text } from 'vune-ui';
import { TransitionGroup } from 'vue';
import type * as Misskey from 'misskey-js';
import MkContainer from '@/components/MkContainer.vue';
import MkLoading from '@/components/global/MkLoading.vue';
import MkA from '@/components/global/MkA.vue';
import MkMiniChart from '@/components/MkMiniChart.vue';
import { i18n } from '@/i18n.js';
import { prefer } from '@/preferences.js';
import { createVuneComponent, VueComponent, vuneBoolean } from '@/vune/vue.js';

type Props = {
	showHeader?: boolean;
	fetching?: boolean;
	instances: Misskey.entities.FederationInstance[];
	charts: Misskey.entities.ChartsInstanceResponse[];
	getInstanceIcon: (instance: Misskey.entities.FederationInstance) => string;
};

export default createVuneComponent<Props>((props) => {
	const rows = props.instances.map((instance, index) => ({ instance, index }));
	return VueComponent(MkContainer, {
		showHeader: vuneBoolean(props.showHeader, true),
		'data-testid': 'mkw-federation',
		class: 'mkw-federation',
	}, {
		icon: () => Element('i', { className: 'ti ti-whirl' }),
		header: () => Text(i18n.ts._widgets.federation),
		default: () => Element('div', { className: 'wbrkwalb' },
			vuneBoolean(props.fetching) ? VueComponent(MkLoading) : VueComponent(TransitionGroup as any, {
				tag: 'div',
				name: prefer.s.animation ? 'chart' : '',
				class: 'instances',
			}, {
				default: () => ForEach(rows, key: (row) => row.instance.id) { row in
					Element('div', { className: 'instance' },
						Element('img', { src: props.getInstanceIcon(row.instance), alt: '' }),
						Element('div', { className: 'body' },
							VueComponent(MkA, { class: 'a', to: `/instance-info/${row.instance.host}`, behavior: 'window', title: row.instance.host }, {
								default: () => Text(row.instance.host),
							}),
							Element('p', {}, `${row.instance.softwareName || '?'} ${row.instance.softwareVersion ?? ''}`),
						),
						props.charts[row.index] ? VueComponent(MkMiniChart, { class: 'chart', src: props.charts[row.index].requests.received }) : null,
					)
				},
			}),
		),
	});
});
