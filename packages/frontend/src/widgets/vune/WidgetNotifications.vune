import { Button, Text } from 'vune-ui';
import MkContainer from '@/components/vune/MkContainer.vune';
import MkStreamingNotificationsTimeline from '@/components/vune/MkStreamingNotificationsTimeline.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = {
	showHeader?: boolean;
	height: number;
	excludeTypes: readonly string[];
	onConfigure?: () => void;
};

function configure(props: Props): void { props.onConfigure?.(); }
function configureButton(props: Props) {
	return Button(action: { configure(props) }, label: { VuneIcon('ti ti-settings') }).className('_button');
}

export struct VuneWidgetNotificationsView: View {
	let props: Props

	init(_ props: Props) { self.props = props }

	var body: some View {
		MkContainer(
			showHeader: props.showHeader ?? true,
			scrollable: true,
			className: 'mkw-notifications',
			style: { height: `${props.height}px` },
			testId: 'mkw-notifications',
			icon: VuneIcon('ti ti-bell'),
			header: Text(i18n.ts.notifications),
			func: configureButton(props),
		) { MkStreamingNotificationsTimeline(excludeTypes: [...props.excludeTypes]) }
	}
}

export default VuneWidgetNotificationsView
