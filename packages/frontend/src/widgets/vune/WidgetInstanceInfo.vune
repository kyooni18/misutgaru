import { VStack, Image, Text } from 'vune-ui';
import MkA from '@/components/global/vune/MkA.vune';
import { host } from '@@/js/config.js';
import { instance } from '@/instance.js';
import '@/vune/phase6-migration.scss';



export struct VuneWidgetInstanceInfoView: View {
	init() {}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) {
					Image(instance.iconUrl ?? '/favicon.ico', { alt: '' })
						.className('mk-vune-identity-widget__avatar mk-vune-identity-widget__avatar--instance')
				}.className('mk-vune-identity-widget__avatar-wrap')
				VStack(alignment: 'stretch', spacing: 0) {
					VStack(alignment: 'stretch', spacing: 0) {
						MkA('/about', behavior: 'window', className: 'mk-vune-identity-widget__name') { Text(instance.name ?? '') }
						Text(host).className('mk-vune-identity-widget__sub')
					}.className('mk-vune-identity-widget__body')
				}.className('mk-vune-identity-widget__body-wrap')
			}
				.className('mk-vune-identity-widget')
				.style({ backgroundImage: instance.bannerUrl ? `url(${instance.bannerUrl})` : undefined })
		}.className('_panel')
	}
}

export default VuneWidgetInstanceInfoView
