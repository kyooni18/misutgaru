import { VStack, Binding, ForEach, Text, TextEditor } from 'vune-ui';
import MkContainer from '@/components/vune/MkContainer.vune';
import MkButton from '@/components/vune/MkButton.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';
import '@/vune/phase6-migration.scss';

type LogEntry = { id: string; text: string; print: boolean };
type ScriptInputAction = (value: string) => void;

function ignoreScriptInput(_value: string): void {}
function ignoreRun(): void {}

export struct WidgetAiscript: View {
	let showHeader: boolean
	let script: string
	let logs: LogEntry[]
	let onScriptInput: ScriptInputAction
	let onRun: () => void

	init(
		_ script: string,
		logs: LogEntry[],
		showHeader: boolean = true,
		@Action onScriptInput: ScriptInputAction = ignoreScriptInput,
		@Action onRun: () => void = ignoreRun,
	) {
		self.script = script
		self.logs = logs
		self.showHeader = showHeader
		self.onScriptInput = onScriptInput
		self.onRun = onRun
	}

	var body: some View {
		MkContainer(
			showHeader: showHeader,
			className: 'mkw-aiscript',
			testId: 'mkw-aiscript',
			icon: VuneIcon('ti ti-terminal-2'),
			header: Text(i18n.ts._widgets.aiscript),
		) {
			VStack(alignment: 'stretch', spacing: 0) {
				TextEditor(Binding(() => script, (value: string) => onScriptInput(value)), '(1 + 1)')
					.className('mk-vune-aiscript__textarea')
				MkButton(primary: true, className: 'mk-vune-aiscript__run', onClick: { onRun() }) { Text('RUN') }
				VStack(alignment: 'stretch', spacing: 0) {
					ForEach(logs, key: log => log.id) { log in
						Text(log.text).className(['mk-vune-aiscript__log', log.print ? 'mk-vune-aiscript__log--print' : null])
					}
				}.className('mk-vune-aiscript__logs')
			}.className('mk-vune-aiscript _monospace')
		}
	}
}

export default WidgetAiscript
