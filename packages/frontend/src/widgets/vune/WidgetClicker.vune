import { Text } from 'vune-ui';
import MkContainer from '@/components/vune/MkContainer.vune';
import MkClickerGame from '@/components/vune/MkClickerGame.vune';
import VuneIcon from '@/vune/Icon.vune';

type Props = { showHeader?: boolean };


export struct VuneWidgetClickerView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkContainer(showHeader: props.showHeader ?? true, className: 'mkw-clicker', icon: VuneIcon('ti ti-cookie'), header: Text('Clicker')) { MkClickerGame() }
	}
}

export default VuneWidgetClickerView
