import type * as Misskey from 'misskey-js';
import MkA from '@/components/global/vune/MkA.vune';
import MkAcct from '@/components/global/vune/MkAcct.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkUserName from '@/components/global/vune/MkUserName.vune';
import { VStack } from 'vune-ui';
import { userPage } from '@/filters/user.js';
import '@/vune/phase6-migration.scss';

type Props = { user: Misskey.entities.UserDetailed };

export struct WidgetProfile: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 0) {
				VStack(alignment: 'stretch', spacing: 0) { MkAvatar(props.user, className: 'mk-vune-identity-widget__avatar') }
					.className('mk-vune-identity-widget__avatar-wrap')
				VStack(alignment: 'stretch', spacing: 0) {
					VStack(alignment: 'stretch', spacing: 0) {
						MkA(userPage(props.user), className: 'mk-vune-identity-widget__name') { MkUserName({ user: props.user }) }
						VStack(alignment: 'stretch', spacing: 0) { MkAcct(props.user, detail: true) }.className('mk-vune-identity-widget__sub')
					}.className('mk-vune-identity-widget__body')
				}.className('mk-vune-identity-widget__body-wrap')
			}
				.className('mk-vune-identity-widget')
				.style({ backgroundImage: props.user.bannerUrl ? `url(${props.user.bannerUrl})` : undefined })
		}.className('_panel')
	}
}

export default WidgetProfile
