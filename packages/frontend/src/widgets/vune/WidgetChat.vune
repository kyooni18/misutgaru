import { Button, Text } from 'vune-ui';
import MkContainer from '@/components/vune/MkContainer.vune';
import MkChatHistories from '@/components/vune/MkChatHistories.vune';
import { i18n } from '@/i18n.js';
import VuneIcon from '@/vune/Icon.vune';

type Props = { showHeader?: boolean; onConfigure?: () => void };
function runConfigure(props: Props): void { props.onConfigure?.(); }
function configureButton(props: Props) { return Button(action: { runConfigure(props) }, label: { VuneIcon('ti ti-settings') }).className('_button'); }


export struct VuneWidgetChatView: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkContainer(
			showHeader: props.showHeader ?? true,
			className: 'mkw-chat',
			icon: VuneIcon('ti ti-users'),
			header: Text(i18n.ts._widgets.chat),
			func: configureButton(props),
		) { MkChatHistories() }
	}
}

export default VuneWidgetChatView
