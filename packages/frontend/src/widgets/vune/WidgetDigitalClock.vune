/* @misutgaru-vune-native */
import { VStack, Text } from 'vune-ui';
import MkDigitalClock from '@/components/vune/MkDigitalClock.vune';

export struct WidgetDigitalClock: View {
	let transparent: boolean
	let fontSize: number
	let showMs: boolean
	let showLabel: boolean
	let tzAbbrev: string
	let tzOffsetLabel: string
	let rootClass: string
	let labelClass: string
	let hh: string
	let mm: string
	let ss: string
	let ms: string
	let showColon: boolean

	init(
		transparent: boolean = false,
		fontSize: number,
		showMs: boolean = false,
		showLabel: boolean = false,
		tzAbbrev: string,
		tzOffsetLabel: string,
		rootClass: string,
		labelClass: string,
		hh: string,
		mm: string,
		ss: string,
		ms: string,
		showColon: boolean = false,
	) {
		self.transparent = transparent
		self.fontSize = fontSize
		self.showMs = showMs
		self.showLabel = showLabel
		self.tzAbbrev = tzAbbrev
		self.tzOffsetLabel = tzOffsetLabel
		self.rootClass = rootClass
		self.labelClass = labelClass
		self.hh = hh
		self.mm = mm
		self.ss = ss
		self.ms = ms
		self.showColon = showColon
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			if (showLabel) { Text(tzAbbrev).className(labelClass) }
			MkDigitalClock(hh, mm, ss, ms, showMs: showMs, showColon: showColon)
			if (showLabel) { Text(tzOffsetLabel).className(labelClass) }
		}
			.className(['_monospace', rootClass, !transparent ? '_panel' : null])
			.fontSize(`${fontSize}em`)
			.withProps({ 'data-testid': 'mkw-digitalClock' })
	}
}

export default WidgetDigitalClock
