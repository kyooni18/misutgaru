import { VStack, ForEach, Text } from 'vune-ui'; import MkContainer from '@/components/vune/MkContainer.vune'; import MkLoading from '@/components/global/vune/MkLoading.vune'; import XCalendar from '@/widgets/vune/WidgetActivity.calendar.vune'; import VuneIcon from '@/vune/Icon.vune'; import MkButton from '@/components/vune/MkButton.vune'; import { i18n } from '@/i18n.js';
type Activity={total:number;notes:number;replies:number;renotes:number}[]; type Props={showHeader?:boolean;transparent?:boolean;view:number;fetching?:boolean;activity?:Activity|null;onToggleView?:()=>void}; function toggle(props:Props){props.onToggleView?.()}
export struct VuneWidgetActivityView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { MkContainer(showHeader:props.showHeader??true,naked:props.transparent===true,className:'mkw-activity',testId:'mkw-activity',icon:VuneIcon('ti ti-chart-line'),header:Text(i18n.ts._widgets.activity),func:MkButton(transparent:true,iconOnly:true,onClick:{toggle(props)}){VuneIcon('ti ti-selector')}){if(props.fetching){MkLoading()}else if(props.view===0){XCalendar(props.activity??[])}else{VStack(alignment: 'stretch', spacing: 0){ForEach((props.activity??[]).slice(0,14),key:(_item,index)=>index){item in VStack(alignment: 'stretch', spacing: 0).style({height:'4px',width:`${Math.min(100,item.total)}%`,background:'var(--MI_THEME-accent)'})}}.className('mk-vune-activity-chart')}} } }
export default VuneWidgetActivityView
