/* @misutgaru-vune-native */
import { Button } from 'vune-ui';

export struct WidgetButton: View {
	let label: string
	let colored: boolean
	let onRun: () => void

	init(_ label: string = '', colored: boolean = true, @Action onRun: () => void) {
		self.label = label
		self.colored = colored
		self.onRun = onRun
	}

	var body: some View {
		Button(label) { onRun() }
			.className(['_button', colored ? '_buttonPrimary' : null, 'mkw-button__native'])
			.withProps({ 'data-testid': 'mkw-button' })
			.style({ width: '100%' })
	}
}

export default WidgetButton
