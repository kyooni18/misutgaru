/* @misutgaru-vune-native */
import { VStack, Button, ForEach, Text, type ViewGraphValue } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import MkContainer from '@/components/vune/MkContainer.vune';
import MkButton from '@/components/vune/MkButton.vune';
import MkAvatar from '@/components/global/vune/MkAvatar.vune';
import MkLoading from '@/components/global/vune/MkLoading.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';

type Props = {
	showHeader?: boolean;
	listId?: string | null;
	list?: Misskey.entities.UserList | null;
	users: Misskey.entities.UserDetailed[];
	fetching?: boolean;
	rootClass: string;
	onChooseList?: () => void;
	onConfigure?: () => void;
};

function ignoreAction(): void {}
function runConfigure(props: Props): void { (props.onConfigure ?? ignoreAction)(); }

function configureButton(props: Props): ViewGraphValue {
	return Button(action: { runConfigure(props) }, label: { VuneIcon('ti ti-settings') })
		.className('_button mk-vune-container__header-button');
}

function userListContent(props: Props): ViewGraphValue {
	if (props.listId == null) {
		return VStack(alignment: 'stretch', spacing: 0) { VStack(alignment: 'stretch', spacing: 0) { MkButton(primary: true, onClick: { props.onChooseList?.() }) { Text(i18n.ts._widgets._userList.chooseList) } }.className('init') }.className(props.rootClass);
	}
	if (props.fetching) {
		return VStack(alignment: 'stretch', spacing: 0) { MkLoading() }.className(props.rootClass);
	}
	return VStack(alignment: 'stretch', spacing: 0) {
		VStack(alignment: 'stretch', spacing: 0) {
			ForEach(props.users, key: user => user.id) { user in
				VStack(alignment: 'stretch', spacing: 0) { MkAvatar(user, indicator: true, link: true, preview: true, className: 'avatar') }.className('user')
			}
		}.className('users')
	}.className(props.rootClass);
}

export struct WidgetUserList: View {
	let props: Props

	init(_ props: Props) {
		self.props = props
	}

	var body: some View {
		MkContainer(
			showHeader: props.showHeader ?? true,
			className: 'mkw-userList',
			icon: VuneIcon('ti ti-users'),
			header: Text(props.list ? props.list.name : i18n.ts._widgets.userList),
			func: configureButton(props),
		) {
			userListContent(props)
		}
	}
}

export default WidgetUserList
