import { VStack, Text } from 'vune-ui';
import { i18n } from '@/i18n.js';
import number from '@/filters/number.js';

type StyleClasses = Record<string, string>;

function onlineUsersLabel(count: number) {
	const [before = '', after = ''] = i18n.ts.onlineUsersCount.split('{n}');
	return VStack(alignment: 'stretch', spacing: 0) {
		Text(before)
		Text(number(count)).bold().foregroundStyle('#41b781')
		Text(after)
	}.className('mk-vune-online-users__label');
}

export struct WidgetOnlineUsers: View {
	let onlineUsersCount: number
	let transparent: boolean
	let classes: StyleClasses

	init(
		_ onlineUsersCount: number,
		transparent: boolean = true,
		classes: StyleClasses,
	) {
		self.onlineUsersCount = onlineUsersCount
		self.transparent = transparent
		self.classes = classes
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			if (onlineUsersCount > 0) { onlineUsersLabel(onlineUsersCount) }
		}
			.className([classes.root, !transparent ? '_panel' : null, !transparent ? classes.pad : null, classes.text])
			.withProps({ 'data-testid': 'mkw-onlineUsers' })
	}
}

export default WidgetOnlineUsers
