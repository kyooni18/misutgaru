/* @misutgaru-vune-native */
import { nativeElement } from '@/vune/native.js';
import Pie from './pie.vune';
import bytes from '@/filters/bytes.js';

export struct Disk: View {
	let usage: number
	let total: number
	let used: number
	let available: number

	init(_ usage: number, _ total: number, _ used: number, _ available: number) {
		self.usage = usage
		self.total = total
		self.used = used
		self.available = available
	}

	var body: some View {
		nativeElement('div', { className: 'zbwaqsat' },
			Pie(usage).className('pie'),
			nativeElement('div', {},
				nativeElement('p', {}, nativeElement('i', { className: 'ti ti-database' }), 'Disk'),
				nativeElement('p', {}, `Total: ${bytes(total, 1)}`),
				nativeElement('p', {}, `Free: ${bytes(available, 1)}`),
				nativeElement('p', {}, `Used: ${bytes(used, 1)}`),
			),
		)
	}
}

export default Disk
