import { HStack, Text, VStack } from 'vune-ui';
import Pie from './pie.vune';
import bytes from '@/filters/bytes.js';
import VuneIcon from '@/vune/Icon.vune';

export struct Disk: View {
	let usage: number
	let total: number
	let used: number
	let available: number

	init(_ usage: number, _ total: number, _ used: number, _ available: number) {
		self.usage = usage
		self.total = total
		self.used = used
		self.available = available
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			Pie(usage).className('pie')
			VStack(alignment: 'leading', spacing: 0) {
				HStack(alignment: 'center', spacing: 4) {
					VuneIcon('ti ti-database')
					Text('Disk')
				}.className(['server-metric__line', 'server-metric__line--heading'])
				Text(`Total: ${bytes(total, 1)}`).className('server-metric__line')
				Text(`Free: ${bytes(available, 1)}`).className('server-metric__line')
				Text(`Used: ${bytes(used, 1)}`).className('server-metric__line')
			}.className('server-metric__details')
		}.className('zbwaqsat')
	}
}

export default Disk
