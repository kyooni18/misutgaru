import { Element } from 'vune-ui';
import { createVuneComponent } from '@/vune/vue.js';

type Props = {
	viewBoxX: number;
	viewBoxY: number;
	cpuGradientId: string;
	cpuMaskId: string;
	memGradientId: string;
	memMaskId: string;
	cpuPolylinePoints: string;
	memPolylinePoints: string;
	cpuPolygonPoints: string;
	memPolygonPoints: string;
	cpuHeadX?: number;
	cpuHeadY?: number;
	memHeadX?: number;
	memHeadY?: number;
	cpuP: string;
	memP: string;
};

function graph(
	gradientId: string,
	maskId: string,
	viewBoxX: number,
	viewBoxY: number,
	polygonPoints: string,
	polylinePoints: string,
	headX: number | undefined,
	headY: number | undefined,
	label: string,
	percent: string,
) {
	return Element('svg', {},
		Element('defs', {},
			Element('linearGradient', {},
				Element('stop', {}).withProps({ offset: '0%', 'stop-color': 'hsl(180, 80%, 70%)' }),
				Element('stop', {}).withProps({ offset: '100%', 'stop-color': 'hsl(0, 80%, 70%)' }),
			).withProps({ id: gradientId, x1: '0', x2: '0', y1: '1', y2: '0' }),
			Element('mask', {},
				Element('polygon', {}).withProps({ points: polygonPoints, fill: '#fff', 'fill-opacity': '0.5' }),
				Element('polyline', {}).withProps({ points: polylinePoints, fill: 'none', stroke: '#fff', 'stroke-width': '1' }),
				Element('circle', {}).withProps({ cx: headX, cy: headY, r: '1.5', fill: '#fff' }),
			).withProps({ id: maskId, x: '0', y: '0', width: viewBoxX, height: viewBoxY }),
		),
		Element('rect', { style: { stroke: 'none', fill: `url(#${gradientId})`, mask: `url(#${maskId})` } }).withProps({
			x: '-2', y: '-2', width: viewBoxX + 4, height: viewBoxY + 4,
		}),
		Element('text', {}, `${label} `, Element('tspan', {}, `${percent}%`)).withProps({ x: '1', y: '5' }),
	).withProps({ viewBox: `0 0 ${viewBoxX} ${viewBoxY}` });
}

export default createVuneComponent<Props>((props) =>
	Element('div', { className: 'lcfyofjk' },
		graph(props.cpuGradientId, props.cpuMaskId, props.viewBoxX, props.viewBoxY, props.cpuPolygonPoints, props.cpuPolylinePoints, props.cpuHeadX, props.cpuHeadY, 'CPU', props.cpuP),
		graph(props.memGradientId, props.memMaskId, props.viewBoxX, props.viewBoxY, props.memPolygonPoints, props.memPolylinePoints, props.memHeadX, props.memHeadY, 'MEM', props.memP),
	)
);
