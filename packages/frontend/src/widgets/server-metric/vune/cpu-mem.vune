import { HStack } from 'vune-ui';
import { Canvas } from '@vune-ui/core/web-primitives';

type Props = {
	viewBoxX: number;
	viewBoxY: number;
	cpuGradientId: string;
	cpuMaskId: string;
	memGradientId: string;
	memMaskId: string;
	cpuPolylinePoints: string;
	memPolylinePoints: string;
	cpuPolygonPoints: string;
	memPolygonPoints: string;
	cpuHeadX?: number;
	cpuHeadY?: number;
	memHeadX?: number;
	memHeadY?: number;
	cpuP: string;
	memP: string;
};

function graph(
	gradientId: string,
	maskId: string,
	viewBoxX: number,
	viewBoxY: number,
	polygonPoints: string,
	polylinePoints: string,
	headX: number | undefined,
	headY: number | undefined,
	label: string,
	percent: string,
) {
	const parse = (points: string) => points.trim().split(/\s+/).flatMap(pair => {
		const [x, y] = pair.split(',').map(Number);
		return Number.isFinite(x) && Number.isFinite(y) ? [[x, y] as [number, number]] : [];
	});
	return Canvas(viewBoxX, viewBoxY, (node: unknown) => {
		if (!(node instanceof HTMLCanvasElement)) return;
		const context = node.getContext('2d');
		if (!context) return;
		context.clearRect(0, 0, viewBoxX, viewBoxY);
		const gradient = context.createLinearGradient(0, viewBoxY, 0, 0);
		gradient.addColorStop(0, 'hsl(180, 80%, 70%)'); gradient.addColorStop(1, 'hsl(0, 80%, 70%)');
		const polygon = parse(polygonPoints);
		if (polygon.length > 1) {
			context.globalAlpha = 0.5; context.fillStyle = gradient; context.beginPath();
			polygon.forEach(([x, y], index) => index === 0 ? context.moveTo(x, y) : context.lineTo(x, y)); context.closePath(); context.fill(); context.globalAlpha = 1;
		}
		const line = parse(polylinePoints);
		if (line.length > 1) {
			context.strokeStyle = gradient; context.lineWidth = 1; context.beginPath();
			line.forEach(([x, y], index) => index === 0 ? context.moveTo(x, y) : context.lineTo(x, y)); context.stroke();
		}
		if (headX != null && headY != null) { context.fillStyle = gradient; context.beginPath(); context.arc(headX, headY, 1.5, 0, Math.PI * 2); context.fill(); }
		context.fillStyle = 'currentColor'; context.font = '4.5px sans-serif'; context.fillText(`${label} ${percent}%`, 1, 5);
	}).withProps({ 'data-gradient-id': gradientId, 'data-mask-id': maskId });
}

export struct CpuMem: View {
	let viewBoxX: number
	let viewBoxY: number
	let cpuGradientId: string
	let cpuMaskId: string
	let memGradientId: string
	let memMaskId: string
	let cpuPolylinePoints: string
	let memPolylinePoints: string
	let cpuPolygonPoints: string
	let memPolygonPoints: string
	let cpuP: string
	let memP: string
	let cpuHeadX: number | undefined
	let cpuHeadY: number | undefined
	let memHeadX: number | undefined
	let memHeadY: number | undefined

	init(
		_ viewBoxX: number,
		_ viewBoxY: number,
		_ cpuGradientId: string,
		_ cpuMaskId: string,
		_ memGradientId: string,
		_ memMaskId: string,
		_ cpuPolylinePoints: string,
		_ memPolylinePoints: string,
		_ cpuPolygonPoints: string,
		_ memPolygonPoints: string,
		_ cpuP: string,
		_ memP: string,
		_ cpuHeadX: number | undefined = undefined,
		_ cpuHeadY: number | undefined = undefined,
		_ memHeadX: number | undefined = undefined,
		_ memHeadY: number | undefined = undefined,
	) {
		self.viewBoxX = viewBoxX
		self.viewBoxY = viewBoxY
		self.cpuGradientId = cpuGradientId
		self.cpuMaskId = cpuMaskId
		self.memGradientId = memGradientId
		self.memMaskId = memMaskId
		self.cpuPolylinePoints = cpuPolylinePoints
		self.memPolylinePoints = memPolylinePoints
		self.cpuPolygonPoints = cpuPolygonPoints
		self.memPolygonPoints = memPolygonPoints
		self.cpuP = cpuP
		self.memP = memP
		self.cpuHeadX = cpuHeadX
		self.cpuHeadY = cpuHeadY
		self.memHeadX = memHeadX
		self.memHeadY = memHeadY
	}

	var body: some View {
		HStack(spacing: 0) {
			graph(cpuGradientId, cpuMaskId, viewBoxX, viewBoxY, cpuPolygonPoints, cpuPolylinePoints, cpuHeadX, cpuHeadY, 'CPU', cpuP)
			graph(memGradientId, memMaskId, viewBoxX, viewBoxY, memPolygonPoints, memPolylinePoints, memHeadX, memHeadY, 'MEM', memP)
		}.className('lcfyofjk')
	}
}

export default CpuMem
