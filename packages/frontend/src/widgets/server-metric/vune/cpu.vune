/* @misutgaru-vune-native */
import { htmlElement } from '@/vune/native.js';
import type * as Misskey from 'misskey-js';
import Pie from './pie.vune';

export struct Cpu: View {
	let usage: number
	let meta: Misskey.entities.ServerInfoResponse

	init(_ usage: number, _ meta: Misskey.entities.ServerInfoResponse) {
		self.usage = usage
		self.meta = meta
	}

	var body: some View {
		htmlElement('div', { className: 'vrvdvrys' },
			Pie(usage).className('pie'),
			htmlElement('div', {},
				htmlElement('p', {}, htmlElement('i', { className: 'ti ti-cpu' }), 'CPU'),
				htmlElement('p', {}, `${meta.cpu.cores} Logical cores`),
				htmlElement('p', {}, meta.cpu.model),
			),
		)
	}
}

export default Cpu
