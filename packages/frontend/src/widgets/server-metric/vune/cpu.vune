import { HStack, Text, VStack } from 'vune-ui';
import type * as Misskey from 'misskey-js';
import Pie from './pie.vune';
import VuneIcon from '@/vune/Icon.vune';

export struct Cpu: View {
	let usage: number
	let meta: Misskey.entities.ServerInfoResponse

	init(_ usage: number, _ meta: Misskey.entities.ServerInfoResponse) {
		self.usage = usage
		self.meta = meta
	}

	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			Pie(usage).className('pie')
			VStack(alignment: 'leading', spacing: 0) {
				HStack(alignment: 'center', spacing: 4) {
					VuneIcon('ti ti-cpu')
					Text('CPU')
				}.className(['server-metric__line', 'server-metric__line--heading'])
				Text(`${meta.cpu.cores} Logical cores`).className('server-metric__line')
				Text(meta.cpu.model).className('server-metric__line')
			}.className('server-metric__details')
		}.className('vrvdvrys')
	}
}

export default Cpu
