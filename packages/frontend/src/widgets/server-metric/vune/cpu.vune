/* @misutgaru-vune-native */
import { nativeElement } from '@/vune/native.js';
import type * as Misskey from 'misskey-js';
import Pie from './pie.vune';

export struct Cpu: View {
	let usage: number
	let meta: Misskey.entities.ServerInfoResponse

	init(_ usage: number, _ meta: Misskey.entities.ServerInfoResponse) {
		self.usage = usage
		self.meta = meta
	}

	var body: some View {
		nativeElement('div', { className: 'vrvdvrys' },
			Pie(usage).className('pie'),
			nativeElement('div', {},
				nativeElement('p', {}, nativeElement('i', { className: 'ti ti-cpu' }), 'CPU'),
				nativeElement('p', {}, `${meta.cpu.cores} Logical cores`),
				nativeElement('p', {}, meta.cpu.model),
			),
		)
	}
}

export default Cpu
