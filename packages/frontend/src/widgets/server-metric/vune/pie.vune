import { Animation } from 'vune-ui';
import { Canvas } from '@vune-ui/core/web-primitives';
import './pie.scss';

function pieRef(value: number) {
	return (node: unknown) => {
		if (!(node instanceof HTMLCanvasElement)) return;
		const context = node.getContext('2d');
		if (!context) return;
		const size = 100;
		const center = size / 2;
		const radius = 42;
		context.clearRect(0, 0, size, size);
		context.lineWidth = 10;
		context.strokeStyle = 'rgba(0, 0, 0, 0.05)';
		context.beginPath();
		context.arc(center, center, radius, 0, Math.PI * 2);
		context.stroke();
		context.strokeStyle = `hsl(${180 - (value * 180)}, 80%, 70%)`;
		context.beginPath();
		context.arc(center, center, radius, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * Math.max(0, Math.min(1, value)));
		context.stroke();
		context.fillStyle = 'currentColor';
		context.font = '18px sans-serif';
		context.textAlign = 'center';
		context.textBaseline = 'middle';
		context.fillText(`${(value * 100).toFixed(0)}%`, center, center);
	};
}

function pieView(value: number) {
	return Canvas(100, 100, pieRef(value))
		.className('mk-vune-pie')
		.animation(Animation.easeInOut(0.5), value: value);
}

export struct Pie: View {
	let value: number

	init(_ value: number) {
		self.value = value
	}

	var body: some View {
		return pieView(value);
	}
}

export default Pie
