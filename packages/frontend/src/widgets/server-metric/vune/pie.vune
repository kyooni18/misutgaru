import { Animation } from 'vune-ui';
import { svgElement } from '@/vune/native.js';
import './pie.scss';

let r = 0.45;

function pieView(value: number) {
	let color = `hsl(${180 - (value * 180)}, 80%, 70%)`;
	let circumference = Math.PI * (r * 2);
	let offset = (1 - value) * circumference;
	return svgElement('svg', { className: 'mk-vune-pie' },
		svgElement('circle', { className: 'mk-vune-pie__circle' }).withProps({ r, cx: '50%', cy: '50%', fill: 'none', 'stroke-width': '0.1', stroke: 'rgba(0, 0, 0, 0.05)' }),
		svgElement('circle', {
			className: 'mk-vune-pie__circle',
			style: { strokeDasharray: circumference, strokeDashoffset: offset },
		}).withProps({ r, cx: '50%', cy: '50%', fill: 'none', 'stroke-width': '0.1', stroke: color })
			.animation(Animation.easeInOut(0.5), value: value),
		svgElement('text', { className: 'mk-vune-pie__text' }, `${(value * 100).toFixed(0)}%`).withProps({ x: '50%', y: '50%', dy: '0.05', 'text-anchor': 'middle' }),
	).withProps({ viewBox: '0 0 1 1', preserveAspectRatio: 'none' });
}

export struct Pie: View {
	let value: number

	init(_ value: number) {
		self.value = value
	}

	var body: some View {
		return pieView(value);
	}
}

export default Pie
