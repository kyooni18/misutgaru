import { Element } from 'vune-ui';
import { createVuneComponent } from '@/vune/vue.js';

type Props = { value: number; classes: Record<string, string> };
const r = 0.45;

export default createVuneComponent<Props>((props) => {
	const color = `hsl(${180 - (props.value * 180)}, 80%, 70%)`;
	const circumference = Math.PI * (r * 2);
	const offset = (1 - props.value) * circumference;
	return Element('svg', { className: props.classes.root },
		Element('circle', { className: props.classes.circle }).withProps({ r, cx: '50%', cy: '50%', fill: 'none', 'stroke-width': '0.1', stroke: 'rgba(0, 0, 0, 0.05)' }),
		Element('circle', { className: props.classes.circle }).withProps({ r, cx: '50%', cy: '50%', 'stroke-dasharray': circumference, 'stroke-dashoffset': offset, fill: 'none', 'stroke-width': '0.1', stroke: color }),
		Element('text', { className: props.classes.text }, `${(props.value * 100).toFixed(0)}%`).withProps({ x: '50%', y: '50%', dy: '0.05', 'text-anchor': 'middle' }),
	).withProps({ viewBox: '0 0 1 1', preserveAspectRatio: 'none' });
});
