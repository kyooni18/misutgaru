import { htmlElement } from '@/vune/native.js';
import Pie from './pie.vune';
import bytes from '@/filters/bytes.js';

export struct Mem: View {
	let usage: number
	let total: number
	let used: number
	let free: number

	init(_ usage: number, _ total: number, _ used: number, _ free: number) {
		self.usage = usage
		self.total = total
		self.used = used
		self.free = free
	}

	var body: some View {
		htmlElement('div', { className: 'zlxnikvl' },
			Pie(usage).className('pie'),
			htmlElement('div', {},
				htmlElement('p', {}, htmlElement('i', { className: 'ti ti-section' }), 'RAM'),
				htmlElement('p', {}, `Total: ${bytes(total, 1)}`),
				htmlElement('p', {}, `Used: ${bytes(used, 1)}`),
				htmlElement('p', {}, `Free: ${bytes(free, 1)}`),
			),
		)
	}
}

export default Mem
