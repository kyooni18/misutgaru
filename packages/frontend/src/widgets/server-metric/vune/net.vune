/* @misutgaru-vune-native */
import { htmlElement, svgElement } from '@/vune/native.js';
import bytes from '@/filters/bytes.js';

type Props = {
	viewBoxX: number;
	viewBoxY: number;
	inPolygonPoints: string;
	outPolygonPoints: string;
	inPolylinePoints: string;
	outPolylinePoints: string;
	inHeadX?: number;
	inHeadY?: number;
	outHeadX?: number;
	outHeadY?: number;
	inRecent: number;
	outRecent: number;
};

function graph(
	viewBoxX: number,
	viewBoxY: number,
	polygonPoints: string,
	polylinePoints: string,
	headX: number | undefined,
	headY: number | undefined,
	color: string,
	label: string,
	recent: number,
) {
	return svgElement('svg', {},
		svgElement('polygon', {}).withProps({ points: polygonPoints, fill: color, 'fill-opacity': '0.5' }),
		svgElement('polyline', {}).withProps({ points: polylinePoints, fill: 'none', stroke: color, 'stroke-width': '1' }),
		svgElement('circle', {}).withProps({ cx: headX, cy: headY, r: '1.5', fill: color }),
		svgElement('text', {}, `${label} `, svgElement('tspan', {}, bytes(recent))).withProps({ x: '1', y: '5' }),
	).withProps({ viewBox: `0 0 ${viewBoxX} ${viewBoxY}` });
}

export struct Net: View {
	let viewBoxX: number
	let viewBoxY: number
	let inPolygonPoints: string
	let outPolygonPoints: string
	let inPolylinePoints: string
	let outPolylinePoints: string
	let inRecent: number
	let outRecent: number
	let inHeadX: number | undefined
	let inHeadY: number | undefined
	let outHeadX: number | undefined
	let outHeadY: number | undefined

	init(
		_ viewBoxX: number,
		_ viewBoxY: number,
		_ inPolygonPoints: string,
		_ outPolygonPoints: string,
		_ inPolylinePoints: string,
		_ outPolylinePoints: string,
		_ inRecent: number,
		_ outRecent: number,
		_ inHeadX: number | undefined = undefined,
		_ inHeadY: number | undefined = undefined,
		_ outHeadX: number | undefined = undefined,
		_ outHeadY: number | undefined = undefined,
	) {
		self.viewBoxX = viewBoxX
		self.viewBoxY = viewBoxY
		self.inPolygonPoints = inPolygonPoints
		self.outPolygonPoints = outPolygonPoints
		self.inPolylinePoints = inPolylinePoints
		self.outPolylinePoints = outPolylinePoints
		self.inRecent = inRecent
		self.outRecent = outRecent
		self.inHeadX = inHeadX
		self.inHeadY = inHeadY
		self.outHeadX = outHeadX
		self.outHeadY = outHeadY
	}

	var body: some View {
		htmlElement('div', { className: 'oxxrhrto' },
			graph(viewBoxX, viewBoxY, inPolygonPoints, inPolylinePoints, inHeadX, inHeadY, '#94a029', 'NET rx', inRecent),
			graph(viewBoxX, viewBoxY, outPolygonPoints, outPolylinePoints, outHeadX, outHeadY, '#ff9156', 'NET tx', outRecent),
		)
	}
}

export default Net
