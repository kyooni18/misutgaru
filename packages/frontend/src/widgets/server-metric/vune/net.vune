import { HStack } from 'vune-ui';
import { Canvas } from '@vune-ui/core/web-primitives';
import bytes from '@/filters/bytes.js';

type Props = {
	viewBoxX: number;
	viewBoxY: number;
	inPolygonPoints: string;
	outPolygonPoints: string;
	inPolylinePoints: string;
	outPolylinePoints: string;
	inHeadX?: number;
	inHeadY?: number;
	outHeadX?: number;
	outHeadY?: number;
	inRecent: number;
	outRecent: number;
};

function graph(
	viewBoxX: number,
	viewBoxY: number,
	polygonPoints: string,
	polylinePoints: string,
	headX: number | undefined,
	headY: number | undefined,
	color: string,
	label: string,
	recent: number,
) {
	const parse = (points: string) => points.trim().split(/\s+/).flatMap(pair => {
		const [x, y] = pair.split(',').map(Number);
		return Number.isFinite(x) && Number.isFinite(y) ? [[x, y] as [number, number]] : [];
	});
	return Canvas(viewBoxX, viewBoxY, (node: unknown) => {
		if (!(node instanceof HTMLCanvasElement)) return;
		const context = node.getContext('2d');
		if (!context) return;
		context.clearRect(0, 0, viewBoxX, viewBoxY);
		const polygon = parse(polygonPoints);
		if (polygon.length > 1) {
			context.globalAlpha = 0.5; context.fillStyle = color; context.beginPath();
			polygon.forEach(([x, y], index) => index === 0 ? context.moveTo(x, y) : context.lineTo(x, y));
			context.closePath(); context.fill(); context.globalAlpha = 1;
		}
		const line = parse(polylinePoints);
		if (line.length > 1) {
			context.strokeStyle = color; context.lineWidth = 1; context.beginPath();
			line.forEach(([x, y], index) => index === 0 ? context.moveTo(x, y) : context.lineTo(x, y)); context.stroke();
		}
		if (headX != null && headY != null) { context.fillStyle = color; context.beginPath(); context.arc(headX, headY, 1.5, 0, Math.PI * 2); context.fill(); }
		context.fillStyle = 'currentColor'; context.font = '4.5px sans-serif'; context.fillText(`${label} ${bytes(recent)}`, 1, 5);
	});
}

export struct Net: View {
	let viewBoxX: number
	let viewBoxY: number
	let inPolygonPoints: string
	let outPolygonPoints: string
	let inPolylinePoints: string
	let outPolylinePoints: string
	let inRecent: number
	let outRecent: number
	let inHeadX: number | undefined
	let inHeadY: number | undefined
	let outHeadX: number | undefined
	let outHeadY: number | undefined

	init(
		_ viewBoxX: number,
		_ viewBoxY: number,
		_ inPolygonPoints: string,
		_ outPolygonPoints: string,
		_ inPolylinePoints: string,
		_ outPolylinePoints: string,
		_ inRecent: number,
		_ outRecent: number,
		_ inHeadX: number | undefined = undefined,
		_ inHeadY: number | undefined = undefined,
		_ outHeadX: number | undefined = undefined,
		_ outHeadY: number | undefined = undefined,
	) {
		self.viewBoxX = viewBoxX
		self.viewBoxY = viewBoxY
		self.inPolygonPoints = inPolygonPoints
		self.outPolygonPoints = outPolygonPoints
		self.inPolylinePoints = inPolylinePoints
		self.outPolylinePoints = outPolylinePoints
		self.inRecent = inRecent
		self.outRecent = outRecent
		self.inHeadX = inHeadX
		self.inHeadY = inHeadY
		self.outHeadX = outHeadX
		self.outHeadY = outHeadY
	}

	var body: some View {
		HStack(spacing: 0) {
			graph(viewBoxX, viewBoxY, inPolygonPoints, inPolylinePoints, inHeadX, inHeadY, '#94a029', 'NET rx', inRecent)
			graph(viewBoxX, viewBoxY, outPolygonPoints, outPolylinePoints, outHeadX, outHeadY, '#ff9156', 'NET tx', outRecent)
		}.className('oxxrhrto')
	}
}

export default Net
