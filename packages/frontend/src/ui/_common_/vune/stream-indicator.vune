import { Element, Text } from 'vune-ui';
import MkButton from '@/components/MkButton.vue';
import { i18n } from '@/i18n.js';
import { createVuneComponent, VueComponent } from '@/vune/vue.js';

type Props = {
	visible?: boolean;
	zIndex: number;
	rootClass: string;
	commandClass: string;
	onReset?: () => void;
	onReload?: () => void;
};

export default createVuneComponent<Props>((props) =>
	props.visible
		? Element('div', {
			className: [props.rootClass, '_panel', '_shadow'],
			style: { zIndex: props.zIndex },
			onClick: () => props.onReset?.(),
		},
			Element('div', {}, Element('i', { className: 'ti ti-alert-triangle' }), ` ${i18n.ts.disconnectedFromServer}`),
			Element('div', { className: [props.commandClass, '_buttons'] },
				VueComponent(MkButton, { small: true, primary: true, onClick: () => props.onReload?.() }, { default: () => Text(i18n.ts.reload) }),
				VueComponent(MkButton, { small: true }, { default: () => Text(i18n.ts.doNothing) }),
			),
		)
		: Element('span', { style: { display: 'none' } })
);
