/* @misutgaru-vune-native */
import { VStack, ForEach, Group, NavigationLink, Text } from 'vune-ui';
import * as signIn from '@/i.js';
import VuneIcon from '@/vune/Icon.vune';
import '@/vune/phase5-migration.scss';

function iconClass(icon: string) {
	if (icon === 'warning') return 'ti ti-alert-triangle';
	if (icon === 'error') return 'ti ti-circle-x';
	if (icon === 'success') return 'ti ti-check';
	return 'ti ti-info-circle';
}
function iconStyle(icon: string) {
	if (icon === 'warning') return { color: 'var(--MI_THEME-warn)' };
	if (icon === 'error') return { color: 'var(--MI_THEME-error)' };
	if (icon === 'success') return { color: 'var(--MI_THEME-success)' };
	return {};
}
export struct Announcements: View {
	let announcements: any[]
	init() { self.announcements = signIn.$i ? signIn.$i.unreadAnnouncements.filter(x => x.display === 'banner') : [] }

	var body: some View {
		VStack(alignment: 'leading', spacing: 0) {
		ForEach(announcements, key: (announcement: any) => announcement.id) { announcement in
			NavigationLink(`/announcements/${announcement.id}`, label: {
				VStack(alignment: 'leading', spacing: 0) {
					VStack(alignment: 'leading', spacing: 0) { VuneIcon(iconClass(announcement.icon)).style(iconStyle(announcement.icon)) }.className('mk-vune-announcement__icon')
					Text(announcement.title).className('mk-vune-announcement__title')
					Text(announcement.text).className('mk-vune-announcement__body')
				}
			}).className('mk-vune-announcement')
		}
	}.className('mk-vune-announcements')
	}
}

export default Announcements
