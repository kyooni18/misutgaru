/* @misutgaru-vune-native */
import { Button, Image, Text } from 'vune-ui';
import { host } from '@@/js/config.js';
import { instance } from '@/instance.js';
import { htmlElement } from '@/vune/native.js';
import '@/vune/phase6-migration.scss';

export struct Titlebar: View {
	init() {}

	var body: some View {
		htmlElement('div', { className: 'mk-vune-titlebar' },
			htmlElement('div', { className: 'mk-vune-titlebar__title' },
				Image(instance.iconUrl || '/favicon.ico', { alt: '' })
					.className('mk-vune-titlebar__icon'),
				Text(instance.name ?? host).className('mk-vune-titlebar__instance'),
			),
			htmlElement('div', { className: 'mk-vune-titlebar__controls' },
				htmlElement('span', { className: 'mk-vune-titlebar__left' },
					Button(action: { window.history.back() }, label: {
						Text('').className('ti ti-arrow-left')
					})
						.className(['_button', 'mk-vune-titlebar__button']),
				),
				htmlElement('span', { className: 'mk-vune-titlebar__right' }),
			),
		)
	}
}

export default Titlebar
