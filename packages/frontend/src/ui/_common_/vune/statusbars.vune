/* @misutgaru-vune-native */
import { ForEach, Group, Text } from 'vune-ui';
import { instance } from '@/instance.js';
import { prefer } from '@/preferences.js';
import '@/vune/phase5-migration.scss';

function classes(x: any) { return ['mk-vune-statusbar', x.black ? 'mk-vune-statusbar--black' : '', x.size ? `mk-vune-statusbar--${x.size}` : '']; }
function statusText(x: any): string {
	if (x.type === 'rss') return x.props.url ?? '';
	if (x.type === 'federation') return instance.federation === 'none' ? '' : `Federation · ${instance.name ?? ''}`;
	if (x.type === 'userList') return x.props.userListId ? `User list · ${x.props.userListId}` : 'User list';
	return x.name ?? '';
}


export struct VuneStatusbarsView: View {
	init() {}

	var body: some View {
		Group() {
			ForEach(prefer.r.statusbars.value, key: (x: any) => x.id) { x in
				Group() {
					Text(x.name ?? '').className('mk-vune-statusbar__name')
					Text(statusText(x)).className('mk-vune-statusbar__body')
				}.className(classes(x))
			}
		}.className('mk-vune-statusbars')
	}
}

export default VuneStatusbarsView
