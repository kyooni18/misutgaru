import { Group } from 'vune-ui';
import MaterialSurface from '@/vune/MaterialSurface.vune';
import { Material } from '@/vune/material.js';

export struct MobileFooterMaterial: View {
	var body: some View {
		MaterialSurface(Material.bar, opaqueBackground: 'var(--MI_THEME-navBg)', animated: true) {
			Group() {}
		}
			.style({
				position: 'absolute',
				inset: 0,
				width: '100%',
				height: '100%',
				zIndex: 0,
				pointerEvents: 'none',
				borderRadius: 'calc(var(--MI-radius) * 2)',
				boxShadow: '0 10px 32px color-mix(in srgb, var(--MI_THEME-fg) 12%, transparent)',
			})
	}
}

export default MobileFooterMaterial
