// Mün view for the sidebar. Layout uses Mün stacks and controls; the Vue shell
// keeps state, handlers and the CSS module (passed as `c`) for theming.
// Stacks stretch their children so they lay out like the block/flex columns
// the stylesheet was written for. Images carry their own frame: an Image sizes
// itself from its frame, not from the space around it.

import { Button, Divider, Element, HStack, Icon, Image, Text, VStack, ZStack } from '@mun/core/compat'
import { BlurProfile, progressiveBlur } from '@mun/progressive-blur'
import { Component } from '@mun/vue'

const subButtonShape = [['path', {
  d: 'M47.488,7.995C47.79,10.11 47.943,12.266 47.943,14.429C47.997,26.989 47.997,84 47.997,84C47.997,84 44.018,118.246 23.997,133.5C-0.374,152.07 -0.003,192 -0.003,192L-0.003,-96C-0.003,-96 0.151,-56.216 23.997,-37.5C40.861,-24.265 46.043,-1.243 47.488,7.995Z',
  transform: 'matrix(0.333333,0,0,0.222222,0.000895785,21.3333)',
}]]

const cls = (...names) => names.filter(Boolean).join(' ')
const noop = () => {}
// Apply a modifier only when a condition holds, keeping the chain readable.
const when = (condition, node, modify) => condition ? modify(node) : node

export function navbarView(ctx) {
  const { c, components, text, me, iconOnly } = ctx
  const tip = (title, node) => Component(components.MunDirectives, { directives: ctx.tooltip(title) }, node)
  const icon = (className, transitionName) => {
    const node = Text('').className(className)
    return transitionName ? node.style({ viewTransitionName: transitionName }) : node
  }
  const stack = (...children) => VStack({ alignment: 'stretch' }, ...children.filter(child => child != null))

  // The dot and the counter badge are drawn by ::before so they keep the
  // baseline placement of the former nested inline element.
  const indicator = (value) => value
    ? Text('').className(cls(c.itemIndicator, c.itemIndicatorCounter, '_blink')).withProps({ 'data-value': value })
    : Text('').className(cls(c.itemIndicator, c.itemIndicatorDot, '_blink'))

  const realtimeButton = () => tip(text.realtimeMode,
    when(ctx.realtimeMode, Button(action: ctx.toggleRealtimeMode, label: () => [icon(ctx.realtimeMode ? 'ti ti-bolt ti-fw' : 'ti ti-bolt-off ti-fw')]), node => node.foregroundStyle('var(--MI_THEME-accent)'))
      .className(cls('_button', c.realtimeMode)))
  const widgetButton = () => tip(text.widgets,
    Button(action: ctx.onWidgetButtonClick, label: () => [icon('ti ti-apps ti-fw')]).className(cls('_button', c.widget)))

  const itemContent = (title, iconClass, transitionName, indicated, indicateValue) => [
    icon(cls(c.itemIcon, iconClass), transitionName),
    (iconOnly ? Text(title) : Text(title).fontSize('0.9em')).className(c.itemText),
    indicated ? indicator(indicateValue) : null,
  ].filter(Boolean)

  // Item color stays in the stylesheet: it changes on hover and when active.
  const itemStyle = node => when(!iconOnly, node
    .padding(iconOnly ? { top: 16, bottom: 16 } : { leading: 30 })
    .multilineTextAlignment(iconOnly ? 'center' : 'leading'), n => n.fontWeight(500))
  const link = (title, to, iconClass, transitionName, extra) => tip(title,
    itemStyle(Component(components.MkA, { class: c.item, activeClass: c.active, to, exact: extra?.exact },
      ...itemContent(title, iconClass, transitionName))))

  const menuItem = (item) => {
    if (item === '-') return Divider().className(c.divider)
    const def = ctx.navbarItemDef[item]
    if (!def || (def.show != null && def.show.value === false)) return null
    const content = itemContent(def.title, cls('ti-fw', def.icon), 'navbar-item-' + item, def.indicated, def.indicateValue)
    const node = def.to
      ? Component(components.MkA, { class: cls('_button', c.item), activeClass: c.active, to: def.to, ...(def.action ? { onClick: def.action } : {}) }, ...content)
      : Button(action: def.action ?? noop, label: () => content).className(cls('_button', c.item))
    return tip(def.title, itemStyle(node))
  }

  const subButton = (onClick, iconClassName) => ZStack(
    Icon(subButtonShape, { viewBox: '0 0 16 64', fill: 'currentColor', stroke: 'none' })
      .foregroundStyle('var(--MI_THEME-navBg)')
      .className(c.subButtonShape),
    Button(action: onClick, label: () => [Text('').className(iconClassName)]).className(cls('_button', c.subButtonClickable)),
  ).frame({ width: 20, height: 50 }).className(c.subButton)

  const iconSize = iconOnly ? 30 : 38
  const pill = ctx.pill
  const top = (iconOnly ? VStack : HStack)({ alignment: 'stretch' },
    tip(text.instanceName,
      Button(action: ctx.openInstanceMenu, label: () => [
        // A framed Image keeps its intrinsic size unless it is resizable.
        Image(ctx.instanceIconUrl, { alt: '' })
          .resizable()
          .cornerRadius(8)
          .frame({ width: iconSize, height: iconSize })
          // Round the frame too: the focus outline is drawn around it.
          .cornerRadius(8)
          // Inline like the former <img>, so the button's text-align centers it.
          .style({ display: 'inline-grid', viewTransitionName: 'navbar-serverIcon' })
          .className(c.instanceIcon),
      ]).className(cls('_button', c.instance))),
    ...(!iconOnly ? [realtimeButton(), ctx.showWidgetButton ? widgetButton() : null] : []).filter(Boolean),
  ).padding(iconOnly ? { top: 20, bottom: 20 } : { leading: 6 }).zIndex(1).className(c.top)

  const middle = stack(
    Text('').className(cls(c.activePill, pill.shown && c.activePillShown, pill.animated && c.activePillAnimated))
      .style({ transform: `translateY(${pill.top}px)`, height: `${pill.height}px`, '--pillHeight': `${pill.height}px` })
      .cornerRadius(iconOnly ? 999 : 12)
      .background('color-mix(in srgb, var(--MI_THEME-navFg) 8%, transparent)')
      .allowsHitTesting(false)
      .accessibilityHidden(true),
    link(text.timeline, '/', 'ti ti-home ti-fw', 'navbar-homeIcon', { exact: true }),
    ...ctx.menu.map(menuItem),
    Divider().className(c.divider),
    me != null && (me.isAdmin || me.isModerator) ? link(text.controlPanel, '/admin', 'ti ti-dashboard ti-fw', 'navbar-controlPanel') : null,
    itemStyle(Button(action: ctx.more, label: () => itemContent(text.more, 'ti ti-grid-dots ti-fw', 'navbar-more', ctx.otherMenuItemIndicated)).className(cls('_button', c.item))),
    link(text.settings, '/settings', 'ti ti-settings ti-fw', 'navbar-settings'),
  ).className(c.middle).elementRef(ctx.middleRef)

  const bottom = stack(
    iconOnly && ctx.showWidgetButton ? widgetButton() : null,
    iconOnly ? realtimeButton() : null,
    tip(text.note,
      when(!iconOnly, Button(action: ctx.post, label: () => [
        (iconOnly ? Text('').foregroundStyle('var(--MI_THEME-fgOnAccent)') : Text('')).className(cls('ti ti-pencil ti-fw', c.postIcon)),
        Text(text.note).className(c.postText),
      ])
        .multilineTextAlignment(iconOnly ? 'center' : 'leading')
        .className(cls('_button', c.post)).withProps({ 'data-testid': 'open-post-form' }),
        node => node.foregroundStyle('var(--MI_THEME-fgOnAccent)').fontWeight('bold'))),
    me != null
      ? tip(text.account,
        Button(action: ctx.openAccountMenu, label: () => [
          Component(components.MkAvatar, { user: me, class: c.avatar, style: 'view-transition-name: navbar-avatar;' }),
          Component(components.MkAcct, { class: cls('_nowrap', c.acct), user: me }),
        ])
          .padding(iconOnly ? { top: 20, bottom: 20 } : { top: 20, bottom: 20, leading: 30 })
          .multilineTextAlignment(iconOnly ? 'center' : 'leading')
          .className(cls('_button', c.account)))
      : null,
  ).padding({ top: 20 }).className(c.bottom)

  return [
    // Soft blur of the page along the navbar's trailing edge, fading out over 96pt.
    Element('div', {
      'aria-hidden': 'true',
      style: { position: 'absolute', top: '0px', bottom: '0px', left: '100%', width: '96px', zIndex: -1, pointerEvents: 'none' },
    }).modifier(progressiveBlur(BlurProfile.edge('leading', 96).easing('easeOut'), { radius: 12 })),
    stack(top, middle, bottom).background('var(--MI_THEME-navBg)').className(c.body),
    ctx.showSubButtons
      ? VStack({ alignment: 'leading' },
        subButton(ctx.menuEdit, cls(c.subButtonIcon, 'ti ti-settings-2')),
        ...(!ctx.asDrawer
          ? [
            Text('').background('var(--MI_THEME-navBg)').allowsHitTesting(false).className(c.subButtonGapFill),
            Text('').background('var(--MI_THEME-divider)').allowsHitTesting(false).className(c.subButtonGapFillDivider),
            subButton(ctx.toggleIconOnly, cls(iconOnly ? 'ti ti-chevron-right' : 'ti ti-chevron-left', c.subButtonIcon)),
          ]
          : []))
        // Shrink to the 20pt sub-button column instead of the stack's full width.
        .frame({ width: 20, alignment: 'leading' })
        .className(c.subButtons)
      : null,
  ]
}
