import { VStack, Text, type ViewGraphValue } from 'vune-ui'; import MkButton from '@/components/vune/MkButton.vune'; import { i18n } from '@/i18n.js';
type Props={showDeckNav?:boolean;onGoToDeck?:()=>void}; function deck(props:Props){props.onGoToDeck?.()}
export struct VuneZenView: View { let props:Props; let router:ViewGraphValue; let common:ViewGraphValue; init(_ props:Props,@ViewBuilder router:()=>ViewGraphValue,@ViewBuilder common:()=>ViewGraphValue){self.props=props;self.router=router();self.common=common()} var body:some View { VStack(alignment: 'stretch', spacing: 0){VStack(alignment: 'stretch', spacing: 0){if(props.showDeckNav){MkButton(primary:true,className:'mk-vune-zen__deck-nav',onClick:{deck(props)}){Text(i18n.ts.goToDeck)}};VStack(alignment: 'stretch', spacing: 0){router}.className('mk-vune-zen__route')}.className('mk-vune-zen__contents');common} } }
export default VuneZenView
