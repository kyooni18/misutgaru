/* @misutgaru-vune-native */
import { VStack, Text } from 'vune-ui';
import { ensureSignin } from '@/i.js';
import { i18n } from '@/i18n.js';
import type { Column } from '@/deck.js';
import MkInfo from '@/components/vune/MkInfo.vune';
import MkChatHistories from '@/components/vune/MkChatHistories.vune';
import VuneIcon from '@/vune/Icon.vune';

type Props = { column: Column; isStacked: boolean };
function chatAvailability() { return ensureSignin().policies.chatAvailability; }
export struct VuneChatColumnView: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 0) {
				VuneIcon('ti ti-messages')
				Text(props.column.name || i18n.ts._deck._columns.chat)
			}.className('mk-vune-deck-column__header')
			VStack(alignment: 'stretch', spacing: 0) {
				if (chatAvailability() === 'readonly') { MkInfo() { Text(i18n.ts._chat.chatIsReadOnlyForThisAccountOrServer) } }
				if (chatAvailability() === 'unavailable') { MkInfo(warn: true) { Text(i18n.ts._chat.chatNotAvailableForThisAccountOrServer) } }
				if (chatAvailability() !== 'unavailable') { MkChatHistories() }
			}.className('_gaps mk-vune-deck-body')
		}.className(['mk-vune-deck-column', props.isStacked ? 'mk-vune-deck-column--stacked' : null])
	}
}
export default VuneChatColumnView
