import { VStack, type ViewGraphValue } from 'vune-ui';
export struct DeckColumn: View {
	let column: any
	let header: ViewGraphValue
	let content: ViewGraphValue
	init(_ column: any, header: ViewGraphValue = null, @ViewBuilder content: () => ViewGraphValue) { self.column = column; self.header = header; self.content = content() }
	var body: some View { VStack(alignment: 'stretch', spacing: 0) { VStack(alignment: 'stretch', spacing: 0) { header }.className('mk-vune-deck-column__header'); VStack(alignment: 'stretch', spacing: 0) { content }.className('mk-vune-deck-column__body') }.className('mk-vune-deck-column') }
}
export default DeckColumn
