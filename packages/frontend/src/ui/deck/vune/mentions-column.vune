import { VStack, Text } from 'vune-ui';
import type { Column } from '@/deck.js';
import type { IPaginator } from '@/utility/paginator.js';
import MkNotesTimeline from '@/components/vune/MkNotesTimeline.vune';
import VuneIcon from '@/vune/Icon.vune';
import { i18n } from '@/i18n.js';

type Props = { column: Column; isStacked: boolean; paginator: IPaginator };
export struct VuneMentionsColumnView: View {
	let props: Props
	init(_ props: Props) { self.props = props }
	var body: some View {
		VStack(alignment: 'stretch', spacing: 0) {
			VStack(alignment: 'stretch', spacing: 0) {
				VuneIcon('ti ti-at')
				Text(props.column.name || i18n.ts._deck._columns.mentions)
			}.className('mk-vune-deck-column__header')
			MkNotesTimeline(props.paginator)
		}.className(['mk-vune-deck-column', props.isStacked ? 'mk-vune-deck-column--stacked' : null])
	}
}
export default VuneMentionsColumnView
