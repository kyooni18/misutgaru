import { VStack, ForEach, Text } from 'vune-ui'; import type { Column } from '@/deck.js'; import MkButton from '@/components/vune/MkButton.vune'; import VuneIcon from '@/vune/Icon.vune'; import { i18n } from '@/i18n.js';
type Widget={id:string;name?:string;data?:any}; type Props={column:Column;isStacked:boolean;edit?:boolean;menu:unknown[];onAddWidget?:(w:Widget)=>void;onRemoveWidget?:(w:Widget)=>void;onUpdateWidget?:(w:any)=>void;onUpdateWidgets?:(w:Widget[])=>void;onExitEdit?:()=>void}; function exit(props:Props){props.onExitEdit?.()}
export struct VuneWidgetsColumnView: View { let props:Props; init(_ props:Props){self.props=props} var body:some View { VStack(alignment: 'stretch', spacing: 0){VStack(alignment: 'stretch', spacing: 0){VuneIcon('ti ti-apps');Text(props.column.name||i18n.ts._deck._columns[props.column.type])}.className('mk-vune-deck-column__header');VStack(alignment: 'stretch', spacing: 0){if((props.column.widgets??[]).length===0&&!props.edit){Text(i18n.ts._deck.widgetsIntroduction).className('mk-vune-deck-widgets__intro')};ForEach((props.column.widgets??[]) as Widget[],key:w=>w.id){w in VStack(alignment: 'stretch', spacing: 0){Text(w.name??w.id);if(props.edit){MkButton(danger:true,onClick:{props.onRemoveWidget?.(w)}){Text(i18n.ts.remove)}}}.className('_panel')};if(props.edit){MkButton(primary:true,onClick:{exit(props)}){Text(i18n.ts.done)}}}.className('mk-vune-deck-widgets')}.className(['mk-vune-deck-column',props.isStacked?'mk-vune-deck-column--stacked':null]) } }
export default VuneWidgetsColumnView
