import { Element } from "@mun/core"
import { Note } from "./Note.mun"
import { observeVisible } from "../services/observe-visible.mjs"
import { withSeparators } from "../services/timeline-date-separate.mjs"
import "./note.css"

// Counterpart of Vue's MkNotesTimeline + Paginator: first page of 15 (allowPartial), then pages of 30 older than the oldest id.
export struct NotesTimeline: View {
  let endpoint
  let params
  let api
  let labels
  let formatTime
  let services
  let firstLimit = 15
  @State var items = []
  @State var loading = true
  @State var failed = false
  @State var canFetchOlder = false
  @State var fetchingOlder = false
  @State var reloadToken = 0

  func init(signal) async {
    loading = true
    failed = false
    items = []
    try {
      let res = await api.post(endpoint, { ...params, limit: firstLimit, allowPartial: true }, undefined, signal)
      if (signal.aborted) { return }
      items = res
      canFetchOlder = res.length !== 0
    } catch (error) {
      if (signal.aborted) { return }
      failed = true
    }
    loading = false
  }

  func fetchOlder() async {
    if (!canFetchOlder || fetchingOlder || loading || items.length === 0) { return }
    fetchingOlder = true
    try {
      let res = await api.post(endpoint, { ...params, limit: 30, untilId: items[items.length - 1].id })
      items = items.concat(res)
      canFetchOlder = res.length !== 0
    } catch (error) { }
    fetchingOlder = false
  }

  var body: some View {
    Element("div", { className: "notes-timeline" }) {
      if (failed) {
        Element("div", { className: "notes-timeline-error", role: "alert" }) {
          Text(labels.error)
          Element("button", { className: "notes-timeline-retry", onClick: () => { reloadToken += 1 } }) { Text(labels.retry) }
        }
      } else if (!loading && items.length === 0) {
        Element("div", { className: "notes-timeline-empty" }) { Text(labels.noNotes) }
      } else {
        Element("div", { className: "notes-timeline-list" }) {
          ForEach(withSeparators(items), key: (row) => row.id) { row in
            Element("div", { className: "notes-timeline-row" }) {
              if (row.separator != null) {
                Element("div", { className: "notes-timeline-date" }) {
                  Element("span", {}) { Text("\u2191 " + row.separator.prevText) }
                  Element("span", { className: "notes-timeline-date-divider" }) {}
                  Element("span", {}) { Text(row.separator.nextText + " \u2193") }
                }
              }
              Element("div", { className: "notes-timeline-item" }) { Note(note: row.note, labels: labels, formatTime: formatTime, services: services) }
            }
          }
        }
        if (canFetchOlder) {
          Element("div", { className: "notes-timeline-sentinel", "aria-hidden": "true", ref: observeVisible(() => fetchOlder()) }) {}
          Element("button", { className: "notes-timeline-more", disabled: fetchingOlder, onClick: () => fetchOlder() }) { Text(labels.more) }
        }
      }
    }
    .task(id: reloadToken) { signal in await init(signal) }
  }
}
