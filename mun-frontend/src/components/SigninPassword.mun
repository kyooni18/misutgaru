import { Element } from "@mun/core"
import { CaptchaWidget } from "./CaptchaWidget.mun"
import { TestCaptcha } from "./TestCaptcha.mun"
import { buttonRipple, newRippleKey } from "../services/button-ripple.mjs"
import { mountTotpInput, unmountTotpInput } from "../services/signin-totp-input.mjs"
import "icons-subsetter/built/tabler-icons-frontend.css"
import "./signin-passkey.css"
import "./signin-totp.css"
import "./signin-password.css"

export struct SigninPassword: View {
  let user
  let needCaptcha
  let services
  @State var password = ""
  @State var testcaptchaResponse = null
  @State var hCaptchaResponse = null
  @State var reCaptchaResponse = null
  @State var turnstileResponse = null
  @State var focused = false
  @State var inputKey = ""
  var body: some View {
    Element("div", { class: "signin-passkey", "data-testid": "signin-page-password" }) {
      Element("div", { class: "signin-passkey-root" }) {
        Element("div", { class: "signin-password-avatar", style: { backgroundImage: user ? "url('" + user.avatarUrl + "')" : null } }) {}
        Element("div", { class: "signin-password-welcome" }) { Text(services.welcome(user)) }
        Element("form", { class: "signin-totp-form", onSubmit: event => { event.preventDefault(); services.submit({ password: password, captcha: { hCaptchaResponse: hCaptchaResponse, mCaptchaResponse: null, reCaptchaResponse: reCaptchaResponse, turnstileResponse: turnstileResponse, testcaptchaResponse: testcaptchaResponse } }) } }) {
          Element("input", { type: "hidden", name: "username", autocomplete: "username", value: user.username }) {}
          Element("div", { class: "signin-totp-field", "data-testid": "signin-password" }) {
            Element("div", { class: "signin-totp-label" }) {}
            Element("div", { class: "signin-totp-input-wrap" + (focused ? " focused" : "") }) {
              Element("div", { class: "signin-totp-prefix" }) { Element("i", { class: "ti ti-lock" }) {} }
              Element("input", { "data-totp-input": inputKey, class: "signin-totp-input", type: "password", value: password, placeholder: services.labels.password, autocomplete: "current-password webauthn", required: true, onInput: event => { password = event.target.value }, onFocus: () => { focused = true }, onBlur: () => { focused = false } }) {}
            }
            Element("div", { class: "signin-totp-caption" }) { Element("button", { type: "button", class: "signin-totp-toggle", onClick: () => services.resetPassword() }) { Text(services.labels.forgotPassword) } }
          }
          if (needCaptcha && services.instance.enableHcaptcha) { CaptchaWidget(widget: services.widgets.hcaptcha) }
          if (needCaptcha && services.instance.enableRecaptcha) { CaptchaWidget(widget: services.widgets.recaptcha) }
          if (needCaptcha && services.instance.enableTurnstile) { CaptchaWidget(widget: services.widgets.turnstile) }
          if (needCaptcha && services.instance.enableTestcaptcha) { TestCaptcha(services: services.testCaptcha) }
          Element("button", { type: "submit", class: "signin-passkey-button primary", "data-testid": "signin-page-password-continue", "data-ripple-key": inputKey + "-continue", disabled: needCaptcha && ((services.instance.enableHcaptcha && !hCaptchaResponse) || services.instance.enableMcaptcha || (services.instance.enableRecaptcha && !reCaptchaResponse) || (services.instance.enableTurnstile && !turnstileResponse) || (services.instance.enableTestcaptcha && !testcaptchaResponse)), onMouseDown: event => buttonRipple(event) }) {
            Element("div", { class: "signin-passkey-ripples" }) {}
            Element("span", { class: "signin-passkey-button-content" }) { Text(services.labels.continue + " "); Element("i", { class: "ti ti-arrow-right" }) {} }
          }
        }
      }
    }
    .onAppear { inputKey = newRippleKey(); services.attach((field, value) => { if (field === "testcaptchaResponse") { testcaptchaResponse = value }; if (field === "hCaptchaResponse") { hCaptchaResponse = value }; if (field === "reCaptchaResponse") { reCaptchaResponse = value }; if (field === "turnstileResponse") { turnstileResponse = value } }); mountTotpInput(inputKey) }
    .onDisappear { services.detach(); unmountTotpInput(inputKey); password = ""; testcaptchaResponse = null }
  }
}
