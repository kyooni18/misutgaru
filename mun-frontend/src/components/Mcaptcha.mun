import { Element } from "@mun/core"
export struct Mcaptcha: View {
  let widget
  var body: some View {
    Element("div", {}) {
      if (widget.iframeUrl) {
        Element("iframe", { src: widget.iframeUrl, style: "border: none; max-width: 320px; width: 100%; height: 100%; max-height: 80px;" }) {}
      }
    }
    .onAppear { widget.mount() }
    .onDisappear { widget.dispose() }
  }
}
