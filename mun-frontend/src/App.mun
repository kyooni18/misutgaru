import { Element } from "@mun/core"
import { api } from "./services/api.mjs"
import VisitorStats from "./components/VisitorStats.mun"
struct App: View {
  @State var name = "Misutgaru"
  @State var description = ""
  @State var status = "Loading server information…"
  @State var request = 0
  @State var showStats = false
  func load(signal) async {
    let ticket = request
    status = "Loading server information…"
    try {
      let meta = await api.post("meta", { detail: true }, undefined, signal)
      if (signal.aborted || ticket !== request) { return }
      name = meta.name || "Misutgaru"
      description = meta.description || ""
      showStats = meta.clientOptions?.showActivitiesForVisitor !== false
      status = ""
    } catch (error) {
      if (signal.aborted || ticket !== request) { return }
      status = "Could not load server information."
    }
  }
  var body: some View {
    Element("main", { class: "shell" }) {
      Element("nav", { "aria-label": "Main navigation" }) {
        Element("a", { href: "/" }) { Text("Home") }
        Element("a", { href: "/about" }) { Text("About") }
      }
      Element("section", { class: "panel" }) {
        if (window.location.pathname === "/about") {
          Element("h1", {}) { Text("About \(name)") }
        } else {
          Element("h1", {}) { Text(name) }
        }
        Element("p", {}) { Text(description) }
        Element("p", { role: "status", "aria-live": "polite" }) { Text(status) }
        Button("Refresh server information") { request += 1 }
      }
      if (window.location.pathname === "/" && showStats) { VisitorStats }
    }
    .task(id: request) { signal in await load(signal) }
  }
}
export default App()
